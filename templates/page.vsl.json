    "lt_vsl_faq": {
      "type": "lt-vsl-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What does Beauty Tape actually do?",
            "answer": "<p>Beauty Tape is designed to gently encourage you to keep your lips closed while sleeping, supporting nasal breathing instead of habitual mouth breathing.</p><p>It also contains beauty-focused ingredients including Hyaluronic Acid, Vitamin E and Collagen to help care for your lips overnight.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Can it help with snoring?",
            "answer": "<p>Beauty Tape encourages nasal breathing, which may help support quieter nighttime breathing for people whose snoring is associated with mouth breathing.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Does it help with dry mouth?",
            "answer": "<p>By gently encouraging your lips to stay closed, it may help reduce some of the moisture loss associated with sleeping with your mouth open.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What makes Beauty Tape different?",
            "answer": "<p>Beauty Tape pairs a simple nightly mouth-tape routine with beauty-focused ingredients — Hyaluronic Acid, Vitamin E and Collagen — to help care for your lips overnight.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Will my lips feel sticky?",
            "answer": "<p>Beauty Tape is designed to feel comfortable overnight and to peel off easily in the morning.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "Who shouldn’t use mouth tape?",
            "answer": "<p>If you have difficulty breathing through your nose, are congested, or have a medical condition that affects your breathing or sleep, talk to your doctor before using mouth tape. Remove it right away if you feel uncomfortable.</p>"
          }
        }
      },
