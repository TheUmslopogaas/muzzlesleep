adding_top_mobile":45,"padding_bottom_mobile":60}},"landing_banner_2_yCg9Ny":{"type":"landing-banner-2","settings":{"banner_image":"shopify:\/\/shop_images\/f01780360dc5536ca71148228fa5dde9.jpg","title":"Rooted in Science,\nMade for Better Sleep.","background":"#FFFFFF00","max_with":1920,"padding_bottom":0,"padding_bottom_mobile":0}},"main":{"type":"main-page","settings":{"padding_top":28,"padding_bottom":28}},"faq_VXqVwD":{"type":"faq","blocks":{"cloud_XcDdVy":{"type":"cloud","settings":{"image":"shopify:\/\/shop_images\/37d8af1c52cd6876369fb9fc44e077e5.png","width_desktop":210,"width_mobile":150}},"block_zpEHtk":{"type":"block","settings":{"q":"What are Muzzle Sleeping Strips?","a":"Muzzle Sleeping Strips are a gentle, doctor-recommended solution designed to reduce snoring by promoting nasal breathing. They are made with our patented Breathe-Safe™ Technology and have been rigorously tested for harmful chemicals like BPA, Phthalates, Heavy Metals and PFAS. These strips are available in various designs for adults and children to help improve sleep quality."}},"block_neYj3J":{"type":"block","settings":{"q":"How do Muzzle Strips work?","a":"The strips work by encouraging nasal breathing, which helps to reduce snoring caused by mouth breathing."}},"block_e9pybc":{"type":"block","settings":{"q":"Are the strips safe to use?","a":"Yes! Muzzle Sleeping Strips are made with hypoallergenic materials that are safe for sensitive skin. Our strips are also tested for harmful chemicals such as BPA, Phthalates, Heavy metals, and PFAS, making them a safe choice for both adults and children."}},"block_yPHxDn":{"type":"block","settings":{"q":"How do I apply the strips?","a":"Applying the strips is simple. Just peel off the backing and apply to skin. Gently press it in place to ensure it adheres securely. It’s that easy! The strips will stay in place all night without discomfort."}},"block_TxTe6g":{"type":"block","settings":{"q":"Can Muzzle Sleeping Strips stop snoring completely?","a":"While Muzzle Sleeping Strips can significantly reduce snoring by promoting nasal breathing, the effectiveness may vary from person to person. For many, the strips provide a noticeable improvement, leading to quieter, more restful sleep. We recommend using the strips consistently for the best results."}},"block_gf7RCd":{"type":"block","settings":{"q":"Can I use the strips if I have allergies or sensitive skin?","a":"Our regular Muzzle strips are suitable for most people and have been dermatologically tested with excellent results. However, if you have particularly sensitive or reactive skin, we recommend choosing our Extra Sensitive tapes, which are specifically designed to provide a gentler option for sensitive skin. As with any adhesive product, individual skin reactions can vary. If you have a known allergy to adhesives or are unsure how your skin will respond, we recommend testing the strip on a small area of skin before use."}}},"block_order":["cloud_XcDdVy","block_zpEHtk","block_neYj3J","block_e9pybc","block_yPHxDn","block_TxTe6g","block_gf7RCd"],"settings":{"background":"#FFFFFF","max_with":1100,"padding_top":100,"padding_bottom":100,"padding_top_mobile":60,"padding_bottom_mobile":60,"muzzle_icon":"shopify:\/\/shop_images\/mask_icon_fb21a91c-b22a-4049-8d98-4ceab5509f3d.png","heading":"<span>Got Questions?<\/span> We’ve got answers.","text_above_link":"Still no answer?","link_txt":"Send us a message","link_target":"mailto:info@muzzlesleep.com"}},"tw_testimonial_4_jg9mRH":{"type":"tw-testimonial-4","blocks":{"slide_kzJkFU":{"type":"slide","settings":{"stars_count":5,"text":"“I’ve tried mouth taping before, but other strips either fell off during the night or sealed too tightly, making it hard to breathe. With Muzzle, my wife and I sleep comfortably through the night and breathe easily.”","author":"Jason O.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_hEjKTU":{"type":"slide","settings":{"stars_count":5,"text":"“I'm absolutely loving my mouth taping journey - it's been a total game-changer for my sleep quality and morning energy levels! As a former mouth breather, I've ditched the dry throat and snoring, and now wake up feeling refreshed and ready to conquer the day!”","author":"Jessica P.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_C3rfXq":{"type":"slide","settings":{"stars_count":5,"text":"“I’ve struggled with snoring for years and these muzzle strips have been a game-changer.”","author":"Michael L.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_XMkrz8":{"type":"slide","settings":{"stars_count":5,"text":"“Muzzle has made a noticeable difference on how rested I feel, and it is so comfortable and gentle on my skin.”","author":"Brinley M.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_Mcen9R":{"type":"slide","settings":{"stars_count":5,"text":"“Great product! Very easy to put on and comfortable to sleep with. I felt very well rested after wearing Muzzle through the night.”","author":"Paige L.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_dsd3dds":{"type":"slide","settings":{"stars_count":5,"text":"“My kids dentist suggested mouth tape. This one is great because it’s comfortable, easy to use, and kid-friendly.”","author":"Kim R.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_khh2hfxc":{"type":"slide","settings":{"stars_count":5,"text":"“Muzzle Kids Mouth Tape has been a game-changer for my kids’ sleep! I love that it’s safe, third-party tested, and designed with a breathable opening—giving me peace of mind while improving their breathing and rest.”","author":"Caitlin W.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_q2csw5tg":{"type":"slide","settings":{"stars_count":5,"text":"“Super easy to use. Kids love it and have been asking about it every night. Easy and painless to remove in the morning”","author":"Mishel E.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_lduen2dx":{"type":"slide","settings":{"stars_count":5,"text":"“As a parent giving my child the opportunity for a well rested night sleep is a must. It’s easy enough for my 9 year old to do himself. The medium strength adhesive is strong enough to stay on without irritating his skin. All around great product.”","author":"Daniella S.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}},"slide_fofmne2d":{"type":"slide","settings":{"stars_count":5,"text":"“Wow, we’ve seen a huge improvement in my daughter’s mood and behavior. It truly has been probably an 85-90% improvement in her behavior since we started using Muzzle every night. We are super happy knowing she is getting a more restful nights sleep by eliminating the mouth breathing.”","author":"Kelley K.","city":"","verify_badge":"shopify:\/\/shop_images\/badge-check-solid_2_1.svg","verify_text":"Verified purchase"}}},"block_order":["slide_kzJkFU","slide_hEjKTU","slide_C3rfXq","slide_XMkrz8","slide_Mcen9R","slide_dsd3dds","slide_khh2hfxc","slide_q2csw5tg","slide_lduen2dx","slide_fofmne2d"],"settings":{"stars_icon":"shopify:\/\/shop_images\/review_star.svg","stars_count":5,"stars_size":18,"stars_align":"start","stars_align_card":"center","text":"<p><strong>Trusted by 11,000+ Customers<\/strong><\/p>","text_custom":false,"text_font":"josefin_sans_n4","text_size":14,"text_size_mobile":12,"text_height":130,"text_align":"left","text_mt":12,"heading":"<p>Peaceful sleepers <strong>make happy reviewers.<\/strong><\/p>","heading_cus