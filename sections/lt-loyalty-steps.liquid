{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round
-%}

<div class="lt-loyalty-steps">
  <div class="page-width">
    <div class="lt-loyalty-steps__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lt-loyalty-steps__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lt-loyalty-steps__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lt-loyalty-steps__grid" style="--lt-cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          <div class="lt-loyalty-steps__card" {{ block.shopify_attributes }}>
            <div class="lt-loyalty-steps__badge">
              {%- if block.settings.number != blank -%}
                {{ block.settings.number }}
              {%- else -%}
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="lt-loyalty-steps__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="lt-loyalty-steps__card-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__head {
    text-align: center;
    margin-bottom: 56px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__eyebrow {
    display: inline-block;
    padding: 7px 16px;
    margin-bottom: 20px;
    border-radius: 100px;
    background-color: {{ section.settings.eyebrow_bg_color }};
    color: {{ section.settings.eyebrow_text_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__heading {
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols), minmax(0, 1fr));
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 48px 32px;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 20px;
    background-color: {{ section.settings.card_bg_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 24px;
    border-radius: 14px;
    background-color: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__card-title {
    margin: 0 0 14px;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__card-text {
    font-size: 16px;
    line-height: 1.5;
    color: {{ section.settings.card_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-steps__card-text p {
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-steps__head {
      margin-bottom: 32px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-steps__heading {
      font-size: 30px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-steps__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-steps__card {
      padding: 32px 24px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-steps__heading {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Loyalty Steps",
  "tag": "section",
  "class": "lt-loyalty-steps-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How It Works"
    },
    {
      "type": "color",
      "id": "eyebrow_bg_color",
      "label": "Eyebrow background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text",
      "default": "#5B4FCF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Earn. Redeem. Level Up."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B4D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#EAEAF0"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Number badge"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number override",
          "info": "Leave blank to auto-number (01, 02, 03…)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step of the program.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "LT Loyalty Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Earn Points",
            "text": "<p>Stack up points every time you place an order, create an account, leave a review, or engage with the Muzzle Sleep community.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Redeem Rewards",
            "text": "<p>Turn your points into savings, exclusive perks, and special gifts you can use on future Muzzle Sleep orders.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Level Up",
            "text": "<p>The more you shop and engage, the more perks you unlock. Reach new tiers and enjoy bigger rewards designed for loyal sleepers.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
