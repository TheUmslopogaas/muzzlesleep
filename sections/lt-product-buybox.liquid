{%- liquid
  assign s = section.settings

  assign pt = s.padding_top
  assign pb = s.padding_bottom
  assign mt = s.margin_top
  assign mb = s.margin_bottom
  assign pt_mob = pt | times: 0.6 | round
  assign pb_mob = pb | times: 0.6 | round
  assign mt_mob = mt | times: 0.6 | round
  assign mb_mob = mb | times: 0.6 | round

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign perk_blocks = section.blocks | where: 'type', 'perk'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign dropdown_blocks = section.blocks | where: 'type', 'dropdown'

  assign selected_id = ''
  assign selected_available = false
  assign product_count = 0
  for b in product_blocks
    if b.settings.product == blank
      continue
    endif
    assign product_count = product_count | plus: 1
    if selected_id == ''
      assign selected_id = b.id
      assign selected_available = b.settings.product.available
    endif
  endfor

  if template.name == 'product'
    for b in product_blocks
      if b.settings.product != blank and b.settings.product.id == product.id
        assign selected_id = b.id
        assign selected_available = b.settings.product.available
      endif
    endfor
  endif

  assign selector_cols = product_count
  if request.design_mode
    assign selector_cols = product_blocks.size
  endif

  assign perks_attrs_done = false
-%}

{%- capture star_svg -%}
