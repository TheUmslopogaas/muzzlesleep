{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round

  assign bg_desktop = section.settings.background_image
  assign bg_mobile = section.settings.background_image_mobile
  if bg_mobile == blank
    assign bg_mobile = bg_desktop
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
    {%- if bg_desktop != blank %}
    background-image: url('{{ bg_desktop | image_url: width: 2400 }}');
    {%- else %}
    background-image: linear-gradient(180deg, #f8a6bd 0%, #f08aa2 55%, #e0647c 100%);
    {%- endif %}
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  #shopify-section-{{ section.id }} .lt-benefits,
  #shopify-section-{{ section.id }} .lt-benefits *,
  #shopify-section-{{ section.id }} .lt-benefits *::before,
  #shopify-section-{{ section.id }} .lt-benefits *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .lt-benefits {
    font-family: Inter, var(--font-body-family), sans-serif;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .lt-benefits__inner.page-width {
    max-width: 1440px;
    padding: 0 106px;
  }

  /* Header */
  #shopify-section-{{ section.id }} .lt-benefits__header {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .lt-benefits__eyebrow {
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .lt-benefits__heading {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 48px;
    font-weight: 600;
    line-height: 62px;
    letter-spacing: -1px;
  }

  /* Grid */
  #shopify-section-{{ section.id }} .lt-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 20px;
    max-width: 1228px;
    margin: 64px auto 0;
    padding: 0;
    list-style: none;
  }

  /* Glass card */
  #shopify-section-{{ section.id }} .lt-benefits__card {
    display: flex;
    flex-direction: column;
    min-height: 358px;
    margin: 0;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.1) 100%);
    -webkit-backdrop-filter: blur(14px) saturate(115%);
    backdrop-filter: blur(14px) saturate(115%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .lt-benefits__icon {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
  }

  #shopify-section-{{ section.id }} .lt-benefits__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #shopify-section-{{ section.id }} .lt-benefits__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .lt-benefits__content {
    margin-top: auto;
    padding-top: 24px;
  }

  #shopify-section-{{ section.id }} .lt-benefits__title {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 26px;
    font-weight: 600;
    line-height: 33px;
    letter-spacing: -0.3px;
  }

  #shopify-section-{{ section.id }} .lt-benefits__text {
    margin: 8px 0 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 25px;
    opacity: 0.94;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .lt-benefits__inner.page-width {
      padding: 0 40px;
    }
  }

  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .lt-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .lt-benefits__card {
      min-height: 320px;
      padding: 28px;
      border-radius: 28px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__heading {
      font-size: 40px;
      line-height: 52px;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
      {%- if bg_mobile != blank %}
      background-image: url('{{ bg_mobile | image_url: width: 1000 }}');
      {%- endif %}
    }

    #shopify-section-{{ section.id }} .lt-benefits__inner.page-width {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__eyebrow {
      margin-bottom: 14px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__heading {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -0.6px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      margin-top: 40px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__card {
      min-height: 260px;
      padding: 24px;
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__icon {
      width: 44px;
      height: 44px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__title {
      font-size: 22px;
      line-height: 28px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__text {
      font-size: 14px;
      line-height: 22px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-benefits__inner.page-width {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__heading {
      font-size: 28px;
      line-height: 36px;
    }

    #shopify-section-{{ section.id }} .lt-benefits__card {
      padding: 20px;
    }
  }
</style>

<div class="lt-benefits">
  <div class="page-width lt-benefits__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="lt-benefits__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lt-benefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lt-benefits__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="lt-benefits__grid">
        {%- for block in section.blocks -%}
          <li class="lt-benefits__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_image != blank or block.settings.icon != 'none' -%}
              <div class="lt-benefits__icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 96 }}"
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'waves' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M3 7.5c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0"/>
                        <path d="M3 12c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0"/>
                        <path d="M3 16.5c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0"/>
                      </svg>
                    {%- when 'lips' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 7.5c-2.8 0-4.5 2-4.5 4.5s1.7 4.5 4.5 4.5c2 0 3.2-1.2 5-1.2s3 1.2 5 1.2c2.8 0 4.5-2 4.5-4.5S19.8 7.5 17 7.5c-2 0-3.2 1.2-5 1.2S9 7.5 7 7.5z"/>
                        <circle cx="12" cy="12.4" r="0.6" fill="currentColor"/>
                      </svg>
                    {%- when 'moon' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M20 13.8A8 8 0 1 1 10.2 4a6.4 6.4 0 0 0 9.8 9.8z"/>
                        <path d="M17.5 2.5v4M15.5 4.5h4"/>
                      </svg>
                    {%- when 'battery' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <rect x="1.5" y="6.5" width="19" height="11" rx="3"/>
                        <path d="M22.5 10.5v3"/>
                        <path d="M5.5 10v4M8.5 10v4M11.5 10v4M14.5 10v4"/>
                      </svg>
                    {%- when 'drop' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 2.8c3.6 4.2 6.2 7.3 6.2 10.8a6.2 6.2 0 0 1-12.4 0c0-3.5 2.6-6.6 6.2-10.8z"/>
                        <path d="M9.3 15.6a3 3 0 0 0 2.7 1.8"/>
                      </svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M20.2 12a8.2 8.2 0 1 1-2.4-5.8"/>
                        <path d="M20.5 3.5v4h-4"/>
                        <path d="M12 8v4.2l2.6 1.6"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="lt-benefits__content">
              {%- if block.settings.title != blank -%}
                <h3 class="lt-benefits__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="lt-benefits__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LT Benefits",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop background image",
      "info": "Single image containing the pink gradient and clouds. Recommended: 2880 x 2250 px."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image",
      "info": "Used at 767px and below. Falls back to the desktop image if empty."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Core Benefits"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "One Tiny Strip.<br>A Better Nighttime Routine."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "waves", "label": "Waves" },
            { "value": "lips", "label": "Tape" },
            { "value": "moon", "label": "Moon" },
            { "value": "battery", "label": "Battery" },
            { "value": "drop", "label": "Drop" },
            { "value": "clock", "label": "Clock" },
            { "value": "none", "label": "None" }
          ],
          "default": "waves"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above. Use a white icon, 96 x 96 px."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Benefit heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Describe this benefit in a sentence or two."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Benefits",
      "settings": {
        "text_color": "#ffffff",
        "padding_top": 80,
        "padding_bottom": 80
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "waves",
            "title": "Encourages Nasal Breathing",
            "text": "Gently helps keep your lips closed so nasal breathing can become the focus while you sleep."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "lips",
            "title": "Helps Reduce Dry Mouth",
            "text": "Keeping your mouth closed may help prevent some of the moisture loss associated with sleeping with your mouth open."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "moon",
            "title": "Helps With Nighttime Snoring",
            "text": "For people whose snoring is associated with mouth breathing, encouraging nasal breathing may help support quieter sleep."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "battery",
            "title": "Wake Up Feeling More Refreshed",
            "text": "Create a more consistent nighttime breathing routine without complicated equipment or devices."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "drop",
            "title": "Helps Keep Lips Feeling Hydrated",
            "text": "Hyaluronic Acid, Vitamin E and Collagen add a skincare-inspired benefit while you sleep."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Fits Into Your Routine In Seconds",
            "text": "Apply it right before bed and remove it when you wake up."
          }
        }
      ]
    }
  ]
}
{% endschema %}
