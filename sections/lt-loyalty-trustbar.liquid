{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round
-%}

<div class="lt-loyalty-trustbar">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <ul class="lt-loyalty-trustbar__list" role="list">
        {%- for block in section.blocks -%}
          <li class="lt-loyalty-trustbar__item" {{ block.shopify_attributes }}>
            {%- if block.type == 'rating' -%}
              {%- if block.settings.stars > 0 -%}
                <span class="lt-loyalty-trustbar__stars" aria-hidden="true">
                  {%- for i in (1..block.settings.stars) -%}
                    <svg class="lt-loyalty-trustbar__star" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 1.5l2.472 5.008 5.528.803-4 3.898.944 5.506L10 14.115l-4.944 2.6.944-5.506-4-3.898 5.528-.803L10 1.5z"/>
                    </svg>
                  {%- endfor -%}
                </span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="lt-loyalty-trustbar__text">{{ block.settings.text }}</span>
              {%- endif -%}
            {%- else -%}
              {%- if block.settings.text != blank -%}
                <span class="lt-loyalty-trustbar__text">{{ block.settings.text }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 {{ section.settings.item_spacing }}px;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__item + .lt-loyalty-trustbar__item {
    border-left: 1px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: {{ section.settings.star_color }};
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__star {
    display: block;
  }

  #shopify-section-{{ section.id }} .lt-loyalty-trustbar__text {
    white-space: nowrap;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-trustbar__list {
      flex-direction: column;
      gap: 14px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-trustbar__item {
      padding: 0;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-trustbar__item + .lt-loyalty-trustbar__item {
      border-left: 0;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-trustbar__item {
      font-size: {{ section.settings.font_size | times: 0.9 | round }}px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Loyalty Trust Bar",
  "tag": "section",
  "class": "lt-loyalty-trustbar-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FAC512"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "rgba(255,255,255,0.25)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Rating",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Number of stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "4,550+ Reviews"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Approved"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LT Loyalty Trust Bar",
      "blocks": [
        { "type": "rating", "settings": { "stars": 5, "text": "4,550+ Reviews" } },
        { "type": "text", "settings": { "text": "Dermatologically Tested" } },
        { "type": "text", "settings": { "text": "HSA/FSA Approved" } },
        { "type": "text", "settings": { "text": "Doctor Approved" } },
        { "type": "text", "settings": { "text": "Designed in the USA" } }
      ]
    }
  ]
}
{% endschema %}
