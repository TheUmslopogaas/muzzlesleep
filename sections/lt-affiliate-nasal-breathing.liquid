{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign pt_mob = pt | times: 0.6 | round
  assign pb_mob = pb | times: 0.6 | round
  assign mt_mob = mt | times: 0.6 | round
  assign mb_mob = mb | times: 0.6 | round
-%}

<div class="lt-nasal">
  <div class="page-width lt-nasal__grid">

    <div class="lt-nasal__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="lt-nasal__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <div class="lt-nasal__body">{{ section.settings.body_text }}</div>
      {%- endif -%}
    </div>

    <div class="lt-nasal__media">
      {%- if section.settings.image_top != blank -%}
        <div class="lt-nasal__media-item">
          <img
            class="lt-nasal__img"
            src="{{ section.settings.image_top | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.image_top | image_url: width: 400 }} 400w,
              {{ section.settings.image_top | image_url: width: 700 }} 700w,
              {{ section.settings.image_top | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 767px) 100vw, 500px"
            width="{{ section.settings.image_top.width }}"
            height="{{ section.settings.image_top.height }}"
            alt="{{ section.settings.image_top.alt | default: 'Mouth breathing versus nasal breathing comparison' | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.image_bottom != blank -%}
        <div class="lt-nasal__media-item">
          <img
            class="lt-nasal__img"
            src="{{ section.settings.image_bottom | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.image_bottom | image_url: width: 400 }} 400w,
              {{ section.settings.image_bottom | image_url: width: 700 }} 700w,
              {{ section.settings.image_bottom | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 767px) 100vw, 500px"
            width="{{ section.settings.image_bottom.width }}"
            height="{{ section.settings.image_bottom.height }}"
            alt="{{ section.settings.image_bottom.alt | default: 'Sleep and heart rate statistics with customer testimonial' | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }

  #shopify-section-{{ section.id }} .lt-nasal__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 64px;
  }

  /* ── Content ── */
  #shopify-section-{{ section.id }} .lt-nasal__heading {
    margin: 0 0 24px;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .lt-nasal__body {
    font-size: 19px;
    line-height: 1.6;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .lt-nasal__body p {
    margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .lt-nasal__body p:last-child {
    margin-bottom: 0;
  }

  /* ── Media ── */
  #shopify-section-{{ section.id }} .lt-nasal__media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .lt-nasal__media-item {
    border-radius: 18px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .lt-nasal__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Responsive 767px ── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_mob }}px;
      padding-bottom: {{ pb_mob }}px;
      margin-top: {{ mt_mob }}px;
      margin-bottom: {{ mb_mob }}px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__heading {
      font-size: 30px;
      margin-bottom: 18px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__body {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__body p {
      margin-bottom: 18px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__media-item {
      border-radius: 14px;
    }
  }

  /* ── Responsive 480px ── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-nasal__heading {
      font-size: 25px;
    }
    #shopify-section-{{ section.id }} .lt-nasal__body {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Nasal Breathing",
  "class": "lt-section-affiliate-nasal-breathing",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Nasal Breathing Matters"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Our noses aren't just there to smell.</p><p>They're designed to filter, warm and humidify the air we breathe.</p><p>That's why healthy nasal breathing is an important habit — including during sleep.</p><p>And it's why more parents are beginning to pay attention not only to how much their kids sleep, but how they're breathing while they sleep.</p>"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top image",
      "info": "e.g. mouth breathing vs nasal breathing comparison graphic"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom image",
      "info": "e.g. sleep/heart rate stats card with testimonial"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "LT Nasal Breathing",
      "category": "LT Sections",
      "settings": {
        "bg_color": "#EEECFB"
      }
    }
  ]
}
{% endschema %}
