{%- liquid
  assign pt_desk = section.settings.padding_top
  assign pb_desk = section.settings.padding_bottom
  assign mt_desk = section.settings.margin_top
  assign mb_desk = section.settings.margin_bottom
  assign pt_mob  = pt_desk | times: 0.6 | round
  assign pb_mob  = pb_desk | times: 0.6 | round
  assign mt_mob  = mt_desk | times: 0.6 | round
  assign mb_mob  = mb_desk | times: 0.6 | round
-%}

<div
  class="lt-bundle-save"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt_desk }}px;
    padding-bottom: {{ pb_desk }}px;
    margin-top: {{ mt_desk }}px;
    margin-bottom: {{ mb_desk }}px;
  "
>
  <div class="page-width">
    <div class="lt-bundle-save__inner lt-bundle-save__inner--{{ section.settings.image_position }}">

      {%- comment -%} ── LEFT / CONTENT COLUMN ── {%- endcomment -%}
      <div class="lt-bundle-save__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="lt-bundle-save__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <{{ section.settings.heading_tag }} class="lt-bundle-save__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>

        {%- if section.blocks.size > 0 -%}
          <ul class="lt-bundle-save__bullets" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bullet' -%}
                <li class="lt-bundle-save__bullet" {{ block.shopify_attributes }}>
                  <span class="lt-bundle-save__bullet-icon" aria-hidden="true">
                    {%- if block.settings.icon == 'check' -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" stroke="{{ section.settings.bullet_icon_color }}" stroke-width="1.5"/>
                        <path d="M6 10.5L8.5 13L14 7.5" stroke="{{ section.settings.bullet_icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- else -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" stroke="{{ section.settings.bullet_icon_color }}" stroke-width="1.5"/>
                        <path d="M7 10H13M10 7V13" stroke="{{ section.settings.bullet_icon_color }}" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                    {%- endif -%}
                  </span>
                  <span class="lt-bundle-save__bullet-text">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="lt-bundle-save__cta">
            <a
              href="{{ section.settings.button_url }}"
              class="lt-bundle-save__btn"
              {%- if section.settings.button_url == blank -%} aria-disabled="true" tabindex="-1"{%- endif -%}
            >
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ── RIGHT / IMAGE COLUMN ── {%- endcomment -%}
      <div class="lt-bundle-save__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="lt-bundle-save__image"
          >
        {%- else -%}
          <div class="lt-bundle-save__image-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'lt-bundle-save__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  /* ── Base ── */
  #shopify-section-{{ section.id }} {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save {
    position: relative;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__inner {
    display: flex;
    align-items: center;
    gap: {{ section.settings.column_gap }}px;
    min-height: {{ section.settings.min_height }}px;
  }

  /* Image right (default) */
  #shopify-section-{{ section.id }} .lt-bundle-save__inner--right {
    flex-direction: row;
  }
  /* Image left */
  #shopify-section-{{ section.id }} .lt-bundle-save__inner--left {
    flex-direction: row-reverse;
  }

  /* ── Content column ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__content {
    flex: 0 0 {{ section.settings.content_width }}%;
    max-width: {{ section.settings.content_width }}%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  /* ── Eyebrow ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  /* ── Heading ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: {{ section.settings.heading_color }};
    margin: 0;
    margin-bottom: 10px;
  }

  /* ── Bullets ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__bullet {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__bullet-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  /* ── CTA ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__cta {
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    padding: 18px 32px;
    border-radius: 60px;
    border: 2px solid transparent;
    transition: opacity 0.2s ease, transform 0.15s ease;
    cursor: pointer;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__btn:active {
    transform: translateY(0);
    opacity: 1;
  }

  /* ── Media column ── */
  #shopify-section-{{ section.id }} .lt-bundle-save__media {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    align-self: stretch;
    overflow: visible;
    position: relative;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: bottom center;
    max-height: {{ section.settings.image_max_height }}px;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__image-placeholder {
    width: 100%;
    background: rgba(0,0,0,0.06);
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  #shopify-section-{{ section.id }} .lt-bundle-save__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_mob }}px !important;
      padding-bottom: {{ pb_mob }}px !important;
      margin-top: {{ mt_mob }}px !important;
      margin-bottom: {{ mb_mob }}px !important;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__inner,
    #shopify-section-{{ section.id }} .lt-bundle-save__inner--left {
      flex-direction: column;
      gap: 32px;
      min-height: unset;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__content {
      flex: unset;
      max-width: 100%;
      width: 100%;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__heading {
      font-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__media {
      width: 100%;
      max-width: 480px;
      align-self: center;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__image {
      max-height: 340px;
    }
  }

  /* ── Mobile ── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-bundle-save__heading {
      font-size: {{ section.settings.heading_size | times: 0.75 | round }}px;
      text-align: center;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__cta {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__bullet {
      font-size: 15px;
      font-weight: 600;
      align-items: flex-start;
    }
    #shopify-section-{{ section.id }} .lt-bundle-save__btn {
      width: 100%;
      justify-content: center;
      padding: 12px 30px;
    }
  }
</style>

{% schema %}
{
  "name": "Bundle & Save Banner",
  "tag": "div",
  "class": "shopify-section--bundle-save",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#E8E9F8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1d3b"
    },
    {
      "type": "color",
      "id": "bullet_icon_color",
      "label": "Bullet icon color",
      "default": "#1a1d3b"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 36,
      "max": 96,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Sleeping Better Tonight"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#1a1d3b"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Image max height",
      "min": 200,
      "max": 600,
      "step": 20,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 700,
      "step": 20,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "DreamWeave Blanket + Mouth Tape"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "plus", "label": "Plus" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Bundle & Save Banner",
      "blocks": [
        {
          "type": "bullet",
          "settings": {
            "text": "DreamWeave Blanket + Mouth Tape",
            "icon": "check"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Train your body to breathe better + sleep deeper",
            "icon": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}
