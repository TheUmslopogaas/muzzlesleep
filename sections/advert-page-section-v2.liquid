      gap: 18px;
      align-items: start;
    }

    .lt-advhero__title{
      font-size: 30px;
    }
  }

  @media (max-width: 520px){
    .lt-advhero__title{
      font-size: 28px;
    }
  }
  sticky-header.header-wrapper.color-scheme-1.gradient.header-wrapper--border-bottom {
    display: none;
  }
</style>




