<div id="shopify-section-{{ section.id }}" class="lt-benefits-section">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="lt-benefits-header">
        <h2 class="lt-benefits-title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_mobile_carousel -%}
      <div class="lt-benefits-carousel swiper">
    {%- endif -%}
    <div class="lt-benefits-grid{% if section.settings.enable_mobile_carousel %} swiper-wrapper{% endif %}">
      {%- for block in section.blocks -%}
        <div class="lt-benefits-card{% if section.settings.enable_mobile_carousel %} swiper-slide{% endif %}" {{ block.shopify_attributes }}>
          <div class="lt-benefits-icon-wrapper" style="{% if section.settings.show_icon_bg %}background-color: {{ section.settings.icon_bg_color }};{% else %}background-color: transparent;{% endif %}">
            {%- if block.settings.custom_svg != blank -%}
              <div class="lt-benefits-svg-wrap" style="color: {{ section.settings.heading_color }};">
                {{ block.settings.custom_svg }}
              </div>
            {%- elsif block.settings.icon_image != blank -%}
              <img 
                src="{{ block.settings.icon_image | image_url: width: 160 }}" 
                alt="{{ block.settings.icon_image.alt | escape | default: block.settings.title }}" 
                loading="lazy" 
                width="{{ block.settings.icon_image.width }}" 
                height="{{ block.settings.icon_image.height }}"
                class="lt-benefits-img"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'lt-placeholder-svg' }}
            {%- endif -%}
          </div>
          
          {%- if block.settings.title != blank -%}
            <h3 class="lt-benefits-card-title" style="color: {{ section.settings.heading_color }};">{{ block.settings.title }}</h3>
          {%- endif -%}
          
          {%- if block.settings.text != blank -%}
            <div class="lt-benefits-card-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.enable_mobile_carousel -%}
        <div class="swiper-pagination"></div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="lt-benefits-footer">
        <a href="{{ section.settings.button_link | default: '#' }}" 
           class="lt-benefits-btn"
           style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* Scoped Section Styles */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* Desktop First Layout */
  #shopify-section-{{ section.id }} .lt-benefits-header {
    text-align: center;
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .lt-benefits-title {
    color: {{ section.settings.heading_color }};
    font-size: 36px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .lt-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Force Grid on Desktop (Overrides Swiper's Default Flexbox) */
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .lt-benefits-grid.swiper-wrapper {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 24px !important;
      transform: none !important;
      width: auto !important;
    }
    #shopify-section-{{ section.id }} .lt-benefits-card.swiper-slide {
      width: auto !important;
      margin-right: 0 !important;
      height: auto !important;
    }
    #shopify-section-{{ section.id }} .lt-benefits-carousel.swiper {
      overflow: visible !important;
    }
  }

  #shopify-section-{{ section.id }} .lt-benefits-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: 12px;
    padding: 48px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .lt-benefits-icon-wrapper {
    /* Scale wrapper proportionately (2x the icon size) based on original design */
    width: {{ section.settings.icon_size | times: 2 }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .lt-benefits-svg-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }
  #shopify-section-{{ section.id }} .lt-benefits-svg-wrap svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
  }
  #shopify-section-{{ section.id }} .lt-benefits-img {
    max-width: {{ section.settings.icon_size }}px;
    max-height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .lt-placeholder-svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    background-color: transparent;
    fill: #ffffff;
    opacity: 0.7;
  }
  #shopify-section-{{ section.id }} .lt-benefits-card-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 12px 0;
    line-height: 1.3;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .lt-benefits-card-text {
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .lt-benefits-card-text p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-benefits-card-text p + p {
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .lt-benefits-footer {
    text-align: center;
    margin-top: 48px;
  }
  #shopify-section-{{ section.id }} .lt-benefits-btn {
    display: inline-block;
    padding: 16px 48px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    letter-spacing: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-benefits-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* Tablet Breakpoint (767px) */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
      margin-top: {{ section.settings.margin_top | times: 0.6 | round }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.6 | round }}px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-title {
      font-size: 32px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-header {
      margin-bottom: 32px;
    }
    
    #shopify-section-{{ section.id }} .lt-benefits-footer {
      margin-top: 32px;
    }
  }

  /* Small Mobile Breakpoint (480px) */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-benefits-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .lt-benefits-btn {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 30px;
      font-size: 14px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-card {
      padding: 25px 15px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-img {
      max-width: {{ section.settings.icon_size | times: 0.8 }}px;
      max-height: {{ section.settings.icon_size | times: 0.8 }}px;      
    }
  }

  {% if section.settings.enable_mobile_carousel %}
  /* Mobile Swiper Styles */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .lt-benefits-carousel.swiper {
      overflow: hidden;
      width: 100%;
      padding-bottom: 10px;
    }
    #shopify-section-{{ section.id }} .lt-benefits-grid.swiper-wrapper {
      display: flex;
      flex-wrap: nowrap;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .lt-benefits-card.swiper-slide {
      height: auto;
    }
    #shopify-section-{{ section.id }} .swiper-pagination {
      position: relative;
      margin-top: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
    }
    #shopify-section-{{ section.id }} .swiper-pagination-bullet {
      width: 8px;
      height: 8px;
      background-color: {{ section.settings.heading_color }};
      opacity: 0.3;
      border-radius: 4px;
      margin: 0 !important;
      transition: width 0.3s ease, opacity 0.3s ease;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
      width: 30px;
      opacity: 1;
    }
  }
  {% endif %}
</style>

{% if section.settings.enable_mobile_carousel %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initBenefitsSwiper_{{ section.id | remove: '-' }}() {
      var container = document.querySelector('#shopify-section-{{ section.id }} .lt-benefits-carousel');
      if (!container) return;

      var swiperInstance = null; // Explicitly track the instance

      var checkAndInit = function() {
        if (window.innerWidth <= 767) {
          if (!swiperInstance) {
            if (typeof Swiper === 'undefined') {
              setTimeout(checkAndInit, 100);
              return;
            }
            swiperInstance = new Swiper(container, {
              slidesPerView: 1.3,
              spaceBetween: 16,
              pagination: {
                el: '#shopify-section-{{ section.id }} .swiper-pagination',
                clickable: true,
              },
            });
          }
        } else {
          if (swiperInstance) {
            swiperInstance.destroy(true, true);
            swiperInstance = null; // Reset the tracker
          }
        }
      };

      checkAndInit();
      window.addEventListener('resize', checkAndInit);
    }
    
    initBenefitsSwiper_{{ section.id | remove: '-' }}();
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Benefits Grid",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#28234A"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#F8F8FD"
    },
    {
      "type": "checkbox",
      "id": "show_icon_bg",
      "label": "Show Icon Background",
      "default": true
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#BCA6FF",
      "visible_if": "{{section.settings.show_icon_bg == true}}"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#28234A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content & Sizing"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Carousel on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 40
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Benefits"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get Muzzle Gravity Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Transparent PNG recommended."
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Overrides Icon Image if provided."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Fall asleep faster"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Stop laying awake for hours — your body transitions into rest mode quicker.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "category": "Text",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Fall asleep faster",
            "text": "<p>Stop laying awake for hours — your body transitions into rest mode quicker.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Stay asleep longer",
            "text": "<p>Less tossing, less waking up throughout the night.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Reduce stress + anxiety",
            "text": "<p>Feel calmer within minutes of using it.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Wake up more refreshed",
            "text": "<p>Deeper sleep = better mornings.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}