    <script>
        var reviewSwiper = new Swiper('{{ _section }} .product_review_slider .swiper', {
            spaceBetween: 10,
            slidesPerView: 1,
            navigation: {
                nextEl: '{{ _section }} .product_review_slider .next_button',
                prevEl: '{{ _section }} .product_review_slider .prev_button',
            },
        });

        $('{{ _section }} .accordian_item_header').on('click', function() {
            $(this).siblings('.accordian_item_body').slideToggle('fast');
            $(this).parent().toggleClass('opened');
        });

        $('.dynamic_part').on('click', '.selling_plan_single', function() {
            if (!$(this).hasClass('selected')) {
                $('.selling_plan_single').removeClass('selected');
                $(this).addClass('selected');
            }

            $('.checkout_btn').attr('sel_id', $(this).attr('sel_id'));
            $('.checkout_btn').attr('vt_id', $(this).attr('vt_id'));
        })

        function add_to_cart(el) {
            let vt_id = el.attr('vt_id');
            let sel_id = el.attr('sel_id');

            let addData = {
                    "id": vt_id,
                    "quantity": 1,
                };
            if (sel_id != '') {
                addData['selling_plan'] = sel_id;
            }
            $.ajax({
                type: 'POST', 
                url: '/cart/add.js',
                dataType: 'json', 
                data: addData,
                success: function(cart) {
                    console.log(`%c Added item to cart`, "background: green;color:#fff;font-size: 14px;", cart);
                    setTimeout(() => {
                        go_to_cart();
                    }, 500);
                },
                error: function (e) {
                    console.log(`%c Error whiling adding item to cart`, "background: red;color:#fff;font-size: 14px;", e);
                }
            });
        }

        function go_to_cart() {
            //location.href = '/cart';
        }

        function reRenderDynamicPart(p_handle) {
            $.ajax({ 
                url: `/products/${p_handle}/?section_id=product-main`,
                type: 'GET',
            }).then(res => {
                var dynamic_part = $(res).find('.dynamic_part').children();
                $('.dynamic_part').empty();
                $('.dynamic_part').append(dynamic_part);
                console.log('%c Dynamic Part refreshed', "background:#d5e6c5;color:red;");

                let selectedAge = $('.age_selector_single.selected').attr('data-age');
                let selectedStrength = $('.strength_selector_single.selected').attr('data-strength');
                $('.buy_area_section').attr('data-age', selectedAge);
                $('.buy_area_section').attr('data-strength', selectedStrength);

                $('.product_swiper_part').addClass('always__hidden');
                $(`.product_swiper_part[data-strength="${selectedStrength}"][data-age="${selectedAge}"]`).removeClass('always__hidden');
            });
        }
    </script>


{%- endcapture -%}

