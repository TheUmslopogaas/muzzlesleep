            {
                "type": "range",
                "id": "padding_top",
                "label": "Desktop padding top",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "label": "Desktop padding bottom",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_top_mobile",
                "label": "Mobile padding top",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            },
            {
                "type": "range",
                "id": "padding_bottom_mobile",
                "label": "Mobile padding bottom",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            },
            {
                "type": "checkbox",
                "id": "youth_selected",
