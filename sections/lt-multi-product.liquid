{% comment %} Fork of the existing section {% endcomment %}
{% assign _ss = section.settings %}
{% assign _section = section.id | split: '__' | last | slice: -4, 4 | prepend: '#product_main_' %}

{% assign mother_product = settings.mother_product %}
{% if template.name == 'product' %}
    {% assign main_variant = product.selected_or_first_available_variant %}
    {% for product_by_age in mother_product.products_by_age.value %}
        {% if main_variant.product.title contains product_by_age.age.value %}
            {% assign first_product_by_age = product_by_age %}
        {% endif %}
    {% endfor %}

{% else %}
    {% assign first_product_by_age = mother_product.products_by_age.value | first %}
    {% assign first_product_by_medium = first_product_by_age.products_by_strength.value | first %}
    {% assign main_variant = first_product_by_medium.variant.value %}
{% endif %}

{% assign review_blocks = section.blocks | where: 'type', 'review' %}
{% assign dropdown_blocks = section.blocks | where: 'type', 'dropdown' %}

{%- capture section_content -%}
    <style>
        {{ _section }} {
            position: relative;
            padding-top: {{ _ss.padding_top }}px;
            padding-bottom: {{ _ss.padding_bottom }}px;
            background: {{ _ss.background }};
        }
    
        {{ _section }} .section_holder {
            position: relative;
            max-width: 1440px;
            margin: auto;
            padding: 0px 40px;
        }
    
        {{ _section }} .product_main_part {
            display: flex;
            justify-content: space-between;
        }
    
        {{ _section }} .product_info_part {
            /* max-width: 500px; */
            width: 43%;
            margin-left: 6%;
        }
    
        {{ _section }} .product_swiper_part {
            display: flex;
            flex-direction: column;
            width: 51%;
            height: fit-content;
            position: sticky;
            top: 40px;
        }
    
        {{ _section }} .product_main_swiper {
            position: relative;
        }
    
        {{ _section }} .image_wrapper {
            position: relative;
            padding-bottom: 100%;
        }
    
        {{ _section }} .main_image_el {
            border-radius: 12px;
        }
    
        {{ _section }} .product_thumb_swiper .swiper-slide {
            width: 74px;
            margin: 1px;
            border: 1px solid transparent;
            border-radius: 7px;
            overflow: hidden;
        }
    
        {{ _section }} .product_thumb_swiper {
            margin-top: 8px;
        }
    
        {{ _section }} .swiper-slide.swiper-slide-thumb-active {
            opacity: 1;
            border: 1px solid #8E8BA6;
        }
    
        {{ _section }} .image_wrapper img {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #F6F5FF;
        }

        {{ _section }} .image_wrapper video {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #F6F5FF;
        }
    
        {{ _section }} .product_main_swiper .swiper_ctrl_part {
            display: flex;
            position: absolute;
            z-index: 1;
            bottom: 20px;
            right: 20px;
        }
    
        {{ _section }} .product_main_swiper .swiper_ctrl {
            width: 38px;
            height: 38px;
            cursor: pointer;
        }
    
        {{ _section }} .product_main_swiper .swiper_ctrl img {
            width: 100%;
            height: 100%;
        }
    
        {{ _section }} .product_main_swiper .swiper_ctrl.next_button {
            margin-left: 6px;
        }
    
        {{ _section }} .product_summary_part {
            display: grid;
            grid-template-columns: repeat(2, auto);
            grid-template-rows: repeat(3, auto);
            grid-column-gap: 0px;
            grid-row-gap: 0px;
        }

        {{ _section }} .product_top_badge {
          grid-area: 1 / 1 / 2 / 2;
          font-size: 14px;
          line-height: 1;
          background-color: #5C4CCC;
          padding: 7px 15px;
          border-radius: 100px;
          display: inline-block;
          max-width: fit-content;
          color: #fff;
          margin-bottom: 10px;
          font-weight: 400;          
        }
        {{ _section }} .product_review_part {grid-area: 3 / 1 / 4 / 2;display: flex;flex-direction: row;align-items: center;}
        {{ _section }} .product_title {grid-area: 2 / 1 / 3 / 2;color: #27214D;font-family: Manrope;font-size: 30px;font-style: normal;font-weight: 700;line-height: 120%; /* 36px */letter-spacing: -0.6px;margin-bottom: 10px;}
        {{ _section }} .product_subtitle {grid-area: 4 / 1 / 5 / 2;color: #27214D;font-family: Manrope;font-size: 16px;font-style: normal;font-weight: 400;line-height: 1.5; /* 19.2px */letter-spacing: 0px;margin-top: 15px;padding-top: 10px;border-top: 2px solid #ddd;}
        {{ _section }} .product_badge {grid-area: 1 / 2 / 4 / 3;width: 80px;display: flex;align-items: flex-end;margin-left: 10px;}
    
        {{ _section }} .product_badge img {
            width: 100%;
            object-fit: contain;
            object-position: bottom;
        }
    
        {{ _section }} .review_star {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }
    
        {{ _section }} .review_star svg {
            width: 16px;
            height: 16px;
        }
    
        {{ _section }} .review_score {
            margin-left: 7px;
            color: #27214D;
            font-family: Manrope;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: normal;
        }
    
        {{ _section }} .product_tag_part {
            margin-top: 20px;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
        }
    
        {{ _section }} .product_tag {
            border-radius: 5px;
            border: 1px solid #E9E6FF;
            background: #F6F5FF;
            padding: 0 8px;
            height: 28px;
            color: #27214D;
            text-align: center;
            font-family: Manrope;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 1;
            margin-right: 4px;
            margin-bottom: 4px;
            letter-spacing: 0.2px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    
        {{ _section }} .dynamic_part {
            margin-top: 50px;
        }
    
        {{ _section }} .dynamic_part_divider {
            color: #000;
            font-family: Manrope;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 14px */
            letter-spacing: -0.28px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
    
        {{ _section }} .dynamic_part_divider:before {
            position: absolute;
            content: "";
            height: 1.5px;
            background: #E3DAEF;
            width: 100%;
            top: 50%;
            transform: translateY(-1px);
        }
    
        {{ _section }} .dynamic_part_divider span {
            background: #FFF;
            z-index: 1;
            padding: 0 16px;
        }
    
        {{ _section }} .age_selector_wrapper {
            display: flex;
            flex-direction: row;
            margin-top: 10px;
        }
    
        {{ _section }} .age_selector_single {
            display: flex;
            align-items: center;
            justify-content: center;
            width: calc(50% - 4px);
            height: 50px;
            border-radius: 10px;
            border: 1px solid #E3DAEF;
            background: #FFF;
            margin-right: 8px;
            color: #000;
            text-align: center;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 16px; /* 100% */
            letter-spacing: -0.32px;
            cursor: pointer;
        }
    
        {{ _section }} .age_selector_single:last-child {
            margin-right: 0;
        }
    
        {{ _section }} .age_selector_single.selected {
            border: 1px solid #27214D;
            background: #F6F5FF;
        }

        {{ _section }} .age_selector_single.disabled_choice {
            cursor: not-allowed;
            background: #EEEEEE;
        }
    
        {{ _section }} .strength_part {
            margin-top: 35px;
        }
    
        {{ _section }} .strength_selector_wrapper {
            margin-top: 10px;
            display: flex;
        }
    
        {{ _section }} .strength_selector_single {
            display: flex;
            align-items: center;
            justify-content: center;
            width: calc(50% - 4px);
            border-radius: 10px;
            border: 1px solid #E3DAEF;
            background: #FFF;
            margin-right: 8px;
            color: #000;
            text-align: center;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 16px; /* 100% */
            letter-spacing: -0.32px;
            cursor: pointer;
            flex-direction: column;
            padding: 18px 30px;
        }
    
        {{ _section }} .strength_selector_single img {
            width: 50%;
        }
    
        {{ _section }} .strength_el_heading {
            color: #000;
            text-align: center;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 16px */
            letter-spacing: -0.32px;
            margin-top: 10px;
        }
    
        {{ _section }} .strength_el_subheading {
            color: #9793B0;
            text-align: center;
            font-family: Manrope;
            font-size: 13px;
            font-style: normal;
            font-weight: 600;
            line-height: 120%; /* 15.6px */
            letter-spacing: -0.26px;
            margin-top: 5px;
            max-width: 150px;
        }
    
        {{ _section }} .strength_selector_single:last-child {
            margin-right: 0;
        }
    
        {{ _section }} .strength_selector_single.selected {
            border: 1px solid #27214D;
            background: #F6F5FF;
        }
    
        {{ _section }} .purchase_part {
            margin-top: 35px;
        }
    
        {{ _section }} .selling_plan_single {
            margin-top: 10px;
            border-radius: 10px;
            border: 1px solid #E3DAEF;
            padding: 10px 13px;
        }
        
        {{ _section }} .selling_plan_single_header {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            margin: 10px 0;            
        }
    
        {{ _section }} .radio_btn {
            border: 1px solid #E3DAEF;
            width: 20px;
            min-width: 20px;
            height: 20px;
            border-radius: 100%;
            position: relative;
        }
    
        {{ _section }} .selling_plan_name {
            margin: 0 12px;
        }

        {{ _section }} .selling_plan_heading {
            color: #000;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 16px */
            letter-spacing: -0.32px;
        }

        {{ _section }} .selling_plan_desc {
            color: #9793B0;
            font-family: Manrope;
            font-size: 12px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 12px */
            letter-spacing: -0.24px;
            margin-top: 7px;
        }

        .selling_plan_saving_badge {
            color: #FFF;
            text-align: center;
            font-family: Manrope;
            font-size: 12px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 12px */
            letter-spacing: -0.24px;
            border-radius: 5px;
            background: #27214D;
            padding: 0 9px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            margin: 0 12px auto 0;
        }

        {{ _section }} .selling_plan_price_el {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
            margin-left: auto;
        }
    
        {{ _section }} .selling_plan_r_price {
            color: #27214D;
            text-align: center;
            font-family: Manrope;
            font-size: 20px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 20px */
            letter-spacing: -0.4px;
        }
    
        {{ _section }} .selling_plan_c_price {
            color: #9793B0;
            text-align: center;
            font-family: Manrope;
            font-size: 12px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 12px */
            letter-spacing: -0.24px;
            margin-top: 7px;
            text-decoration: line-through;
        }
    
        {{ _section }} .selling_plan_single.selected {
            border: 1px solid #27214D;
            background: #F6F5FF;
        }
    
        {{ _section }} .selling_plan_single.selected .radio_btn {
            border: 1px solid #000;
            background: #27214D;
            box-shadow: inset 0 0 0 3px #FFF;
        }
    
        {{ _section }} .selling_plan_usp_wrapper {
            display: none;
        }
        {{ _section }} .selling_plan_single.selected .selling_plan_usp_wrapper {
            margin-top: 15px;
            background: #FFF;
            border-radius: 12px;
            padding: 12px;
            display: grid;
            grid-template-columns: 1fr;
            grid-row-gap: 4px;
        }

        {{ _section }} .sub_usp_single {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
        }

        {{ _section }} .sub_usp_single img {
            width: 26px;
            height: 26px;
            display: block;
            margin-right: 5px;
        }

        {{ _section }} .sub_usp_text {
            color: #27214D;
            font-family: Manrope;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 14px */
            letter-spacing: -0.28px;
            text-transform: capitalize;
        }
    
        {{ _section }} .checkout_btn {
            border-radius: 34.286px;
            background: #27214D;
            box-shadow: -24px 18.286px 11.429px 0px rgba(153, 145, 189, 0.04), -13.714px 10.286px 10.286px 0px rgba(153, 145, 189, 0.13), -5.714px 4.571px 6.857px 0px rgba(153, 145, 189, 0.23), -1.143px 1.143px 4.571px 0px rgba(153, 145, 189, 0.25);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 58px;
            margin-top: 35px;
            cursor: pointer;
        }
    
        {{ _section }} .checkout_btn span {
            color: #FFF;
            text-align: center;
            font-family: Manrope;
            font-size: 18px;
            font-style: normal;
            font-weight: 700;
            line-height: 100%; /* 18px */
            letter-spacing: -0.36px;
            text-transform: capitalize;
            margin-right: 10px;
        }
    
        {{ _section }} .checkout_btn_caption {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: row;
            margin-top: 10px;
        }
    
        {{ _section }} .checkout_btn_caption span {
            color: #27214D;
            font-family: Manrope;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 14px */
            letter-spacing: -0.28px;
            text-transform: capitalize;
            margin-left: 8px;
        }
    
        {{ _section }} .checkout_btn_caption img {
            width: 24px;
            height: 18px;
        }
    
        {{ _section }} .review_wrapper {
            border-radius: 9px;
            border: 1px solid #E3DAEF;
            padding: 13px;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
        }
    
        {{ _section }} .review_img_wrapper {
            min-width: 70px;
            width: 70px;
            height: 80px;
            position: relative;
            margin-right: 13px;
            border-radius: 9px;
            overflow: hidden;
        }
    
        {{ _section }} .review_img_wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    
        {{ _section }} .review_heading {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
        }
    
        {{ _section }} .review_heading span {
            color: #27214D;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 16px */
            letter-spacing: -0.32px;
            margin-right: 7px;
        }
    
        {{ _section }} .review_content {
            color: #27214D;
            font-family: Manrope;
            font-size: 13px;
            font-style: normal;
            font-weight: 400;
            line-height: 130%; /* 16.9px */
            letter-spacing: -0.26px;
            margin-top: 7px;
        }
    
        {{ _section }} .product_review_slider .swiper_ctrl {
            width: 27px;
            height: 27px;
            border-radius: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F6F5FF;
            position: absolute;
            top: calc(50% - 13px);
            z-index: 2;
            cursor: pointer;
        }
    
        {{ _section }} .product_review_slider .swiper_ctrl.prev_button {
            left: -13px;
        }
    
        {{ _section }} .product_review_slider .swiper_ctrl.next_button {
            right: -13px;
        }
    
        {{ _section }} .product_review_slider .swiper_ctrl.swiper-button-disabled {
            display: none;
        }
    
        {{ _section }} .product_review_slider {
            position: relative;
            margin-top: 50px;
        }
    
        {{ _section }} .accordian_item {
            border-bottom: 1px solid #E3DAEF;
            padding-bottom: 20px;
            padding-top: 20px;
        }
    
        {{ _section }} .accordian_item:last-child {
            border-bottom: unset;
        }
    
        {{ _section }} .accordian_item_header {
            display: flex;
            justify-content: space-between;
            cursor: pointer;
        }
    
        {{ _section }} .product_accordian {
            margin-top: 15px;
        }
    
        {{ _section }} .accordian_item_title {
            color: #27214D;
            font-family: Manrope;
            font-size: 16px;
            font-style: normal;
            font-weight: 600;
            line-height: 100%; /* 16px */
            letter-spacing: -0.32px;
        }
    
        {{ _section }} .arrow_down {
            width: 18px;
            height: 18px;
            transition: all 0.3s linear;
        }
    
        {{ _section }} .arrow_down img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    
        {{ _section }} .accordian_item_body_wrapper {
            color: #27214D;
            font-family: Manrope;
            font-size: 13px;
            font-style: normal;
            font-weight: 400;
            line-height: 130%;
            letter-spacing: -0.26px;
            padding-left: 10px;
            margin: 20px 0 0;
        }
    
        {{ _section }} .accordian_item_body_wrapper p {
            margin: 5px 0;
        }
    
        {{ _section }} .accordian_item.opened .arrow_down {
            transform: rotate(135deg);
        }

        {{ _section }} .always__hidden {
            display: none !important;
        }
    
        #shopify-section-{{ section.id }} .product_review_part {
            display: flex;
            font-size: 14px;
            letter-spacing: 0.2px;
            gap: 2px 5px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 5px;
        }
        #shopify-section-{{ section.id }} .review_text {
            width: 100%;
        }

