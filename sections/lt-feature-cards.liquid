{%- liquid
  assign pt     = section.settings.padding_top
  assign pb     = section.settings.padding_bottom
  assign mt     = section.settings.margin_top
  assign mb     = section.settings.margin_bottom
  assign pt_mob = pt | times: 0.6 | round
  assign pb_mob = pb | times: 0.6 | round
  assign mt_mob = mt | times: 0.6 | round
  assign mb_mob = mb | times: 0.6 | round
-%}

<div
  class="lt-feat-cards"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  "
>
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="lt-feat-cards__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div
      class="lt-feat-cards__grid"
      style="--lt-cols: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="lt-feat-cards__card" {{ block.shopify_attributes }}>

            <div class="lt-feat-cards__img-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | img_url: 'master' }}"
                  alt="{{ block.settings.image.alt | default: block.settings.card_heading | escape }}"
                  class="lt-feat-cards__img"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lt-feat-cards__img lt-feat-cards__img--placeholder' }}
              {%- endif -%}
            </div>

            <div class="lt-feat-cards__body">
              {%- if block.settings.card_heading != blank -%}
                <h3 class="lt-feat-cards__card-heading" style="color: {{ section.settings.card_heading_color }};">
                  {{ block.settings.card_heading }}
                </h3>
              {%- endif -%}
              {%- if block.settings.card_text != blank -%}
                <p class="lt-feat-cards__card-text" style="color: {{ section.settings.card_text_color }};">
                  {{ block.settings.card_text }}
                </p>
              {%- endif -%}
            </div>

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    /* scoped root */
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__heading {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.3px;
    text-align: center;
    margin: 0 0 48px;
  }

  /* ── Grid ────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-feat-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols, 3), 1fr);
    gap: {{ section.settings.card_gap }}px;
    align-items: start;
  }

  /* ── Card ────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-feat-cards__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Image ───────────────────────────── */
  #shopify-section-{{ section.id }} .lt-feat-cards__img-wrap {
    border-radius: {{ section.settings.img_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.img_ratio }};
    background: #eceaf2;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.45s ease;
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__card:hover .lt-feat-cards__img {
    transform: scale(1.03);
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__img--placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }

  /* ── Body ────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-feat-cards__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__card-heading {
    font-size: 25px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .lt-feat-cards__card-text {
    font-size: 16px;
    line-height: 1.65;
    margin: 0;
    font-weight: 500;
  }

  /* ── Responsive 767px ────────────────── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .lt-feat-cards {
      padding-top: {{ pt_mob }}px !important;
      padding-bottom: {{ pb_mob }}px !important;
      margin-top: {{ mt_mob }}px !important;
      margin-bottom: {{ mb_mob }}px !important;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__heading {
      font-size: 32px;
      margin-bottom: 32px;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__card-heading {
      font-size: 19px;
    }
  }

  /* ── Responsive 480px ────────────────── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-feat-cards__heading {
      font-size: 26px;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__card-heading {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .lt-feat-cards__card-text {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Feature Cards",
  "class": "lt-section-feature-cards",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Section heading color",
      "default": "#1e1b4b"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "default": "#1e1b4b"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#3d3d50"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Why You'll Love Them"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (tablet)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 28
    },
    {
      "type": "select",
      "id": "img_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "3 / 4",  "label": "Portrait (3:4)" },
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "4 / 3",  "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "img_radius",
      "label": "Image corner radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "card_heading",
          "label": "Heading",
          "default": "Quiet Without the Discomfort"
        },
        {
          "type": "textarea",
          "id": "card_text",
          "label": "Body text",
          "default": "Traditional foam earplugs can feel bulky, itchy, or painful. Muzzle Snooze™ uses a soft, ergonomic looped design that fits naturally in the ear—no harsh pressure, no soreness."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LT Feature Cards",
      "category": "LT Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_heading": "Quiet Without the Discomfort",
            "card_text": "Traditional foam earplugs can feel bulky, itchy, or painful. Muzzle Snooze™ uses a soft, ergonomic looped design that fits naturally in the ear—no harsh pressure, no soreness."
          }
        },
        {
          "type": "card",
          "settings": {
            "card_heading": "Up to 33dB Noise Reduction",
            "card_text": "Helps reduce common sleep-disrupting sounds like snoring, traffic, roommates, or hotel noise so you can fall asleep faster and stay asleep longer."
          }
        },
        {
          "type": "card",
          "settings": {
            "card_heading": "Stays Put All Night",
            "card_text": "The unique twist-lock shape keeps the earplugs securely in place—even if you toss and turn—so you're not waking up to readjust."
          }
        }
      ]
    }
  ]
}
{% endschema %}
