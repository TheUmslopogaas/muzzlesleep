
<style>
  #shopify-section-{{ section.id }} .lt-guide-mistakes {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .lt-container {
    max-width: 1000px;
    width: 95%;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-header {
    text-align: center;
    margin-bottom: 32px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-title {
    font-size: 40px;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lt-guide-mistakes-table-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-head-col {
    flex: 1 1 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-head-col-left {
    color: #c62828;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-head-col-right {
    color: #27214D;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .lt-guide-mistakes-rows {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-row:nth-child(odd) {
    background: #f4f4f4;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-row {
    display: flex;
    align-items: center;
    gap: 24px;
    border-radius: 2px;
    padding: 16px 24px;
    min-height: 90px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-col {
    flex: 1 1 0;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #ffffff;
    flex-shrink: 0;
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-icon-bad {
    background: #c62828;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-icon-good {
    background: #27214D;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-text {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.8;
    color: #121212;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .lt-guide-mistakes-bottom-image {
    margin-top: 24px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-bottom-image img {
    width: 100%;
    display: block;
    border-radius: 8px;
  }
  #shopify-section-{{ section.id }} .lt-guide-mistakes-bottom-desc {
    margin: 16px 0 0;
    font-size: 18px;
    font-weight: 400;
    text-align: center;
    line-height: 1.7;
    text-align: left;
    color: #121212;
    letter-spacing: 0.3px;
    text-align: center;
  }

  @media(max-width:900px){
    #shopify-section-{{ section.id }} .lt-guide-mistakes {
      padding-top: calc({{ section.settings.padding_top }}px * 0.6);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.6);
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-table-head {
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-row {
      gap: 20px;
    }
  }

  @media(max-width:600px){
    #shopify-section-{{ section.id }} .lt-guide-mistakes-title {
      font-size: 28px;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-head-col {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-row {
      padding: 10px;
      gap: 10px
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-text {
      font-size: 14px;
      line-height: 1.5;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-col {
      gap: 5px;
      flex-direction: column;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-icon {
      width: 15px;
      height: 15px;
    }
    #shopify-section-{{ section.id }} .lt-guide-mistakes-bottom-desc {
      font-size: 16px;
    }    
  }
</style>

<section class="lt-guide-mistakes">
  <div class="lt-container">
    <div class="lt-guide-mistakes-header">
      <h2 class="lt-guide-mistakes-title">{{ section.settings.title }}</h2>
    </div>

    <div class="lt-guide-mistakes-table">
      <div class="lt-guide-mistakes-table-head">
        <div class="lt-guide-mistakes-head-col lt-guide-mistakes-head-col-left">
          {{ section.settings.col_left_label }}
        </div>
        <div class="lt-guide-mistakes-head-col lt-guide-mistakes-head-col-right">
          {{ section.settings.col_right_label }}
        </div>
      </div>

      <div class="lt-guide-mistakes-rows">
        {% for block in section.blocks %}
          {% if block.type == 'row' %}
            <div class="lt-guide-mistakes-row" {{ block.shopify_attributes }}>
              <div class="lt-guide-mistakes-col lt-guide-mistakes-col-left">
                <span class="lt-guide-mistakes-icon lt-guide-mistakes-icon-bad">✕</span>
                <p class="lt-guide-mistakes-text">{{ block.settings.mistake }}</p>
              </div>
              <div class="lt-guide-mistakes-col lt-guide-mistakes-col-right">
                <span class="lt-guide-mistakes-icon lt-guide-mistakes-icon-good">✓</span>
                <p class="lt-guide-mistakes-text">{{ block.settings.fix }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.bottom_image != blank %}
      <div class="lt-guide-mistakes-bottom-image">
        <img src="{{ section.settings.bottom_image | img_url: '1200x' }}" alt="{{ section.settings.bottom_description | strip_html | escape }}">
      </div>
    {% endif %}

    {% if section.settings.bottom_description != blank %}
      <div class="lt-guide-mistakes-bottom-desc">
        {{ section.settings.bottom_description }}
      </div>
    {% endif %}
  </div>
</section>


{% schema %}
{
  "name": "LT Guide Correction Table",
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": "Section title",
      "default": "Common Mistakes to Avoid"
    },
    {
      "id": "col_left_label",
      "type": "text",
      "label": "Left column heading",
      "default": "Mistake"
    },
    {
      "id": "col_right_label",
      "type": "text",
      "label": "Right column heading",
      "default": "How to Fix It"
    },
    {
      "id": "bottom_image",
      "type": "image_picker",
      "label": "Bottom image"
    },
    {
      "type": "richtext",
      "id": "bottom_description",
      "label": "Bottom description",
      "default": "<p>The first few nights may not be perfect — that’s okay and expected. Consistency improves sleep quality, which reduces restlessness over time. Once the child adjusts, most families report better sleep, easier mornings, and increased willingness to continue taping.</p>"
    },
    {
      "id": "padding_top",
      "type": "range",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    },
    {
      "id": "padding_bottom",
      "type": "range",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Mistake + Fix row",
      "settings": [
        {
          "id": "mistake",
          "type": "text",
          "label": "Mistake text",
          "default": "Mouth still opens"
        },
        {
          "id": "fix",
          "type": "textarea",
          "label": "How to fix it",
          "default": "Tape wasn’t stretched properly. Stretch tape slightly when applying."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Guide Correction Table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}