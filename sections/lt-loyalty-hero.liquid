{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round

  assign pb_mobile = section.settings.padding_bottom_mobile
-%}

<div class="lt-loyalty-hero">
  <div class="lt-loyalty-hero__bg">
    {%- if section.settings.background_image != blank -%}
      <img
        class="lt-loyalty-hero__bg-img lt-loyalty-hero__bg-img--desktop"
        src="{{ section.settings.background_image | image_url }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    {%- endif -%}
    {%- if section.settings.background_image_mobile != blank -%}
      <img
        class="lt-loyalty-hero__bg-img lt-loyalty-hero__bg-img--mobile"
        src="{{ section.settings.background_image_mobile | image_url }}"
        alt="{{ section.settings.background_image_mobile.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.background_image_mobile.width }}"
        height="{{ section.settings.background_image_mobile.height }}"
      >
    {%- endif -%}
    {%- if section.settings.background_image == blank and section.settings.background_image_mobile == blank -%}
      <div class="lt-loyalty-hero__bg-placeholder"></div>
    {%- endif -%}
    <div class="lt-loyalty-hero__overlay"></div>
  </div>

  <div class="page-width">
    <div class="lt-loyalty-hero__inner">

      <div class="lt-loyalty-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lt-loyalty-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="lt-loyalty-hero__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="lt-loyalty-hero__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank -%}
          <div class="lt-loyalty-hero__stats">
            {%- if section.settings.stat_1_value != blank -%}
              <div class="lt-loyalty-hero__stat">
                <span class="lt-loyalty-hero__stat-value">{{ section.settings.stat_1_value }}</span>
                {%- if section.settings.stat_1_label != blank -%}
                  <span class="lt-loyalty-hero__stat-label">{{ section.settings.stat_1_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.stat_2_value != blank -%}
              <div class="lt-loyalty-hero__stat">
                <span class="lt-loyalty-hero__stat-value">{{ section.settings.stat_2_value }}</span>
                {%- if section.settings.stat_2_label != blank -%}
                  <span class="lt-loyalty-hero__stat-label">{{ section.settings.stat_2_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.stat_3_value != blank -%}
              <div class="lt-loyalty-hero__stat">
                <span class="lt-loyalty-hero__stat-value lt-loyalty-hero__stat-value--accent">{{ section.settings.stat_3_value }}</span>
                {%- if section.settings.stat_3_label != blank -%}
                  <span class="lt-loyalty-hero__stat-label">{{ section.settings.stat_3_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="lt-loyalty-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="lt-loyalty-hero__button">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}

          {%- if section.settings.signin_text != blank or section.settings.signin_label != blank -%}
            <span class="lt-loyalty-hero__signin">
              {%- if section.settings.signin_text != blank -%}
                {{ section.settings.signin_text }}
              {%- endif -%}
              {%- if section.settings.signin_label != blank -%}
                <a href="{{ section.settings.signin_link }}" class="lt-loyalty-hero__signin-link">{{ section.settings.signin_label }}</a>
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </div>

      <div class="lt-loyalty-hero__media">
        {%- if section.settings.foreground_image != blank -%}
          <img
            class="lt-loyalty-hero__media-img"
            src="{{ section.settings.foreground_image | image_url }}"
            alt="{{ section.settings.foreground_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.foreground_image.width }}"
            height="{{ section.settings.foreground_image.height }}"
          >
        {%- else -%}
          {% comment %} {{ 'product-1' | placeholder_svg_tag: 'lt-loyalty-hero__media-placeholder' }} {% endcomment %}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__bg-img--mobile {
    display: none;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(120deg, #1a1440 0%, #3a2a6b 55%, #6a4fa0 100%);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    min-height: {{ section.settings.min_height }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__content {
    padding: 40px 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__eyebrow {
    display: inline-block;
    padding: 8px 20px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__heading {
    margin: 0 0 24px;
    font-size: 64px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -1px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__description {
    max-width: 560px;
    margin-bottom: 32px;
    font-size: 18px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__description p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stats {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 32px;
    padding: 20px 28px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 16px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 28px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat:first-child {
    padding-left: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat:last-child {
    padding-right: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat + .lt-loyalty-hero__stat {
    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat-value {
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat-value--accent {
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__stat-label {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__button {
    display: inline-block;
    padding: 18px 40px;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__signin {
    font-size: 15px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__signin-link {
    color: {{ section.settings.signin_link_color }};
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__signin-link:hover {
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__media-img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-hero__media-placeholder {
    width: 100%;
    max-width: 480px;
    height: auto;
    opacity: 0.4;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {% if pb_mobile > 0 %}{{ pb_mobile }}{% else %}{{ pb_m }}{% endif %}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    {%- if section.settings.background_image_mobile != blank -%}
      #shopify-section-{{ section.id }} .lt-loyalty-hero__bg-img--desktop {
        display: none;
      }
      #shopify-section-{{ section.id }} .lt-loyalty-hero__bg-img--mobile {
        display: block;
        object-position: {{ section.settings.mobile_bg_position }};
      }
    {%- endif -%}
    #shopify-section-{{ section.id }} .lt-loyalty-hero__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__content {
      order: 1;
      padding: 24px 0 0;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__media {
      order: 2;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__heading {
      font-size: 40px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__description {
      font-size: 16px;
      margin-left: auto;
      margin-right: auto;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__stats {
      padding: 16px 20px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__stat {
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__actions {
      justify-content: center;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-hero__heading {
      font-size: 32px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__stats {
      width: 100%;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__stat-value {
      font-size: 22px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-hero__button {
      padding: 16px 32px;
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Loyalty Hero",
  "tag": "section",
  "class": "lt-loyalty-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (stat)",
      "default": "#FAC512"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "select",
      "id": "mobile_bg_position",
      "label": "Mobile background focal point",
      "info": "Which part of the mobile image stays visible.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Muzzle Sleep Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Muzzle Sleep Loyalty Program"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Earn points every time you shop, leave a verified review, refer a friend, or celebrate your birthday. Every 100 points = $1 in rewards — the more you shop, the faster you earn.</p>"
    },
    {
      "type": "header",
      "content": "Stats"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "100 pts"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "= $1 in rewards"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "3–4 pts"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "per $1 spent"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 value",
      "default": "3 tiers"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 label",
      "default": "of VIP perks"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1a1440"
    },
    {
      "type": "text",
      "id": "signin_text",
      "label": "Sign in prompt text",
      "default": "Already have an account?"
    },
    {
      "type": "text",
      "id": "signin_label",
      "label": "Sign in link label",
      "default": "Sign In"
    },
    {
      "type": "url",
      "id": "signin_link",
      "label": "Sign in link"
    },
    {
      "type": "color",
      "id": "signin_link_color",
      "label": "Sign in link color",
      "default": "#C1BBE6"
    },
    {
      "type": "header",
      "content": "Right image"
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "info": "When above 0, overrides the auto-scaled mobile bottom padding. Use to reveal the bottom of the mobile background image.",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "LT Loyalty Hero"
    }
  ]
}
{% endschema %}