{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round
-%}

<div class="lt-loyalty-tiers">
  <div class="page-width">
    <div class="lt-loyalty-tiers__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lt-loyalty-tiers__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lt-loyalty-tiers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lt-loyalty-tiers__grid" style="--lt-cols: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- assign is_hl = block.settings.highlight -%}
          <div
            class="lt-loyalty-tiers__card{% if is_hl %} lt-loyalty-tiers__card--highlight{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if is_hl and block.settings.ribbon != blank -%}
              <span class="lt-loyalty-tiers__ribbon">{{ block.settings.ribbon }}</span>
            {%- endif -%}

            {%- if block.settings.level != blank -%}
              <span class="lt-loyalty-tiers__level">{{ block.settings.level }}</span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="lt-loyalty-tiers__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.pill_1 != blank or block.settings.pill_2 != blank -%}
              <div class="lt-loyalty-tiers__pills">
                {%- if block.settings.pill_1 != blank -%}
                  <span class="lt-loyalty-tiers__pill">{{ block.settings.pill_1 }}</span>
                {%- endif -%}
                {%- if block.settings.pill_2 != blank -%}
                  <span class="lt-loyalty-tiers__pill">{{ block.settings.pill_2 }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="lt-loyalty-tiers__desc">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.benefits != blank -%}
              <div class="lt-loyalty-tiers__divider"></div>

              {%- if block.settings.benefits_intro != blank -%}
                <p class="lt-loyalty-tiers__benefits-intro">{{ block.settings.benefits_intro }}</p>
              {%- endif -%}

              <ul class="lt-loyalty-tiers__benefits" role="list">
                {%- assign benefit_lines = block.settings.benefits | newline_to_br | split: '<br />' -%}
                {%- for line in benefit_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}
                    <li class="lt-loyalty-tiers__benefit">
                      <svg class="lt-loyalty-tiers__check" viewBox="0 0 20 20" width="16" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>{{ trimmed }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if is_hl and block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="lt-loyalty-tiers__button">
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__head {
    text-align: center;
    margin-bottom: 56px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__eyebrow {
    display: inline-block;
    padding: 7px 16px;
    margin-bottom: 20px;
    border-radius: 100px;
    background-color: {{ section.settings.eyebrow_bg_color }};
    color: {{ section.settings.eyebrow_text_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__heading {
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols), minmax(0, 1fr));
    align-items: start;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 40px 32px;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 20px;
    background-color: {{ section.settings.card_bg_color }};
    color: {{ section.settings.card_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card--highlight {
    background-color: {{ section.settings.hl_bg_color }};
    border-color: {{ section.settings.hl_bg_color }};
    color: {{ section.settings.hl_text_color }};
    box-shadow: 0 30px 60px rgba(31, 27, 77, 0.25);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__ribbon {
    position: absolute;
    top: 0;
    right: 24px;
    padding: 6px 14px;
    border-radius: 0 0 8px 8px;
    background-color: {{ section.settings.accent_color }};
    color: {{ section.settings.hl_bg_color }};
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__level {
    display: inline-block;
    align-self: flex-start;
    padding: 5px 14px;
    margin-bottom: 20px;
    border-radius: 100px;
    background-color: {{ section.settings.level_bg_color }};
    color: {{ section.settings.level_text_color }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card--highlight .lt-loyalty-tiers__level {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__title {
    margin: 0 0 16px;
    font-size: 26px;
    line-height: 1.1;
    font-weight: 800;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 100px;
    background-color: {{ section.settings.pill_bg_color }};
    color: {{ section.settings.pill_text_color }};
    font-size: 14px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card--highlight .lt-loyalty-tiers__pill {
    background-color: rgba(255, 255, 255, 0.12);
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__desc {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__divider {
    height: 1px;
    margin-bottom: 20px;
    background-color: {{ section.settings.card_border_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card--highlight .lt-loyalty-tiers__divider {
    background-color: rgba(255, 255, 255, 0.15);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__benefits-intro {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.4;
    opacity: 0.6;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__benefits {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__benefit {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__check {
    flex: 0 0 auto;
    margin-top: 2px;
    color: {{ section.settings.check_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__card--highlight .lt-loyalty-tiers__check {
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__button {
    display: block;
    margin-top: auto;
    padding: 18px 32px;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-tiers__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-tiers__head {
      margin-bottom: 32px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-tiers__heading {
      font-size: 30px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-tiers__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-tiers__card {
      padding: 32px 24px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-tiers__heading {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Loyalty Tiers",
  "tag": "section",
  "class": "lt-loyalty-tiers-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5FA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (ribbon)",
      "default": "#FAC512"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VIP Tiers"
    },
    {
      "type": "color",
      "id": "eyebrow_bg_color",
      "label": "Eyebrow background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text",
      "default": "#5B4FCF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Muzzle Sleep Club Tiers"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B4D"
    },
    {
      "type": "header",
      "content": "Card (standard)"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border / divider",
      "default": "#EAEAF0"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "level_bg_color",
      "label": "Level pill background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "level_text_color",
      "label": "Level pill text",
      "default": "#5B4FCF"
    },
    {
      "type": "color",
      "id": "pill_bg_color",
      "label": "Info pill background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Info pill text",
      "default": "#5B4FCF"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark color",
      "default": "#5B4FCF"
    },
    {
      "type": "header",
      "content": "Card (highlighted)"
    },
    {
      "type": "color",
      "id": "hl_bg_color",
      "label": "Highlight background",
      "default": "#1B1740"
    },
    {
      "type": "color",
      "id": "hl_text_color",
      "label": "Highlight text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Highlight button"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1F1B4D"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight (dark theme)",
          "default": false
        },
        {
          "type": "text",
          "id": "ribbon",
          "label": "Ribbon label",
          "default": "Top Tier",
          "visible_if": "{{ block.settings.highlight }}"
        },
        {
          "type": "text",
          "id": "level",
          "label": "Level",
          "default": "Level 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sleep Starter"
        },
        {
          "type": "text",
          "id": "pill_1",
          "label": "Pill 1",
          "default": "$0–$149 lifetime spend"
        },
        {
          "type": "text",
          "id": "pill_2",
          "label": "Pill 2",
          "default": "3 pts per $1"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Start your journey to better sleep and begin earning rewards right away."
        },
        {
          "type": "text",
          "id": "benefits_intro",
          "label": "Benefits intro (optional)",
          "info": "e.g. \"All Sleep Starter benefits, plus:\""
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "Benefits",
          "info": "One benefit per line.",
          "default": "40 bonus points on signup\nWelcome gift\nEarly access to new product launches\nBirthday reward (240 pts)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Sign Up Now",
          "visible_if": "{{ block.settings.highlight }}"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "visible_if": "{{ block.settings.highlight }}"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "LT Loyalty Tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "level": "Level 1",
            "title": "Sleep Starter",
            "pill_1": "$0–$149 lifetime spend",
            "pill_2": "3 pts per $1",
            "description": "Start your journey to better sleep and begin earning rewards right away.",
            "benefits": "40 bonus points on signup\nWelcome gift\nEarly access to new product launches\nBirthday reward (240 pts)"
          }
        },
        {
          "type": "tier",
          "settings": {
            "level": "Level 2",
            "title": "Restful Regular",
            "pill_1": "$150–$399 lifetime spend",
            "pill_2": "4 pts per $1",
            "description": "You're building a better nightly routine — and your rewards are getting better too.",
            "benefits_intro": "All Sleep Starter benefits, plus:",
            "benefits": "Early sales & limited double-points days\nPriority access to limited-time bundles\nEnhanced birthday reward\nVIP member support"
          }
        },
        {
          "type": "tier",
          "settings": {
            "highlight": true,
            "ribbon": "Top Tier",
            "level": "Level 3",
            "title": "Sleep VIP",
            "pill_1": "$400+ lifetime spend",
            "pill_2": "4 pts per $1",
            "description": "For our most loyal sleepers — our best perks yet.",
            "benefits_intro": "All Restful Regular benefits, plus:",
            "benefits": "Free shipping on all orders\nEarly access to new launches\nPremium birthday reward\nDedicated VIP support",
            "button_label": "Sign Up Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}