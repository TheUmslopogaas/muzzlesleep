{% if product.tags contains 'bf_presale' %}
  <style>
    #shopify-section-{{ section.id }} .option {
      display: none;
    }
    [data-rebuy-id="244246"] {
      display: none !important;
    }
  </style>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  // Initialize thumbnail swiper first
  const thumbsSwiper = new Swiper('.lt-pdp-main-widget .thumbs-swiper', {
    spaceBetween: 10,
    slidesPerView: 5,
    freeMode: true,
    watchSlidesProgress: true,
    breakpoints: {
      320: {
        slidesPerView: 3,
      },
      480: {
        slidesPerView: 4,
      },
      768: {
        slidesPerView: 5,
      },
      900: {
        slidesPerView: 6,
      },
      1200: {
        slidesPerView: 7,
      }
    }
  });
  // Initialize main swiper
  const mainSwiper = new Swiper('.lt-pdp-main-widget .main-swiper', {
    spaceBetween: 10,
    navigation: {
      nextEl: '.lt-pdp-main-widget .gallery-section .swiper-button-next',
      prevEl: '.lt-pdp-main-widget .gallery-section .swiper-button-prev',
    },
    thumbs: {
      swiper: thumbsSwiper,
    },
  });
  // Initialize review swiper
  const reviewSwiper = new Swiper('.lt-pdp-main-widget .review-swiper', {
    slidesPerView: 1,
    spaceBetween: 20,
    navigation: {
      nextEl: '.lt-pdp-main-widget .reviews-section .swiper-button-next',
      prevEl: '.lt-pdp-main-widget .reviews-section .swiper-button-prev',
    },
  });

  // Initialize UGC videos swiper (only runs when the metafield rendered the block)
  (function () {
    const ugcEl = document.querySelector('.lt-pdp-main-widget .lt-ugc-swiper');
    if (!ugcEl) return;

    const ugcSwiper = new Swiper(ugcEl, {
      slidesPerView: 2,
      spaceBetween: 10,
      grabCursor: true,
      watchOverflow: true,
      threshold: 3,
      touchStartForcePreventDefault: true,   // fixes the janky drag
      noSwiping: true,
      noSwipingSelector: 'video',            // lets native controls scrub while playing
      navigation: {
        nextEl: ugcEl.querySelector('.lt-ugc-next'),
        prevEl: ugcEl.querySelector('.lt-ugc-prev'),
      },
      breakpoints: {
        480: { slidesPerView: 2.2, spaceBetween: 12 },
        768: { slidesPerView: 2.5, spaceBetween: 12 }
      }
    });

    const ugcCards = ugcEl.querySelectorAll('.lt-ugc-card');

    function pauseAllExcept(currentCard) {
      ugcCards.forEach(card => {
        if (card === currentCard) return;
        const video = card.querySelector('.lt-ugc-video');
        if (!video) return;
        video.pause();
        video.removeAttribute('controls');
        card.classList.remove('is-playing');
      });
    }

    ugcCards.forEach(card => {
      const video = card.querySelector('.lt-ugc-video');
      const playBtn = card.querySelector('.lt-ugc-play');
      if (!video || !playBtn) return;

      playBtn.addEventListener('click', () => {
        pauseAllExcept(card);
        video.setAttribute('controls', '');
        video.play();
      });

      video.addEventListener('play', () => {
        pauseAllExcept(card);
        card.classList.add('is-playing');
      });

      video.addEventListener('pause', () => {
        card.classList.remove('is-playing');
      });

      video.addEventListener('ended', () => {
        card.classList.remove('is-playing');
        video.removeAttribute('controls');
        video.currentTime = 0;
      });
    });
  })();

  // Handle option selection
  /////////////////////////////////////////////
// Get all option elements and the checkout button
  const options = document.querySelectorAll('.option');
  const checkoutBtn = document.getElementById('checkoutBtn');

  function syncGalleryImage(option) {
    const imageId = option.dataset.imageId;
    if (!imageId) return;
    const slides = document.querySelectorAll('.lt-pdp-main-widget .main-swiper .swiper-slide');
    slides.forEach((slide, index) => {
      if (slide.dataset.imageId === imageId) mainSwiper.slideTo(index);
    });
  }  

  function updateCheckoutState() {
    const selectedOption = document.querySelector('.option.selected');
    if (!selectedOption) return;

    const available = selectedOption.dataset.available === 'true';
    const inventoryPolicy = selectedOption.dataset.inventoryPolicy;
    const inventoryQty = parseInt(selectedOption.dataset.inventoryQuantity || '0', 10);
    const quantity = parseInt(selectedOption.dataset.quantity || '1', 10);

    const enoughStock =
      available &&
      (inventoryPolicy !== 'deny' || inventoryQty >= quantity);

    if (enoughStock) {
      checkoutBtn.classList.remove('disabled');
      checkoutBtn.innerHTML = 'Checkout Now <img src="https://muzzlesleep.com/cdn/shop/t/4/assets/icon-checkout-lock.svg" alt="">';
    } else {
      checkoutBtn.classList.add('disabled');
      checkoutBtn.innerHTML = 'Sold Out';
    }
  }


  // Add a click event listener to each option to handle selection
  options.forEach(option => {
    option.addEventListener('click', () => {
      // Remove 'selected' class from all options
      options.forEach(opt => opt.classList.remove('selected'));
      // Add 'selected' class to the clicked option
      option.classList.add('selected');
      updateCheckoutState();
      syncGalleryImage(option);
    });
  });

  updateCheckoutState();

  // Add a click event listener to the main checkout button
  checkoutBtn.addEventListener('click', () => {
    const selectedOption = document.querySelector('.option.selected');
    if (!selectedOption) {
      alert('Please select a purchase option.');
      return;
    }

    const isSubscription = selectedOption.classList.contains('option-subscirption');
    const variantId = selectedOption.getAttribute('data-variant-id');
    const sellingPlanId = selectedOption.getAttribute('data-selling-plan-id');
    const quantity = parseInt(selectedOption.getAttribute('data-quantity') || 1);

    if (isSubscription) {
      
      const formData = {
        'items': [{
          'id': variantId,
          'quantity': 1,
          'selling_plan': sellingPlanId
        }]
      };

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      })
      .then(response => response.json())
      .then(data => {
        console.log('Product added as subscription:', data);
        openCartDrawer();
      })
      .catch((error) => {
        console.error('Error:', error);
      });
      
    } else {
      // Standard one-time purchase
      const formData = {
        'items': [{
          'id': variantId,
          'quantity': quantity
        }]
      };

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      })
      .then(response => response.json())
      .then(data => {
        console.log('Product added as one-time purchase:', data);
        openCartDrawer();
      })
      .catch((error) => {
        console.error('Error:', error);
      });
    }
  });

  // Function to open the cart drawer
  function openCartDrawer() {
    // Dawn theme has a specific event listener to open the cart drawer.
    document.dispatchEvent(new CustomEvent('cart:open'));
  }

  ////////////////////////////////////////////

  // Handle accordion functionality
  const accordionHeaders = document.querySelectorAll('.accordion-header');  

  accordionHeaders.forEach(header => {
    header.addEventListener('click', () => {
      const accordionItem = header.parentElement;
      const isActive = accordionItem.classList.contains('active');

      // Close all accordion items
      document.querySelectorAll('.accordion-item').forEach(item => {
        item.classList.remove('active');
      });

      // Open clicked item if it wasn't active
      if (!isActive) {
        accordionItem.classList.add('active');
      }
    });
  });
</script>


