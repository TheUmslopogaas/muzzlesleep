<style>
  #lt-trust-badges-{{ section.id }} {
    background: #f4f4fb;
  }
  #lt-trust-badges-{{ section.id }} .lt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 20px;
    text-align: center;
  }
  #lt-trust-badges-{{ section.id }} .lt-heading {
    font-size: 36px;
    font-weight: 700;
    color: #27214D;
    margin: 0 0 35px 0;
    line-height: 1.2;
  }
  #lt-trust-badges-{{ section.id }} .lt-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 40px 64px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #lt-trust-badges-{{ section.id }} .lt-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc(25% - 48px);
    min-width: 220px;
  }
  #lt-trust-badges-{{ section.id }} .lt-figure {
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #lt-trust-badges-{{ section.id }} .lt-icon {
    width: 50px;
    height: 50px;
    object-fit: contain;
    display: block;
    filter: invert(100%);
  }
  #lt-trust-badges-{{ section.id }} .lt-label {
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
    color: #1b1b1b;
    font-weight: 600;
  }

  /* responsive */
  @media (max-width: 1024px) {
    #lt-trust-badges-{{ section.id }} .lt-badge { width: calc(33.333% - 42px); }
    #lt-trust-badges-{{ section.id }} .lt-heading { font-size: 32px;}
  }
  @media (max-width: 760px) {
    #lt-trust-badges-{{ section.id }} .lt-badge { width: calc(50% - 32px); }
    #lt-trust-badges-{{ section.id }} .lt-container { padding: 44px 16px; }
    #lt-trust-badges-{{ section.id }} .lt-heading { font-size: 28px; margin-bottom: 20px; }
  }
  @media (max-width: 460px) {
    #lt-trust-badges-{{ section.id }} .lt-badge { width: 100%; }
  }
</style>
<section class="lt-trust-badges-wrap" id="lt-trust-badges-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lt-container">
    <header class="lt-header">
      <h2 class="lt-heading">
        {{ section.settings.heading }}
      </h2>
    </header>

    <ul class="lt-badges" role="list">
      {% for block in section.blocks %}
        <li class="lt-badge" role="listitem" {{ block.shopify_attributes }}>
          <figure class="lt-figure">
            {% if block.settings.icon != blank %}
              <img class="lt-icon" src="{{ block.settings.icon | img_url: '160x160' }}" alt="{{ block.settings.label | escape }}" width="64" height="64" loading="lazy">
            {% else %}
              <img class="lt-icon" src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=160&h=160&fit=crop" alt="{{ block.settings.label | escape }}" width="64" height="64" loading="lazy">
            {% endif %}
          </figure>
          <p class="lt-label">{{ block.settings.label }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>

</section>

{% schema %}
{
  "name": "LT Trust Badges",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fast Shipping. Highest Quality. 100% Guarantee."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ethically Sourced"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LT Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "label": "Ethically Sourced" } },
        { "type": "badge", "settings": { "label": "Third Party Tested" } },
        { "type": "badge", "settings": { "label": "100% Natural" } },
        { "type": "badge", "settings": { "label": "Trusted By 500,000+" } }
      ]
    }
  ]
}
{% endschema %}
