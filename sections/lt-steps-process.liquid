<style>
  #shopify-section-{{section.id}} {
    background-color: {{ section.settings.background_color }};
    padding: 60px 20px;
  }
  #shopify-section-{{section.id}} .container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{section.id}} .subtitle {
    font-size: 16px;
    color: #0F0F10;
    margin-bottom: 20px;
    font-weight: 600;
    max-width: fit-content;
    line-height: 1;
    padding: 15px 30px;
    background-color: #fff;
    border-radius: 100px;
    margin: 0 auto;
  }
  #shopify-section-{{section.id}} .title {
    font-size: 48px;
    font-weight: 700;
    color: #27214D;
    margin-top: 20px;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  #shopify-section-{{section.id}} .description {
  font-size: 16px;
    font-weight: 600;
    color: #0F0F10;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
    letter-spacing: 0.3px;
  }

  {% assign video_metafield = product.metafields.custom.product_above_the_fold_video %}
  #shopify-section-{{section.id}} .steps-wrapper {
    display: grid;
    {% if video_metafield != blank %}
      grid-template-columns: repeat(2, 1fr);
    {% else %}
      grid-template-columns: 1fr;
    {% endif %}
    grid-template-rows: 1fr;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
    margin-top: 60px;
    margin-bottom: 20px;
  }
  #shopify-section-{{section.id}} .steps {
    display: flex;
    {% if video_metafield != blank %}
      flex-direction: column;
    {% endif %}  
    gap: 20px;
    justify-content: center;
    align-items: flex-start;
    margin-bottom: 40px;
  }
  #shopify-section-{{section.id}} .step {
    flex: 1;
    max-width: 480px;
    width: 100%;
  }


  #shopify-section-{{section.id}} .step-image {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{section.id}} .step-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px;
  }
  #shopify-section-{{section.id}} .step-title {
    font-size: 22px;
    font-weight: 700;
    color: #2c3e50;
    margin: 0 0 10px 0;
  }
  #shopify-section-{{section.id}} .step-description {
    font-size: 15px;
    color: #27214D;
    line-height: 1.5;
    letter-spacing: 0.3px;
  }
  #shopify-section-{{section.id}} .cta-button {
    background-color: #27214D;
    color: white;
    padding: 16px 40px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    display: inline-block;
    line-height: 1;
    letter-spacing: 0;
    transition: background-color 0.3s ease;
  }
  #shopify-section-{{section.id}} .cta-button:hover {
    background-color: #2c3654;
  }
  #shopify-section-{{section.id}} .hwt-video {
    margin: 0 auto;
  }
  #shopify-section-{{section.id}} .hwt-video .pdp-abovethefold-video {
      max-width: 480px;
  }
  #shopify-section-{{section.id}} .hwt-video .pdp-abovethefold-video video {
      width: 100%;
  }
  #shopify-section-{{section.id}} .description-bottom {
    font-size: 20px;
    font-weight: 600;
    color: #2c3654;
  }

  @media (max-width: 768px) {
    #shopify-section-{{section.id}} {
      padding: 40px 15px;
    }
    #shopify-section-{{section.id}} .title {
      font-size: 32px;
    }
    #shopify-section-{{section.id}} .steps-wrapper {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{section.id}} .steps {
      flex-direction: column;
      gap: 40px;
    }
    #shopify-section-{{section.id}} .step {
      max-width: 100%;
    }
    #shopify-section-{{section.id}} .step-image {
      height: 220px;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{section.id}} .container {
      padding: 0;
    }
    #shopify-section-{{section.id}} .title {
      font-size: 30px;
    }
    #shopify-section-{{section.id}} .subtitle {
      font-size: 14px;
      letter-spacing: 0.2px;
    }
    #shopify-section-{{section.id}} .description {
      font-size: 14px;
    }
    #shopify-section-{{section.id}} .step-title {
      font-size: 20px;
    }
    #shopify-section-{{section.id}} .step-description {
      font-size: 14px;
    }
    #shopify-section-{{section.id}} .cta-button {
      font-size: 14px;
    }
  }
</style>

<div class="container">
  {% if section.settings.subtitle != blank %}
    <div class="subtitle">{{ section.settings.subtitle }}</div>
  {% endif %}
  
  {% if section.settings.title != blank %}
    <h2 class="title">{{ section.settings.title }}</h2>
  {% endif %}
  
  {% if section.settings.description != blank %}
    <div class="description">{{ section.settings.description }}</div>
  {% endif %}
  <div class="steps-wrapper">
    <div class="steps">
      {% for block in section.blocks %}
        <div class="step">
          {% if block.settings.image != blank %}
            <div class="step-image">
              <img src="{{ block.settings.image | img_url: '400x400' }}" alt="{{ block.settings.title }}">
            </div>
          {% else %}
            <div class="step-image"></div>
          {% endif %}
          
          {% if block.settings.title != blank %}
            <h3 class="step-title">{{ block.settings.title }}</h3>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <div class="step-description">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% assign video_metafield = product.metafields.custom.product_above_the_fold_video %}
    {% if video_metafield != blank %}
    <div class="hwt-video">
        <div class="pdp-abovethefold-video">
          <video controls loading="lazy" poster="https://cdn.shopify.com/s/files/1/0886/5542/9998/files/IMG_2676.jpg?v=1761017736">
            <source src="{{ video_metafield | file_url }}" type="{{ video_metafield.mime_type }}">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
    {% endif %}
  </div>
  
  {% if section.settings.cta_text != blank %}
    <a href="{{ section.settings.cta_url | default: '#' }}" class="cta-button">
      {{ section.settings.cta_text }}
    </a>
  {% endif %}
  {% if section.settings.description_bottom != blank %}
    <div class="description-bottom">{{ section.settings.description_bottom }}</div>
  {% endif %}  
</div>

{% schema %}
{
  "name": "LT Steps Process Section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Transform Your Sleep in 3 Simple Steps"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "How Muzzle Sleep Strips Work"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sleep shouldn't be complicated. Our gentle strips encourage nasal breathing, which is quieter, more efficient, and delivers better oxygen flow to your body."
    },
    {
      "type": "textarea",
      "id": "description_bottom",
      "label": "Description Bottom"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Ready To Experience The Difference?"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Steps Process Section",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Step 1: Prepare",
            "description": "Start with clean, dry skin around your lips for best adhesion."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Step 2: Apply",
            "description": "Peel and place horizontally across the center of your lips. The hypoallergenic adhesive provides secure but comfortable hold."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Step 3: Sleep Peacefully",
            "description": "Your mouth stays gently closed, naturally directing airflow through your nose. This reduces snoring by up to 90% for most users."
          }
        }
      ]
    }
  ]
}
{% endschema %}