{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign pt_mob = pt | times: 0.6 | round
  assign pb_mob = pb | times: 0.6 | round
  assign mt_mob = mt | times: 0.6 | round
  assign mb_mob = mb | times: 0.6 | round
-%}

<div class="lt-cta">
  <div class="page-width">
    <div class="lt-cta__card">

      {%- if section.settings.heading != blank -%}
        <h2 class="lt-cta__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="lt-cta__grid">
        <div class="lt-cta__left">

          {%- if section.blocks.size > 0 -%}
            <ul class="lt-cta__bullets" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'bullet' and block.settings.text != blank -%}
                  <li class="lt-cta__bullet" {{ block.shopify_attributes }}>
                    <span class="lt-cta__dot" aria-hidden="true"></span>
                    {{ block.settings.text }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.callout_text != blank -%}
            <div class="lt-cta__callout">{{ section.settings.callout_text }}</div>
          {%- endif -%}

          {%- if section.settings.button_text != blank -%}
            <a
              class="lt-cta__button"
              {% if section.settings.button_url != blank %}href="{{ section.settings.button_url }}"{% else %}href="#" role="link" aria-disabled="true"{% endif %}
            >
              {{ section.settings.button_text }}
            </a>
          {%- endif -%}

        </div>

        {%- if section.settings.image != blank -%}
          <div class="lt-cta__media">
            <img
              class="lt-cta__img"
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.image | image_url: width: 500 }} 500w,
                {{ section.settings.image | image_url: width: 800 }} 800w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 767px) 100vw, 600px"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | default: 'Mother helping child with a nighttime routine' | escape }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }

  #shopify-section-{{ section.id }} .lt-cta__card {
    background-color: {{ section.settings.card_bg_color }};
    color: {{ section.settings.text_color }};
    border-radius: 28px;
    padding: 56px;
  }

  #shopify-section-{{ section.id }} .lt-cta__heading {
    margin: 0 0 40px;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .lt-cta__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Bullets ── */
  #shopify-section-{{ section.id }} .lt-cta__bullets {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .lt-cta__bullet {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 19px;
    line-height: 1.4;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .lt-cta__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ section.settings.bullet_color }};
  }

  /* ── Callout ── */
  #shopify-section-{{ section.id }} .lt-cta__callout {
    margin: 0 0 24px;
    padding: 20px 24px;
    background-color: {{ section.settings.callout_bg_color }};
    border-radius: 14px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: inherit;
  }

  /* ── Button ── */
  #shopify-section-{{ section.id }} .lt-cta__button {
    display: block;
    width: 100%;
    padding: 19px 32px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border-radius: 999px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }
  #shopify-section-{{ section.id }} .lt-cta__button:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* ── Media ── */
  #shopify-section-{{ section.id }} .lt-cta__media {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  #shopify-section-{{ section.id }} .lt-cta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  /* ── Responsive 767px ── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_mob }}px;
      padding-bottom: {{ pb_mob }}px;
      margin-top: {{ mt_mob }}px;
      margin-bottom: {{ mb_mob }}px;
    }
    #shopify-section-{{ section.id }} .lt-cta__card {
      padding: 32px 24px;
      border-radius: 20px;
    }
    #shopify-section-{{ section.id }} .lt-cta__heading {
      font-size: 30px;
      margin-bottom: 28px;
    }
    #shopify-section-{{ section.id }} .lt-cta__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .lt-cta__bullet {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .lt-cta__callout {
      font-size: 15px;
      padding: 16px 20px;
    }
    #shopify-section-{{ section.id }} .lt-cta__media {
      aspect-ratio: 4 / 3;
    }
  }

  /* ── Responsive 480px ── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-cta__heading {
      font-size: 25px;
    }
    #shopify-section-{{ section.id }} .lt-cta__bullet {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Affiliate Bedtime CTA",
  "class": "lt-section-affiliate-bedtime-cta",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#241C4E"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet dot color",
      "default": "#4FC3F7"
    },
    {
      "type": "color",
      "id": "callout_bg_color",
      "label": "Callout background",
      "default": "rgba(255,255,255,0.08)"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1A1442"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make Better Breathing Part of Bedtime"
    },
    {
      "type": "header",
      "content": "Callout"
    },
    {
      "type": "text",
      "id": "callout_text",
      "label": "Callout text",
      "default": "Maybe it's time to think about how they're breathing, too."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Muzzle"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "https://muzzlesleep.com/"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New bullet point"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LT Affiliate Bedtime CTA",
      "category": "LT Sections",
      "settings": {
        "bg_color": "#F5F3FC",
        "text_color": "#ffffff"
      },
      "blocks": [
        { "type": "bullet", "settings": { "text": "You already think about their bedtime." } },
        { "type": "bullet", "settings": { "text": "Their mattress." } },
        { "type": "bullet", "settings": { "text": "Their room temperature." } },
        { "type": "bullet", "settings": { "text": "Their screen time." } },
        { "type": "bullet", "settings": { "text": "Their nighttime routine." } }
      ]
    }
  ]
}
{% endschema %}
