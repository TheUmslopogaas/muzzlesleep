{%- liquid
  assign pt_desk = section.settings.padding_top
  assign pb_desk = section.settings.padding_bottom
  assign mt_desk = section.settings.margin_top
  assign mb_desk = section.settings.margin_bottom
  assign pt_mob  = pt_desk | times: 0.6 | round
  assign pb_mob  = pb_desk | times: 0.6 | round
  assign mt_mob  = mt_desk | times: 0.6 | round
  assign mb_mob  = mb_desk | times: 0.6 | round

  assign block_style = section.settings.block_style
-%}

<div
  class="lt-split-content"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt_desk }}px;
    padding-bottom: {{ pb_desk }}px;
    margin-top: {{ mt_desk }}px;
    margin-bottom: {{ mb_desk }}px;
  "
>
  <div class="page-width">

    {%- comment -%} ── Section header ── {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="lt-split-content__header">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="lt-split-content__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.intro != blank and block_style == 'text_blocks' -%}
          <div class="lt-split-content__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Two-column body ── {%- endcomment -%}
    <div class="lt-split-content__body lt-split-content__body--{{ section.settings.image_position }}">

      {%- comment -%} ── Image column ── {%- endcomment -%}
      <div class="lt-split-content__image-col">
        <div class="lt-split-content__image-wrap{% if section.settings.image_card %} lt-split-content__image-wrap--card{% endif %}">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url }}"
              alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              class="lt-split-content__image"
            >
          {%- else -%}
            <div class="lt-split-content__image-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'lt-split-content__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ── Content column ── {%- endcomment -%}
      <div class="lt-split-content__content-col">

        {%- if block_style == 'text_blocks' -%}

          {%- comment -%} ── Text blocks mode ── {%- endcomment -%}
          <div class="lt-split-content__text-blocks">
            {%- for block in section.blocks -%}
              {%- if block.type == 'text_block' -%}
                <div class="lt-split-content__text-block" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}
                    <p class="lt-split-content__text-label">{{ block.settings.label }}</p>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="lt-split-content__text-content">{{ block.settings.content }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- elsif block_style == 'feature_list' -%}

          {%- comment -%} ── Feature list mode ── {%- endcomment -%}
          <div class="lt-split-content__features{% if section.settings.show_connector %} lt-split-content__features--connector{% endif %}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div class="lt-split-content__feature" {{ block.shopify_attributes }}>
                  <div class="lt-split-content__feature-dot" style="background-color: {{ section.settings.dot_color }};"></div>
                  <div class="lt-split-content__feature-body">
                    {%- if block.settings.title != blank -%}
                      <p class="lt-split-content__feature-title">{{ block.settings.title }}</p>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="lt-split-content__feature-desc">{{ block.settings.description }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lt-split-content {
    position: relative;
  }

  /* ─────────────────────────────────────
     Header
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__header {
    text-align: center;
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto {{ section.settings.header_gap }}px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-split-content__intro {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0;
    color: {{ section.settings.text_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-split-content__intro p {
    margin: 0;
  }

  /* ─────────────────────────────────────
     Body layout
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__body {
    display: flex;
    align-items: center;
    gap: {{ section.settings.column_gap }}px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__body--right {
    flex-direction: row;
  }
  #shopify-section-{{ section.id }} .lt-split-content__body--left {
    flex-direction: row-reverse;
  }

  /* ─────────────────────────────────────
     Image column
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__image-col {
    flex: 0 0 {{ section.settings.image_col_width }}%;
    max-width: {{ section.settings.image_col_width }}%;
  }

  /* Plain image wrapper */
  #shopify-section-{{ section.id }} .lt-split-content__image-wrap {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    line-height: 0;
  }

  /* Card-style image wrapper */
  #shopify-section-{{ section.id }} .lt-split-content__image-wrap--card {
    border: 1.5px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    padding: {{ section.settings.card_padding }}px;
    background-color: {{ section.settings.card_bg_color }};
  }
  #shopify-section-{{ section.id }} .lt-split-content__image-wrap--card .lt-split-content__image {
    border-radius: {{ section.settings.image_radius | minus: 4 }}px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .lt-split-content__image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: rgba(0,0,0,0.05);
  }
  #shopify-section-{{ section.id }} .lt-split-content__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ─────────────────────────────────────
     Content column
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__content-col {
    flex: 1 1 0%;
    min-width: 0;
  }

  /* ─────────────────────────────────────
     TEXT BLOCKS mode
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__text-blocks {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-label {
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-content {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-content strong {
    display: block;
    font-weight: 800;
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-content p {
    margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .lt-split-content__text-content p:last-child {
    margin-bottom: 0;
  }

  /* ─────────────────────────────────────
     FEATURE LIST mode
  ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-split-content__features {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  #shopify-section-{{ section.id }} .lt-split-content__feature {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 0 0 32px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .lt-split-content__features .lt-split-content__feature:last-child {
    padding-bottom: 0;
  }

  /* Dot bullet */
  #shopify-section-{{ section.id }} .lt-split-content__feature-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 4px;
    position: relative;
    z-index: 1;
    display: block;
  }

  /* Dashed vertical connector line */
  #shopify-section-{{ section.id }} .lt-split-content__features--connector .lt-split-content__feature:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 20px;
    bottom: 0;
    width: 1px;
    border-left: 1.5px dashed {{ section.settings.connector_color }};
  }

  /* Feature body */
  #shopify-section-{{ section.id }} .lt-split-content__feature-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .lt-split-content__feature-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.feature_title_color }};
    margin: 0;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .lt-split-content__feature-desc {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  /* ─────────────────────────────────────
     Tablet
  ───────────────────────────────────── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .lt-split-content {
      padding-top: {{ pt_mob }}px !important;
      padding-bottom: {{ pb_mob }}px !important;
      margin-top: {{ mt_mob }}px !important;
      margin-bottom: {{ mb_mob }}px !important;
    }
    #shopify-section-{{ section.id }} .lt-split-content__header {
      margin-bottom: 36px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__heading {
      font-size: {{ section.settings.heading_size | times: 0.8 | round }}px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__body,
    #shopify-section-{{ section.id }} .lt-split-content__body--left {
      flex-direction: column;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__image-col {
      flex: unset;
      max-width: 100%;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .lt-split-content__content-col {
      width: 100%;
    }
  }

  /* ─────────────────────────────────────
     Mobile
  ───────────────────────────────────── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-split-content__feature-body {
      gap: 5px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__heading {
      font-size: {{ section.settings.heading_size | times: 0.75 | round }}px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__intro,
    #shopify-section-{{ section.id }} .lt-split-content__text-label,
    #shopify-section-{{ section.id }} .lt-split-content__text-content {
      font-size: 15px;
    }
    #shopify-section-{{ section.id }} .lt-split-content__feature-title {
      line-height: 1.3;
    }
    #shopify-section-{{ section.id }} .lt-split-content__feature-desc {
      font-size: 15px;
      letter-spacing: 0;
      line-height: 1.6;
    }
  }
</style>

{% schema %}
{
  "name": "Image Txt - Split Content",
  "tag": "div",
  "class": "shopify-section--split-content",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1d3b"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Makes This Different"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Only shown in Text Blocks mode.",
      "default": "<p>Your body is wired to relax under gentle pressure.</p>"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 760,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Space below header",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "block_style",
      "label": "Content style",
      "info": "Text Blocks — free paragraphs (How It Works). Feature List — dot bullets with titles (What Makes This Different).",
      "options": [
        { "value": "text_blocks", "label": "Text Blocks" },
        { "value": "feature_list", "label": "Feature List" }
      ],
      "default": "feature_list"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_col_width",
      "label": "Image column width",
      "min": 30,
      "max": 65,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "image_card",
      "label": "Show image card frame",
      "info": "Wraps the image in a bordered card — matches the 'What Makes This Different' style.",
      "default": true
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#d8d9e8",
      "visible_if": "{{ section.settings.image_card == true }}"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#f5f5fa",
      "visible_if": "{{ section.settings.image_card == true }}"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px",
      "visible_if": "{{ section.settings.image_card == true }}"
    },
    {
      "type": "header",
      "content": "Feature List settings",
      "visible_if": "{{ section.settings.block_style == 'feature_list' }}"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature title color",
      "default": "#1a1d3b",
      "visible_if": "{{ section.settings.block_style == 'feature_list' }}"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#1a1d3b",
      "visible_if": "{{ section.settings.block_style == 'feature_list' }}"
    },
    {
      "type": "checkbox",
      "id": "show_connector",
      "label": "Show dashed connector line",
      "default": true,
      "visible_if": "{{ section.settings.block_style == 'feature_list' }}"
    },
    {
      "type": "color",
      "id": "connector_color",
      "label": "Connector line color",
      "default": "#cccccc",
      "visible_if": "{{ section.settings.show_connector == true }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Bold label",
          "info": "Optional. Displays as a bold intro line.",
          "default": "Think of it like this:"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>That feeling when you're finally able to exhale at the end of the day…</p><p>…but across your entire body.</p>"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Even Weight Distribution (No Bunching. No Adjusting.)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Designed with a structured knit construction that evenly distributes weight across your body so you feel consistent pressure — not clumps or shifting."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Image Txt - Split Content",
      "settings": {
        "heading": "What Makes This Different",
        "block_style": "feature_list",
        "image_position": "left",
        "image_card": true,
        "show_connector": true
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Even Weight Distribution (No Bunching. No Adjusting.)",
            "description": "Designed with a structured knit construction that evenly distributes weight across your body so you feel consistent pressure — not clumps or shifting."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Soft, Breathable Comfort",
            "description": "Made with premium fabric that stays cool and comfortable while still delivering that cozy, wrapped feeling."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Heavy… In the Best Way",
            "description": "Engineered to provide that \"just right\" weight that helps your body fully relax without feeling trapped or restricted."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Minimal. Clean. Elevated.",
            "description": "Designed to look as good as it feels — no bulky inserts, no medical look, just clean, modern comfort."
          }
        }
      ]
    },
    {
      "name": "Split Content — Text Blocks",
      "settings": {
        "heading": "How Muzzle Gravity Works",
        "block_style": "text_blocks",
        "image_position": "right",
        "image_card": false,
        "show_connector": false
      },
      "blocks": [
        {
          "type": "text_block",
          "settings": {
            "label": "Think of it like this:",
            "content": "<p>That feeling when you're finally able to exhale at the end of the day…</p><p>…but across your entire body.</p>"
          }
        },
        {
          "type": "text_block",
          "settings": {
            "label": "",
            "content": "<p>Weighted blankets have been shown to help reduce stress, improve sleep quality, and support relaxation by mimicking a calming, secure sensation.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
