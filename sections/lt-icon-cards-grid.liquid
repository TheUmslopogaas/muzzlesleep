{%- liquid
  assign pt     = section.settings.padding_top
  assign pb     = section.settings.padding_bottom
  assign mt     = section.settings.margin_top
  assign mb     = section.settings.margin_bottom
  assign pt_mob = pt | times: 0.6 | round
  assign pb_mob = pb | times: 0.6 | round
  assign mt_mob = mt | times: 0.6 | round
  assign mb_mob = mb | times: 0.6 | round
-%}

<div
  class="lt-icon-cards"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  "
>
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="lt-icon-cards__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="lt-icon-cards__subtext" style="color: {{ section.settings.text_color }};">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    <div class="lt-icon-cards__grid" style="--lt-cols: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div
            class="lt-icon-cards__card"
            {{ block.shopify_attributes }}
            style="
              background-color: {{ section.settings.card_bg }};
              border-color: {{ section.settings.card_border_color }};
              border-radius: {{ section.settings.card_radius }}px;
            "
          >

            {%- comment -%} Icon — image takes priority, then SVG picker {%- endcomment -%}
            <div class="lt-icon-cards__icon" aria-hidden="true" style="color: {{ section.settings.icon_color }};">
              {%- if block.settings.icon_image != blank -%}
                <img
                  src="{{ block.settings.icon_image | img_url: 'master' }}"
                  alt=""
                  class="lt-icon-cards__icon-img"
                  width="36"
                  height="36"
                  loading="lazy"
                >
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'people' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="14" cy="12" r="4.5" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M5 28c0-5 4-8 9-8s9 3 9 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      <circle cx="25" cy="12" r="3.5" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M29 28c0-4-2.5-6.5-5.5-7.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  {%- when 'moon' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22 7.5A10.5 10.5 0 1 1 7.5 22 8 8 0 0 0 22 7.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'home' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 17L18 6l12 11v14H23v-8h-6v8H6V17z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"/>
                    </svg>
                  {%- when 'plane' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M29.5 6.5L6 17l8 3 3 9 5-7 7.5 3.5L29.5 6.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"/>
                    </svg>
                  {%- when 'people-2' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="14" cy="12" r="4.5" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M5 28c0-5 4-8 9-8s9 3 9 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      <circle cx="25" cy="12" r="3.5" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M29 28c0-4-2.5-6.5-5.5-7.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  {%- when 'clock' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="18" cy="18" r="12" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M18 11v7l4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'headphones' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8 22v-4a10 10 0 0 1 20 0v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      <rect x="5" y="22" width="5" height="7" rx="2" stroke="currentColor" stroke-width="1.75"/>
                      <rect x="26" y="22" width="5" height="7" rx="2" stroke="currentColor" stroke-width="1.75"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18 5l3.9 7.9 8.7 1.3-6.3 6.1 1.5 8.7L18 25l-7.8 4.1 1.5-8.7-6.3-6.1 8.7-1.3L18 5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'sun' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18 25a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M18 3v4 M18 29v4 M3 18h4 M29 18h4 M7.4 7.4l2.8 2.8 M25.8 25.8l2.8 2.8 M7.4 28.6l2.8-2.8 M25.8 10.2l2.8-2.8" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                    </svg>
                  {%- when 'dumbbell' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 18h16 M6 11h4v14H6z M26 11h4v14h-4z M3 14h3v8H3z M30 14h3v8h-3z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                    </svg>
                  {%- when 'lightning' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M19.5 3L6 21h10.5L15 33 30 13.5H18L19.5 3z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                    </svg>
                  {%- when 'breath' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14 12h11.5a4.5 4.5 0 0 0 0-9 4.5 4.5 0 0 0-4.5 4.5 M6 18h18.5a6 6 0 0 1 0 12 6 6 0 0 1-6-6 M10 24h6.5a3 3 0 0 0 0-6 3 3 0 0 0-3 3" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                    </svg>
                  {%- when 'leaf' -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M28 8C28 8 20 8 14 14S8 28 8 28c4-1 8-3 12-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M8 28L18 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="18" cy="18" r="12" stroke="currentColor" stroke-width="1.75"/>
                      <path d="M18 14v5m0 3v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <h3 class="lt-icon-cards__card-heading" style="color: {{ section.settings.card_heading_color }};">
                {{ block.settings.heading }}
              </h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="lt-icon-cards__card-text" style="color: {{ section.settings.text_color }};">
                {{ block.settings.text }}
              </p>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lt-icon-cards__heading {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
    text-align: {{ section.settings.header_align }};
    margin: 0 0 12px;
    letter-spacing: -0.3px;
  }
  #shopify-section-{{ section.id }} .lt-icon-cards__subtext {
    font-size: 16px;
    line-height: 1.6;
    text-align: {{ section.settings.header_align }};
    margin: 0 0 40px;
    opacity: 0.75;
  }

  /* ── Grid ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-icon-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols, 3), 1fr);
    gap: {{ section.settings.gap }}px;
  }

  /* ── Card ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-icon-cards__card {
    border: 1px solid;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-icon-cards__card:hover {
    box-shadow: 0 6px 24px rgba(30, 27, 75, 0.08);
    transform: translateY(-2px);
  }

  /* ── Icon ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-icon-cards__icon {
    display: flex;
    align-items: center;
    width: 36px;
    height: 36px;
  }
  #shopify-section-{{ section.id }} .lt-icon-cards__icon-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    display: block;
  }

  /* ── Text ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .lt-icon-cards__card-heading {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-icon-cards__card-text {
    font-size: 16px;
    line-height: 1.4;
    margin: 0;
    letter-spacing: 0;
  }

  /* ── Responsive 767px ───────────────────────── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .lt-icon-cards {
      padding-top: {{ pt_mob }}px !important;
      padding-bottom: {{ pb_mob }}px !important;
      margin-top: {{ mt_mob }}px !important;
      margin-bottom: {{ mb_mob }}px !important;
    }
    #shopify-section-{{ section.id }} .lt-icon-cards__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.gap | times: 0.7 | round }}px;
    }
    #shopify-section-{{ section.id }} .lt-icon-cards__heading {
      font-size: 28px;
    }
  }

  /* ── Responsive 480px ───────────────────────── */
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-icon-cards__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .lt-icon-cards__heading {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "LT Icon Cards Grid",
  "class": "lt-section-icon-cards",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7f7f9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Section heading color",
      "default": "#1e1b4b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#2d2d3a"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e4e4ec"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "default": "#1e1b4b"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1e1b4b"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Section subtext"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding (px)",
      "min": 16,
      "max": 48,
      "step": 4,
      "default": 28
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Icon Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "people",   "label": "People / Partners" },
            { "value": "moon",     "label": "Moon / Sleep"      },
            { "value": "home",     "label": "Home"              },
            { "value": "plane",    "label": "Plane / Travel"    },
            { "value": "people-2", "label": "Group / Dorm"      },
            { "value": "clock",    "label": "Clock / Shift"     },
            { "value": "headphones","label": "Headphones"       },
            { "value": "star",      "label": "Star"             },
            { "value": "sun",       "label": "Sun"              },
            { "value": "dumbbell",  "label": "Dumbbell"         },
            { "value": "lightning", "label": "Lightning"        },
            { "value": "breath", "label": "Breath"              },
            { "value": "leaf",     "label": "Leaf / Eco"        }
          ],
          "default": "people"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Overrides the icon picker above when set"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "default": "Snoring partners"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Card description",
          "default": "Get restful sleep even when sharing a bed"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "LT Icon Cards Grid",
      "category": "LT Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "people",
            "heading": "Snoring partners",
            "text": "Get restful sleep even when sharing a bed"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "moon",
            "heading": "Light sleepers",
            "text": "Block out disruptive sounds that wake you"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "home",
            "heading": "Apartment or city noise",
            "text": "Escape traffic, sirens, and street sounds"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "plane",
            "heading": "Travel & flights",
            "text": "Sleep soundly on planes, trains, and hotels"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "people-2",
            "heading": "Dorm rooms",
            "text": "Study and sleep peacefully in shared spaces"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "clock",
            "heading": "Shift workers",
            "text": "Sleep during the day without disruption"
          }
        }
      ]
    }
  ]
}
{% endschema %}
