{%- assign _ss = section.settings -%}
{%- assign _section = section.id | split: '__' | last | slice: -4, 4 | prepend: '#sn_' -%}
{%- assign _this = section.id | prepend: '#shopify-section-' -%}

{%- capture section_content -%}
<style>
    {{ _section }} {
        position: relative;
        background: {{ _ss.background }};
        padding-top: {{ _ss.padding_top }}px;
        padding-bottom: {{ _ss.padding_bottom }}px;
    }

    {{ _section }} .section_holder {
        position: relative;
        max-width: {{ _ss.max_with }}px;
        margin: auto;
        padding: 0px 40px;
    }

    {{ _section }} .section_header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    {{ _section }} .section_title__text {
        color: #26214E;
        font-family: Manrope;
        font-size: 30px;
        font-style: normal;
        font-weight: 600;
        line-height: 120%;
        letter-spacing: -0.6px;
    }

    {{ _section }} .section_title__text span {
        color: #9487DF;
    }

    {{ _section }} .main_button {
        min-width: 236px;
        padding: 0 40px;
        display: flex;
        height: 50px;
        color: #FFF;
        text-align: center;
        font-family: Manrope;
        font-size: 16px;
        font-style: normal;
        font-weight: 700;
        line-height: 100%; /* 16px */
        letter-spacing: -0.32px;
        text-transform: capitalize;
        border-radius: 30px;
        background: #27214D;
        box-shadow: -21px 16px 10px 0px rgba(153, 145, 189, 0.04), -12px 9px 9px 0px rgba(153, 145, 189, 0.13), -5px 4px 6px 0px rgba(153, 145, 189, 0.23), -1px 1px 4px 0px rgba(153, 145, 189, 0.25);
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    {{ _section }} .main_button_arrow {
        width: 16px;
        height: 16px;
        margin-left: 10px;
    }

    {{ _section }} .section_blocks {
        display: grid;
        grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
        gap: 16px;
    }

    {{ _section }} .block__imageWrapper {
        position: relative;
        width: 100%;
        height: 0;
        padding-bottom: 84%;
        border-radius: 12px;
        overflow: hidden;
        background: #F7F5FF;
    }

    {{ _section }} .block__imageWrapper img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
    }

    {{ _section }} .block__text {
        display: flex;
        align-items: center;
        margin-top: 7px;
    }

    {{ _section }} .block__number {
        width: 28px;
        min-width: 28px;
        height: 28px;
        min-height: 28px;
        border-radius: 99px;
        border: 1.25px solid rgba(38,33,78,0.1);
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #26214E;
        font-family: Manrope;
        font-size: 15px;
        font-style: normal;
        font-weight: 600;
        line-height: 120%; /* 18px */
        letter-spacing: -0.3px;
        text-transform: capitalize;
        margin-right: 12px;
    }

    {{ _section }} .block__title {}

    {{ _section }} .block__title {
        color: #26214E;
        font-family: Manrope;
        font-size: 16px;
        font-style: normal;
        font-weight: 500;
        line-height: 120%; /* 19.2px */
        letter-spacing: -0.32px;
    }

    {{ _section }} .section_block {
    }

    {{ _section }} .section_body {
        margin-top: 37px;
    }

    @media screen and (max-width: 900px) {
        {{ _section }} {
            padding-top: {{ _ss.padding_top_mobile }}px;
            padding-bottom: {{ _ss.padding_bottom_mobile }}px;
        }
        
        {{ _section }} .section_holder {
            padding: 0px 0px;
        }

        {{ _section }} .section_title {
            padding: 0 24px;
        }

        {{ _section }} .section_title__text {
            font-size: 24px;
            max-width: 179px;
        }

        {{ _section }} .section_body {
            margin-top: 5px;
        }

        {{ _section }} .section_content {
            overflow: auto;
            padding: 16px 0;
        }

        {{ _section }} .section_blocks {
            gap: 8px;
            padding: 0 24px;
            width: max-content;
        }

        {{ _section }} .section_block {
            width: 218px;
        }

        {{ _section }} .block__imageWrapper {
            padding-bottom: 116%;
        }

        {{ _section }} .block__number {
            width: 22px;
            min-width: 22px;
            height: 22px;
            min-height: 22px;
        }

        {{ _section }} .section_main_button {
            margin-top: 16px;
        }

        {{ _section }} .main_button {
            width: fit-content;
            margin: auto;
        }

        {{ _section }} .for_desktop {
            display: none !important;
        }
    }

    @media screen and (min-width: 901px) {
        {{ _section }} .for_mobile {
            display: none !important;
        }
    }
    

</style>


<div landing-guide id="sn_{{ section.id | split: '__' | last | slice: -4, 4 }}">
    <div class="section_holder">
        <div class="section_header">
            <div class="section_title">
                <div class="section_title__text">{{ _ss.title | replace: "[ count ]", section.blocks.size }}</div>
            </div>
            {%- if _ss.button_text != blank -%}
                <div class="section_main_button for_desktop">
                <a href="{{ _ss.button_link }}" class="main_button"{% if _ss.scroll_id != blank %} scroll-id="{{ _ss.scroll_id }}"{% endif %}>{{ _ss.button_text }}
                        <img class="main_button_arrow" src="{{ "icon-down-arrow.svg" | asset_url }}" alt="down arrow">
                    </a>
                </div>
            {%- endif -%}
        </div>
        <div class="section_body">
            <div class="section_content">
                <div class="section_blocks">
                    {%- for block in section.blocks -%}
                        {%- assign _block = block.settings -%}
                        <div class="section_block">
                            <div class="block__imageWrapper">
                                <img src="{{ _block.image | image_url: width: 1000 }}" alt="block image-{{ forloop.index0 }}">
                            </div>
                            <div class="block__text">
                                <div class="block__number">{{ forloop.index }}</div>
                                <div class="block__title">{{ _block.title }}</div>
                            </div>
                        </div>
                    {%- endfor -%}
                </div>
            </div>

            {%- if _ss.button_text != blank -%}
                <div class="section_main_button for_mobile">
                    <a href="{{ _ss.button_link }}" class="main_button">{{ _ss.button_text }}
                        <img class="main_button_arrow" src="{{ "icon-down-arrow.svg" | asset_url }}" alt="down arrow">
                    </a>
                </div>
            {%- endif -%}
        </div>
    </div>
</div>

{%- endcapture -%}

{{- section_content -}}

{% schema %}
    {
        "name": "Muzzle Guide",
        "settings": [
            {
                "type": "textarea",
                "id": "title",
                "label": "Title",
                "default": "<span>[ count ] Steps</span> to Better Sleep",
                "info": "[ count ] - will be replaced with the number of steps"
            },
            {
                "type": "header",
                "content": "Button Settings"
            },
            {
                "type": "text",
                "id": "button_text",
                "label": "Button text",
                "default": "Try Muzzle Sleep"
            },
            {
                "type": "url",
                "id": "button_link",
                "label": "Button link"
            },
            {
                "type": "text",
                "id": "scroll_id",
                "label": "Scroll to custom ID"
            },
            {
                "type": "header",
                "content": "General Settings"
            },
            {
                "type": "color_background",
                "id": "background",
                "label": "Background color",
                "default": "#FFFFFF00"
            },
            {
                "type": "number",
                "id": "max_with",
                "label": "Max width",
                "default": 1920
            },
            {
                "type": "range",
                "id": "padding_top",
                "label": "Desktop padding top",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "label": "Desktop padding bottom",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_top_mobile",
                "label": "Mobile padding top",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            },
            {
                "type": "range",
                "id": "padding_bottom_mobile",
                "label": "Mobile padding bottom",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            }
        ],
        "blocks": [
            {
                "name": "Guide block",
                "type": "guide_block",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Title"
                    }
                ]
            }
        ],
        "presets": [{
            "name": "Muzzle Guide"
        }]
    }
{% endschema %}
