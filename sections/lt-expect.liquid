<style>
  #lt-expect-{{ section.id }} .lt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    text-align: center;
  }
  #lt-expect-{{ section.id }} .lt-heading {
    font-size: 36px;
    font-weight: 700;
    color: #27214D;
    margin: 0 0 20px;
    line-height: 1.2;
  }
  #lt-expect-{{ section.id }} .lt-subheading {
    font-size: 16px;
    color: #0F0F10;
    letter-spacing: 0px;
    margin: 0 auto 40px;
    line-height: 1;
  }
  #lt-expect-{{ section.id }} .lt-cards {
    display: flex;
    gap: 28px;
    justify-content: center;
    align-items: stretch;
    margin: 0 0 20px 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }
  #lt-expect-{{ section.id }} .lt-card {
    width: calc(25% - 21px);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    user-select: none;
    transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
    opacity: 0.55;
  }
  #lt-expect-{{ section.id }} .lt-card:hover { 
    transform: translateY(-4px);
  }
  #lt-expect-{{ section.id }} .lt-card.lt-active {
    opacity: 1;
  }
  #lt-expect-{{ section.id }} .lt-media {
    margin: 0 0 14px 0;
    display: flex;
    background: #e9e9e9;
    border-radius: 8px;
    overflow: hidden;
  }
  #lt-expect-{{ section.id }} .lt-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  #lt-expect-{{ section.id }} .lt-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 4px;
  }
  #lt-expect-{{ section.id }} .lt-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    color: #333333;
    margin: 20px 0 10px 0;
    text-align: left;
  }
  #lt-expect-{{ section.id }} .lt-underline {
    width: 100%;
    height: 2px;
    background: #c9c9c9;
    display: block;
    transform-origin: left;
    transform: scaleX(1);
    transition: background 180ms ease;
  }
  #lt-expect-{{ section.id }} .lt-card.lt-active .lt-underline {
    background: #111111;
  }
  #lt-expect-{{ section.id }} .lt-detail {
    max-width: 680px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.5;
    color: #2a2a2a;
    min-height: 48px;
    transform: translateY(-2px);
    transition: 0.2s;
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.5px;
    opacity: 0;
  }
  #lt-expect-{{ section.id }} .lt-card.lt-active .lt-detail {
    opacity: 1;
    transform: unset;
  }
  #lt-expect-{{ section.id }} .lt-detail p {
    margin: 0;
  }

  /* responsive (desktop-first) */
  @media (max-width: 1024px) {
    #lt-expect-{{ section.id }} .lt-card { width: calc(50% - 14px); }
    #lt-expect-{{ section.id }} .lt-heading { font-size: 32px;}
  }
  @media (max-width: 560px) {
    #lt-expect-{{ section.id }} .lt-container { padding: 44px 16px; }
    #lt-expect-{{ section.id }} .lt-heading { font-size: 28px;}
    #lt-expect-{{ section.id }} .lt-subheading { font-size: 16px;}
    #lt-expect-{{ section.id }} .lt-card { width: 100%; }
    #lt-expect-{{ section.id }} .lt-img { height: 160px; }
  }
</style>
<section class="lt-expect-wrap" id="lt-expect-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lt-container">
    <header class="lt-header">
      <h2 class="lt-heading">{{ section.settings.heading }}</h2>
      <p class="lt-subheading">{{ section.settings.subheading }}</p>
    </header>

    <ul class="lt-cards" role="list">
      {% for block in section.blocks %}
        <li
          class="lt-card{% if forloop.first %} lt-active{% endif %}"
          role="listitem"
          data-idx="{{ forloop.index0 }}"
          data-detail="{{ block.settings.detail | escape }}"
          {{ block.shopify_attributes }}
        >
          <figure class="lt-media">
            {% if block.settings.image != blank %}
              <img class="lt-img" src="{{ block.settings.image | img_url: '600x400' }}" alt="{{ block.settings.title | escape }}" width="280" height="180" loading="lazy">
            {% else %}
              <img class="lt-img" src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=800&h=500&fit=crop" alt="{{ block.settings.title | escape }}" width="280" height="180" loading="lazy">
            {% endif %}
          </figure>
          <div class="lt-meta">
            <span class="lt-underline"></span>
            <span class="lt-title">{{ block.settings.title }}</span>
            <div class="lt-detail" id="lt-detail-{{ section.id }}">{{ block.settings.detail }}</div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll('#lt-expect-{{ section.id }} .lt-card').forEach(card => {
    card.addEventListener('mouseenter', () => {
      document.querySelectorAll('#lt-expect-{{ section.id }} .lt-card').forEach(c => c.classList.remove('lt-active'));
      card.classList.add('lt-active');
    });
  });  
</script>

{% schema %}
{
  "name": "LT Expect Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Should I Expect From Sleep Deeply™?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Body's Response To Real Nutrition"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1 Week"
        },
        {
          "type": "richtext",
          "id": "detail",
          "label": "Detail",
          "default": "<p>Natural Energy Emerges, Brain Fog Lifts, And Sleep Quality Deepens.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LT Expect Timeline",
      "blocks": [
        { "type": "stage", "settings": { "title": "1 Week" } },
        { "type": "stage", "settings": { "title": "1 Month" } },
        { "type": "stage", "settings": { "title": "3 Month" } },
        { "type": "stage", "settings": { "title": "6 Months+" } }
      ]
    }
  ]
}
{% endschema %}
