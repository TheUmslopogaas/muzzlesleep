
<style>
  #shopify-section-{{ section.id }} {
    color: {{ section.settings.txt_color }};
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #f7f5ff;
  }
  #shopify-section-{{ section.id }} .lt-container {
    max-width: 1200px;
    width: 95%;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-header {
    text-align: center;
    margin-bottom: 32px;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-title {
    font-size: 40px;
    line-height: 48px;
    margin: 0;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols-desktop), minmax(0, 1fr));
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-card {
    background: #ffffff;
    border-radius: 10px;
    padding: 24px 24px 28px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: 0.2s;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-card:hover {
    transform: translateY(-2px);
    box-shadow: 0px 5px 20px 0px rgba(0,0,0,0.07);
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-icon-wrap {
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-icon-bg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-icon-bg img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-text {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    color: #121212;
    letter-spacing: 0;
    font-weight: 500;
    font-size: 18px;
  }

  /* alignment */
  #shopify-section-{{ section.id }} .lt-align-center .lt-guide-multicolumn-icon-card {
    text-align: center;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .lt-align-left .lt-guide-multicolumn-icon-card {
    text-align: left;
    align-items: flex-start;
  }
  #shopify-section-{{ section.id }} .lt-align-right .lt-guide-multicolumn-icon-card {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon {
      padding-top: calc({{ section.settings.padding_top }}px * 0.6);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.6);
    }
    #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-grid {
      grid-template-columns: repeat(var(--lt-cols-mobile), minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-title {
      font-size: 28px;
      line-height: 34px;
    }
    #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-text {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .lt-guide-multicolumn-icon-card {
      padding: 16px;
    }
  }
</style>

<section class="lt-guide-multicolumn-icon">
  <div class="lt-container">
    <div class="lt-guide-multicolumn-icon-header">
      <h2 class="lt-guide-multicolumn-icon-title">{{ section.settings.title }}</h2>
    </div>

    <div
      class="lt-guide-multicolumn-icon-grid lt-align-{{ section.settings.content_align }}"
      style="--lt-cols-desktop: {{ section.settings.columns_desktop }}; --lt-cols-mobile: {{ section.settings.columns_mobile }};"
    >
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="lt-guide-multicolumn-icon-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="lt-guide-multicolumn-icon-icon-wrap">
                <span class="lt-guide-multicolumn-icon-icon-bg">
                  <img src="{{ block.settings.icon | img_url: '80x' }}" alt="{{ block.settings.text | strip_html | escape }}">
                </span>
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="lt-guide-multicolumn-icon-text">{%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}: </strong>{%- endif -%}{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "LT Guide Multicolumn Icon",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F6F5FF"
    },
    {
      "type": "color",
      "id": "txt_color",
      "label": "Section Text Color",
      "default": "#121212"
    },
    {
      "id": "title",
      "type": "text",
      "label": "Section title",
      "default": "Pro Tips for Best Results"
    },
    {
      "id": "columns_desktop",
      "type": "range",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "id": "columns_mobile",
      "type": "range",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "id": "content_align",
      "type": "select",
      "label": "Content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "id": "padding_top",
      "type": "range",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    },
    {
      "id": "padding_bottom",
      "type": "range",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon card",
      "settings": [
        {
          "id": "icon",
          "type": "image_picker",
          "label": "Icon"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Text Title"
        },
        {
          "id": "text",
          "type": "textarea",
          "label": "Text",
          "default": "Apply during the deepest sleep to avoid resistance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Guide Multicolumn Icon",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}