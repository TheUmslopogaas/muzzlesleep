{%- comment -%} Section: Fixed Close Button {%- endcomment -%}

<div class="fixed-close-section" style="width:100%; height:0;"></div>

<a href="/" class="fixed-close-btn" aria-label="Close">&times;</a>

<style>
  .fixed-close-btn {
    position: fixed;
    top: {{ section.settings.top_offset }}px;
    right: {{ section.settings.right_offset }}px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.btn_size }}px;
    height: {{ section.settings.btn_size }}px;
    font-size: {{ section.settings.icon_size }}px;
    font-weight: 400;
    line-height: 1;
    color: {{ section.settings.icon_color }};
    background: {{ section.settings.bg_color }};
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .fixed-close-btn:hover {
    opacity: 0.75;
  }
</style>

{% schema %}
{
  "name": "LT Fixed Close Button",
  "settings": [
    { "type": "range", "id": "top_offset", "label": "Top offset (px)", "min": 0, "max": 100, "step": 1, "default": 20 },
    { "type": "range", "id": "right_offset", "label": "Right offset (px)", "min": 0, "max": 100, "step": 1, "default": 20 },
    { "type": "range", "id": "btn_size", "label": "Button size (px)", "min": 24, "max": 80, "step": 1, "default": 40 },
    { "type": "range", "id": "icon_size", "label": "Icon size (px)", "min": 12, "max": 48, "step": 1, "default": 28 },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#000000" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "LT Fixed Close Button" }]
}
{% endschema %}