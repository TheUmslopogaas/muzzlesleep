<style>
  #shopify-section-{{ section.id }} .lt-dr-logolist-slider {
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-container {
    margin: 0 auto;
    padding: 0 20px;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-heading {
    text-align: center;
    margin-bottom: 30px;
    font-size: 22px;
    font-weight: 600;
    color: #222;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-swiper {
    width: 100%;
    position: relative;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    padding: 0 20px;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-image {
    max-width: 100%;
    height: 50px;
    width: 150px;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }
  #shopify-section-{{ section.id }} .lt-dr-logolist-link:hover .lt-dr-logolist-image {
    opacity: 0.8;
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .lt-dr-logolist-heading {
      font-size: 24px;
      margin-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .lt-dr-logolist-slide {
      height: 60px;
      padding: 0 15px;
    }
    #shopify-section-{{ section.id }} .lt-dr-logolist-image {
      max-height: 45px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-dr-logolist-heading {
      font-size: 20px;
      margin-bottom: 15px;
    }
    #shopify-section-{{ section.id }} .lt-dr-logolist-slide {
      height: 50px;
      padding: 0 10px;
    }
    #shopify-section-{{ section.id }} .lt-dr-logolist-image {
      max-height: 35px;
    }
  }
</style>

<div class="lt-dr-logolist-slider">
  <div class="lt-dr-logolist-container">
    {% if section.settings.heading != blank %}
      <h2 class="lt-dr-logolist-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.blocks.size > 0 %}
      <div class="lt-dr-logolist-swiper swiper">
        <div class="lt-dr-logolist-wrapper swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.settings.logo_image != blank %}
              <div class="lt-dr-logolist-slide swiper-slide">
                {% if block.settings.logo_link != blank %}
                  <a href="{{ block.settings.logo_link }}" class="lt-dr-logolist-link" target="_blank" rel="noopener">
                {% endif %}
                <img 
                  src="{{ block.settings.logo_image | img_url: 'master' }}" 
                  alt="{{ block.settings.logo_alt | escape }}" 
                  loading="lazy" 
                  class="lt-dr-logolist-image"
                >
                {% if block.settings.logo_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
          
          {% comment %} Duplicate logos for infinite effect {% endcomment %}
          {% for block in section.blocks %}
            {% if block.settings.logo_image != blank %}
              <div class="lt-dr-logolist-slide swiper-slide">
                {% if block.settings.logo_link != blank %}
                  <a href="{{ block.settings.logo_link }}" class="lt-dr-logolist-link" target="_blank" rel="noopener">
                {% endif %}
                
                <img 
                  src="{{ block.settings.logo_image | img_url: 'master' }}" 
                  alt="{{ block.settings.logo_alt | escape }}" 
                  loading="lazy" 
                  class="lt-dr-logolist-image"
                >
                
                {% if block.settings.logo_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% comment %}
<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css">
{% endcomment %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const logoSwiper = new Swiper(`#shopify-section-${sectionId} .lt-dr-logolist-swiper`, {
      slidesPerView: 'auto',
      spaceBetween: 10,
      loop: true,
      loopAdditionalSlides: 10,
      speed: 8000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
      },
      breakpoints: {
        320: {
          slidesPerView: 2,
          spaceBetween: 10
        },
        480: {
          slidesPerView: 3,
          spaceBetween: 10
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 10
        },
        992: {
          slidesPerView: 5,
          spaceBetween: 10
        },
        1200: {
          slidesPerView: 6,
          spaceBetween: 10
        }
      }
    });
  });
</script>
{% schema %}
{
  "name": "LT Logolist Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen On"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#d9f2e9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Logo Link",
          "info": "Optional"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Logolist Slider",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}