{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round

  assign pb_mobile = section.settings.padding_bottom_mobile
-%}

<div class="lt-loyalty-promobanner">
  <div class="lt-loyalty-promobanner__bg">
    {%- if section.settings.background_image != blank -%}
      <img
        class="lt-loyalty-promobanner__bg-img lt-loyalty-promobanner__bg-img--desktop"
        src="{{ section.settings.background_image | image_url }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    {%- endif -%}
    {%- if section.settings.background_image_mobile != blank -%}
      <img
        class="lt-loyalty-promobanner__bg-img lt-loyalty-promobanner__bg-img--mobile"
        src="{{ section.settings.background_image_mobile | image_url }}"
        alt="{{ section.settings.background_image_mobile.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.background_image_mobile.width }}"
        height="{{ section.settings.background_image_mobile.height }}"
      >
    {%- endif -%}
    {%- if section.settings.background_image == blank and section.settings.background_image_mobile == blank -%}
      <div class="lt-loyalty-promobanner__bg-placeholder"></div>
    {%- endif -%}
    <div class="lt-loyalty-promobanner__overlay"></div>
  </div>

  <div class="page-width">
    <div class="lt-loyalty-promobanner__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lt-loyalty-promobanner__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="lt-loyalty-promobanner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="lt-loyalty-promobanner__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="lt-loyalty-promobanner__button"
          {% if section.settings.open_smile %}data-lt-smile-launch{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg-img--mobile {
    display: none;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #1a1440 0%, #4a2f7d 55%, #b9a4d6 100%);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__content {
    position: relative;
    z-index: 1;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 40px 0;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__eyebrow {
    display: inline-block;
    padding: 8px 18px;
    margin-bottom: 20px;
    border-radius: 100px;
    background-color: {{ section.settings.eyebrow_bg_color }};
    color: {{ section.settings.eyebrow_text_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__heading {
    margin: 0 0 20px;
    font-size: 52px;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -1px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__description {
    max-width: 640px;
    margin: 0 auto 36px;
    font-size: 18px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__description p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__button {
    display: inline-block;
    padding: 19px 44px;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-promobanner__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {% if pb_mobile > 0 %}{{ pb_mobile }}{% else %}{{ pb_m }}{% endif %}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner {
      min-height: {{ section.settings.min_height_mobile }}px;
    }
    {%- if section.settings.background_image_mobile != blank -%}
      #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg-img--desktop {
        display: none;
      }
      #shopify-section-{{ section.id }} .lt-loyalty-promobanner__bg-img--mobile {
        display: block;
        object-position: {{ section.settings.mobile_bg_position }};
      }
    {%- endif -%}
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner__content {
      padding: 32px 0;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner__heading {
      font-size: 32px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner__description {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner__heading {
      font-size: 27px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-promobanner__button {
      padding: 17px 32px;
      font-size: 16px;
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function init() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;

      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (!launcher || launcher.dataset.ltBound === 'true') return;

      launcher.dataset.ltBound = 'true';

      launcher.addEventListener('click', function (e) {
        // Open the Smile.io panel if available; otherwise let the href navigate.
        if (window.SmileUI && typeof window.SmileUI.openPanel === 'function') {
          e.preventDefault();
          window.SmileUI.openPanel();
        } else if (window.smile && typeof window.smile.openPanel === 'function') {
          e.preventDefault();
          window.smile.openPanel();
        }
      });
    }

    function destroy() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;
      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (launcher) launcher.dataset.ltBound = '';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) init();
    });
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) destroy();
    });
  })();
</script>

{% schema %}
{
  "name": "LT Loyalty Promo Banner",
  "tag": "section",
  "class": "lt-loyalty-promobanner-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "select",
      "id": "mobile_bg_position",
      "label": "Mobile background focal point",
      "info": "Which part of the mobile image stays visible.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 500,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "color",
      "id": "eyebrow_bg_color",
      "label": "Eyebrow background",
      "default": "#3A3268"
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text",
      "default": "#C1BBE6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Better Sleep Routine Deserves to Be Rewarded"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Join The Muzzle Sleep Club today and start earning points toward exclusive perks, VIP treatment, and savings on the products that help you breathe easier, sleep deeper, and wake up refreshed.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join The Muzzle Sleep Club — It's Free"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (fallback)",
      "info": "Used when the Smile.io panel isn't available."
    },
    {
      "type": "checkbox",
      "id": "open_smile",
      "label": "Open Smile.io panel on click",
      "info": "Opens the Smile.io launcher instead of navigating. Falls back to the link above if the widget hasn't loaded.",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1F1B4D"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "info": "When above 0, overrides the auto-scaled mobile bottom padding. Use to reveal the bottom of the mobile background image.",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "LT Loyalty Promo Banner"
    }
  ]
}
{% endschema %}
