<style>
  #shopify-section-{{ section.id }} {
    color: {{ section.settings.txt_color }};
    background-color: {{ section.settings.bg_color }};
  }  
  #shopify-section-{{ section.id }} .lt-guide-split-list {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .lt-container {
    max-width: 1200px;
    width: 95%;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-header {
    text-align: center;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-title {
    font-size: 40px;
    margin: 0 0 20px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-subtitle {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
    color: #121212;
    max-width: 860px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .lt-guide-split-list-grid {
    display: flex;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-left {
    flex: 1.1 1 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-right {
    flex: 1 1 0;
  }

  #shopify-section-{{ section.id }} .lt-guide-split-list-item {
    display: flex;
    gap: 16px;
    background: #ffffff;
    border-radius: 18px;
    padding: 12px 18px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-item-media {
    flex: 0 0 38%;
    border-radius: 14px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-item-media img {
    width: 100%;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-item-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-item-title,
  #shopify-section-{{ section.id }} .lt-guide-split-list-right-title {
    font-size: 24px;
    margin: 0 0 8px;
    letter-spacing: 0px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-item-text,
  #shopify-section-{{ section.id }} .lt-guide-split-list-right-text {
    font-size: 15px;
    line-height: 1.5;
    font-weight: 400;
    color: #121212;
    max-width: 860px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lt-guide-split-list-right-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 16px 18px 22px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-right-media {
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-right-media img {
    width: 100%;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-guide-split-list-btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 999px;
    background: #27214d;
    color: #ffffff;
    font-size: 14px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 20px;
  }

  @media(max-width:900px){
    #shopify-section-{{ section.id }} .lt-guide-split-list {
      padding-top: calc({{ section.settings.padding_top }}px * 0.6);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.6);
    }
    #shopify-section-{{ section.id }} .lt-guide-split-list-grid {
      flex-direction: column;
    }
  }
  @media(max-width:600px){
    #shopify-section-{{ section.id }} .lt-guide-split-list-item-title {
      font-size: 16px;
      margin-bottom: 5px;
    }  
    #shopify-section-{{ section.id }} .lt-guide-split-list-item {
      padding: 10px;
    }
    #shopify-section-{{ section.id }} .lt-guide-split-list-item-text {
      line-height: 1.3;
      font-size: 14px;
    }
    #shopify-section-{{ section.id }} .lt-guide-split-list-title {
      font-size: 28px;
    }
  }
</style>

<section class="lt-guide-split-list">
  <div class="lt-container">
    <div class="lt-guide-split-list-header">
      <h2 class="lt-guide-split-list-title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="lt-guide-split-list-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="lt-guide-split-list-grid">
      <div class="lt-guide-split-list-left">
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            <div class="lt-guide-split-list-item" {{ block.shopify_attributes }}>
              <div class="lt-guide-split-list-item-media">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.title | escape }}">
                {% endif %}
              </div>
              <div class="lt-guide-split-list-item-content">
                {% if block.settings.title != blank %}
                  <h3 class="lt-guide-split-list-item-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="lt-guide-split-list-item-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="lt-guide-split-list-right">
        <div class="lt-guide-split-list-right-card">
          {% if section.settings.right_image != blank %}
            <div class="lt-guide-split-list-right-media">
              <img src="{{ section.settings.right_image | img_url: '800x' }}" alt="{{ section.settings.right_title | escape }}">
            </div>
          {% endif %}

          <div class="lt-guide-split-list-right-content">
            {% if section.settings.right_title != blank %}
              <h3 class="lt-guide-split-list-right-title">{{ section.settings.right_title }}</h3>
            {% endif %}

            {% if section.settings.right_text != blank %}
              <p class="lt-guide-split-list-right-text">{{ section.settings.right_text }}</p>
            {% endif %}

            {% if section.settings.btn_label != blank and section.settings.btn_url != blank %}
              <a href="{{ section.settings.btn_url }}" class="lt-guide-split-list-btn">
                {{ section.settings.btn_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "LT Guide Split List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F6F5FF"
    },
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "Foods & Supplements to Support Deeper Sleep"
    },
    {
      "id": "subtitle",
      "type": "text",
      "label": "Subtitle",
      "default": "Eating the right foods before bed can enhance sleep quality"
    },
    {
      "id": "right_image",
      "type": "image_picker",
      "label": "Right card image"
    },
    {
      "id": "right_title",
      "type": "text",
      "label": "Right card title",
      "default": "Supplements to Consider"
    },
    {
      "id": "right_text",
      "type": "textarea",
      "label": "Right card text",
      "default": "Describe supporting information, product details, or anything relevant here."
    },
    {
      "id": "btn_label",
      "type": "text",
      "label": "Button label",
      "default": "Learn More →"
    },
    {
      "id": "btn_url",
      "type": "url",
      "label": "Button link"
    },
    {
      "id": "padding_top",
      "type": "range",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    },
    {
      "id": "padding_bottom",
      "type": "range",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "id": "image",
          "type": "image_picker",
          "label": "Image"
        },
        {
          "id": "title",
          "type": "text",
          "label": "Title",
          "default": "Item Title"
        },
        {
          "id": "text",
          "type": "text",
          "label": "Description",
          "default": "Item description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Guide Split List",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}