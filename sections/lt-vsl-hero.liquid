{%- liquid
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign has_source = false
  if video != blank or video_url != blank
    assign has_source = true
  endif

  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round

  assign logo_h = section.settings.logo_height
  assign logo_h_m = logo_h | times: 0.6 | round

  assign bg_desktop = section.settings.background_image
  assign bg_mobile = section.settings.background_image_mobile
  if bg_mobile == blank
    assign bg_mobile = bg_desktop
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
    {%- if bg_desktop != blank %}
    background-image: url('{{ bg_desktop | image_url: width: 2400 }}');
    {%- else %}
    background-image: linear-gradient(180deg, #b96d74 0%, #d98c97 60%, #ffffff 100%);
    {%- endif %}
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: cover;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero,
  #shopify-section-{{ section.id }} .lt-vsl-hero *,
  #shopify-section-{{ section.id }} .lt-vsl-hero *::before,
  #shopify-section-{{ section.id }} .lt-vsl-hero *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero {
    font-family: Inter, var(--font-body-family), sans-serif;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__inner.page-width {
    max-width: 1440px;
    padding: 0 106px;
  }

  /* Content */
  #shopify-section-{{ section.id }} .lt-vsl-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Social proof */
  #shopify-section-{{ section.id }} .lt-vsl-hero__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__avatars {
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__avatar {
    display: block;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    margin-left: -18px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__avatar:first-child {
    margin-left: 0;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__avatar img,
  #shopify-section-{{ section.id }} .lt-vsl-hero__avatar svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__rating-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__rating-label {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 17px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__stars {
    display: flex;
    align-items: center;
    gap: 1px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__star {
    display: block;
    width: 15px;
    height: 15px;
    color: #f9a825;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__rating-value {
    margin-left: 5px;
    font-size: 12px;
    font-weight: 400;
    line-height: 15px;
  }

  /* Text */
  #shopify-section-{{ section.id }} .lt-vsl-hero__heading {
    max-width: 900px;
    margin: 0;
    font-family: inherit;
    font-size: 58px;
    font-weight: 600;
    line-height: 77px;
    letter-spacing: -0.5px;
    color: inherit;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__description {
    max-width: 840px;
    margin: 24px 0 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 32px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__highlight {
    max-width: 840px;
    margin: 32px 0 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
  }

  /* Button */
  #shopify-section-{{ section.id }} .lt-vsl-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 58px;
    margin-top: 48px;
    padding: 0 40px;
    border: 0;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__button-arrow {
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  /* Media */
  #shopify-section-{{ section.id }} .lt-vsl-hero__media {
    position: relative;
    width: 100%;
    max-width: 1228px;
    margin: 48px auto 0;
    aspect-ratio: 16 / 9;
    border: 4px solid rgba(176, 176, 172, 0.9);
    border-radius: 64px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.12);
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__poster {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__poster img,
  #shopify-section-{{ section.id }} .lt-vsl-hero__poster svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__poster svg {
    background-color: rgba(255, 255, 255, 0.25);
    fill: rgba(0, 0, 0, 0.25);
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 128px;
    height: 128px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.12);
    color: #ffffff;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__play:hover {
    background-color: rgba(255, 255, 255, 0.25);
    transform: translate(-50%, -50%) scale(1.06);
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__play:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__play-icon {
    display: block;
    width: 44px;
    height: 44px;
    margin-left: 4px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__media.is-playing .lt-vsl-hero__poster,
  #shopify-section-{{ section.id }} .lt-vsl-hero__media.is-playing .lt-vsl-hero__play {
    display: none;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__player {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    background-color: #000000;
  }

  /* Logos */
  #shopify-section-{{ section.id }} .lt-vsl-hero__logos {
    margin-top: 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logos-label {
    margin: 0;
    color: {{ section.settings.logos_label_color }};
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logos-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 24px auto 0;
    padding: 0;
    max-width: 1228px;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logo a {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logo a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logo img {
    display: block;
    width: auto;
    height: {{ logo_h }}px;
    max-width: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .lt-vsl-hero__logo-name {
    color: #9a9a9a;
    font-size: 28px;
    font-weight: 800;
    line-height: 32px;
    white-space: nowrap;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .lt-vsl-hero__inner.page-width {
      padding: 0 40px;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
      {%- if bg_mobile != blank %}
      background-image: url('{{ bg_mobile | image_url: width: 1000 }}');
      {%- endif %}
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__inner.page-width {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__rating {
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__avatar {
      width: 38px;
      height: 38px;
      margin-left: -15px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__heading {
      font-size: 38px;
      line-height: 48px;
      letter-spacing: -0.3px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__description {
      margin-top: 18px;
      font-size: 16px;
      line-height: 26px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__highlight {
      margin-top: 22px;
      font-size: 16px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__button {
      min-height: 52px;
      margin-top: 32px;
      padding: 0 32px;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__media {
      margin-top: 32px;
      border-width: 3px;
      border-radius: 32px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__play {
      width: 84px;
      height: 84px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__play-icon {
      width: 30px;
      height: 30px;
      margin-left: 3px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logos {
      margin-top: 32px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logos-label {
      font-size: 12px;
      line-height: 16px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logos-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px 28px;
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logo img {
      max-width: 120px;
      height: {{ logo_h_m }}px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logo-name {
      font-size: 20px;
      line-height: 24px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-vsl-hero__inner.page-width {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__heading {
      font-size: 30px;
      line-height: 40px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__description,
    #shopify-section-{{ section.id }} .lt-vsl-hero__highlight {
      font-size: 15px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__media {
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__play {
      width: 64px;
      height: 64px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__play-icon {
      width: 24px;
      height: 24px;
      margin-left: 2px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logos-list {
      gap: 16px 22px;
    }

    #shopify-section-{{ section.id }} .lt-vsl-hero__logo img {
      max-width: 96px;
    }
  }
</style>

<div class="lt-vsl-hero">
  <div class="page-width lt-vsl-hero__inner">
    <div class="lt-vsl-hero__content">
      {%- if section.settings.show_rating -%}
        <div class="lt-vsl-hero__rating">
          <div class="lt-vsl-hero__avatars">
            {%- for i in (1..3) -%}
              {%- liquid
                case i
                  when 1
                    assign avatar = section.settings.avatar_1
                  when 2
                    assign avatar = section.settings.avatar_2
                  else
                    assign avatar = section.settings.avatar_3
                endcase
              -%}
              <span class="lt-vsl-hero__avatar">
                {%- if avatar != blank -%}
                  <img
                    src="{{ avatar | image_url: width: 88, height: 88, crop: 'center' }}"
                    alt=""
                    width="44"
                    height="44"
                    loading="eager"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
          <div class="lt-vsl-hero__rating-text">
            {%- if section.settings.rating_label != blank -%}
              <p class="lt-vsl-hero__rating-label">{{ section.settings.rating_label | escape }}</p>
            {%- endif -%}
            <div class="lt-vsl-hero__stars">
              {%- for i in (1..5) -%}
                <svg class="lt-vsl-hero__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M12 1.8l3.1 6.9 7.5.8-5.6 5 1.6 7.4L12 18l-6.6 3.9L7 14.5l-5.6-5 7.5-.8L12 1.8z"/>
                </svg>
              {%- endfor -%}
              {%- if section.settings.rating_text != blank -%}
                <span class="lt-vsl-hero__rating-value">{{ section.settings.rating_text | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="lt-vsl-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="lt-vsl-hero__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.highlight != blank -%}
        <p class="lt-vsl-hero__highlight">{{ section.settings.highlight | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <a class="lt-vsl-hero__button" href="{{ section.settings.button_link | default: '#' }}">
          <span>{{ section.settings.button_text | escape }}</span>
          {%- if section.settings.show_button_arrow -%}
            <svg class="lt-vsl-hero__button-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/>
            </svg>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>

    <div class="lt-vsl-hero__media">
      <div class="lt-vsl-hero__poster">
        {%- if section.settings.poster_image != blank -%}
          <img
            src="{{ section.settings.poster_image | image_url: width: 1228 }}"
            srcset="{{ section.settings.poster_image | image_url: width: 640 }} 640w, {{ section.settings.poster_image | image_url: width: 1228 }} 1228w, {{ section.settings.poster_image | image_url: width: 2456 }} 2456w"
            sizes="(max-width: 767px) 100vw, 1228px"
            alt="{{ section.settings.poster_image.alt | default: section.settings.poster_alt | escape }}"
            width="{{ section.settings.poster_image.width }}"
            height="{{ section.settings.poster_image.height }}"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      {%- if has_source or request.design_mode -%}
        <button class="lt-vsl-hero__play" type="button" aria-label="{{ section.settings.play_label | escape }}">
          <svg class="lt-vsl-hero__play-icon" viewBox="0 0 44 44" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 7.5v29L36.5 22 12 7.5z" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if has_source -%}
        <template class="lt-vsl-hero__player-template">
          {%- if video != blank -%}
            {{ video | video_tag: image_size: '1440x', autoplay: true, controls: true, playsinline: true, class: 'lt-vsl-hero__player' }}
          {%- elsif video_url.type == 'youtube' -%}
            <iframe
              class="lt-vsl-hero__player"
              src="https://www.youtube.com/embed/{{ video_url.id }}?autoplay=1&rel=0&playsinline=1"
              title="{{ section.settings.play_label | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
            ></iframe>
          {%- elsif video_url.type == 'vimeo' -%}
            <iframe
              class="lt-vsl-hero__player"
              src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1"
              title="{{ section.settings.play_label | escape }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}
    </div>

    {%- if section.settings.show_logos and section.blocks.size > 0 -%}
      <div class="lt-vsl-hero__logos">
        {%- if section.settings.logos_label != blank -%}
          <p class="lt-vsl-hero__logos-label">{{ section.settings.logos_label | escape }}</p>
        {%- endif -%}
        <ul class="lt-vsl-hero__logos-list">
          {%- for block in section.blocks -%}
            <li class="lt-vsl-hero__logo" {{ block.shopify_attributes }}>
              {%- capture logo_inner -%}
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 500 }}"
                    alt="{{ block.settings.name | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="lt-vsl-hero__logo-name">{{ block.settings.name | escape }}</span>
                {%- endif -%}
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" aria-label="{{ block.settings.name | escape }}">{{ logo_inner }}</a>
              {%- else -%}
                {{ logo_inner }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if has_source -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      if (typeof root.ltVslHeroDestroy === 'function') root.ltVslHeroDestroy();

      var media = null;
      var button = null;
      var bound = false;

      function onPlay() {
        var tpl = media.querySelector('.lt-vsl-hero__player-template');
        if (!tpl || media.classList.contains('is-playing')) return;
        var frag = document.importNode(tpl.content, true);
        var player = frag.querySelector('.lt-vsl-hero__player');
        if (!player) return;
        media.classList.add('is-playing');
        media.appendChild(frag);
        if (typeof player.play === 'function') {
          var attempt = player.play();
          if (attempt && typeof attempt.catch === 'function') attempt.catch(function () {});
        }
        player.setAttribute('tabindex', '-1');
        player.focus();
      }

      function init() {
        if (bound) return;
        media = root.querySelector('.lt-vsl-hero__media');
        button = root.querySelector('.lt-vsl-hero__play');
        if (!media || !button) return;
        button.addEventListener('click', onPlay);
        bound = true;
      }

      function destroy() {
        if (button) button.removeEventListener('click', onPlay);
        root.removeEventListener('shopify:section:load', init);
        root.removeEventListener('shopify:section:unload', destroy);
        if (media) {
          var player = media.querySelector('video.lt-vsl-hero__player');
          if (player) player.pause();
        }
        bound = false;
        media = null;
        button = null;
        delete root.ltVslHeroDestroy;
      }

      root.ltVslHeroDestroy = destroy;
      root.addEventListener('shopify:section:load', init);
      root.addEventListener('shopify:section:unload', destroy);
      init();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "LT VSL Hero",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
