<style>
  #lt-ingredients-{{ section.id }} .lt-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    text-align: center;
  }
  #lt-ingredients-{{ section.id }} .lt-heading {
    font-size: 42px;
    font-weight: 700;
    color: #27214D;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }
  #lt-ingredients-{{ section.id }} .lt-subheading {
    font-size: 16px;
    color: #0F0F10;
    letter-spacing: 0px;
    margin: 0 auto 40px;
    line-height: 1;
  }
  #lt-ingredients-{{ section.id }} .lt-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #lt-ingredients-{{ section.id }} .lt-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc(33.333% - 22px);
    min-width: 280px;
    text-align: center;
  }
  #lt-ingredients-{{ section.id }} .lt-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 16px 0;
  }
  #lt-ingredients-{{ section.id }} .lt-img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 9999px;
    display: block;
  }
  #lt-ingredients-{{ section.id }} .lt-item-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 auto 10px;
    letter-spacing: 0;
    color: #27214D;
  }
  #lt-ingredients-{{ section.id }} .lt-english {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 10px 0;
    letter-spacing: 0px;
    color: #111;
  }
  #lt-ingredients-{{ section.id }} .lt-body > * {
    font-size: 14px;
    line-height: 1.5;
    color: #111;
    font-weight: 500;
    max-width: 560px;
    letter-spacing: 0.5px;
  }

  /* responsive */
  @media (max-width: 1024px) {
    #lt-ingredients-{{ section.id }} .lt-item { width: calc(50% - 16px); }
    #lt-ingredients-{{ section.id }} .lt-heading { font-size: 32px;}
  }
  @media (max-width: 640px) {
    #lt-ingredients-{{ section.id }} .lt-item { width: 100%; }
    #lt-ingredients-{{ section.id }} .lt-container { padding: 40px 16px; }
    #lt-ingredients-{{ section.id }} .lt-heading { font-size: 28px;}
  }
</style>

<section class="lt-ingredients-wrap" id="lt-ingredients-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lt-container">
    {% if section.settings.heading != blank %}
      <header class="lt-header">
        <h2 class="lt-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="lt-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <ul class="lt-grid" role="list">
      {% for block in section.blocks %}
        <li class="lt-item" role="listitem" {{ block.shopify_attributes }}>
          <figure class="lt-figure">
            {% if block.settings.image != blank %}
              <img class="lt-img" src="{{ block.settings.image | img_url: '300x300' }}" alt="{{ block.settings.title | escape }}" width="140" height="140" loading="lazy">
            {% else %}
              <img class="lt-img" src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?w=300&h=300&fit=crop" alt="{{ block.settings.title | escape }}" width="140" height="140" loading="lazy">
            {% endif %}
          </figure>

          {% if block.settings.title != blank %}
            <h3 class="lt-item-title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.english_name != blank %}
            <p class="lt-english"><strong>English Name:</strong> {{ block.settings.english_name }}</p>
          {% endif %}

          {% if block.settings.body != blank %}
            <div class="lt-body">{{ block.settings.body }}</div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "LT Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Packed with Clinically Proven & Scientifically Researched Ingredients"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Polygalae Radix"
        },
        {
          "type": "text",
          "id": "english_name",
          "label": "English Name",
          "default": "Polygalae Radix"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Description",
          "default": "<p>Enter traditional and Latin names, plus benefits.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "LT Ingredients",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}