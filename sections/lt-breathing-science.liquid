<style>
#shopify-section-{{section.id}} {
  background-color: {{ section.settings.background_color }};
  padding: 60px 20px;
}

#shopify-section-{{section.id}} .container {
  max-width: 1200px;
  margin: 0 auto;
}

#shopify-section-{{section.id}} .section-title {
  font-size: 36px;
  font-weight: 700;
  color: #27214D;
  text-align: center;
  margin-bottom: 50px;
  line-height: 1.2;
}

#shopify-section-{{section.id}} .content-wrapper {
  display: flex;
  gap: 60px;
  align-items: flex-start;
}

#shopify-section-{{section.id}} .image-column {
  flex: 1;
}

#shopify-section-{{section.id}} .image-container {
  width: 100%;
  background-color: #f5f5f5;
  border-radius: 12px;
  overflow: hidden;
}

#shopify-section-{{section.id}} .image-container img {
  width: 100%;
  height: auto;
  display: block;
}

#shopify-section-{{section.id}} .text-column {
  flex: 1;
}

#shopify-section-{{section.id}} .main-title {
  font-size: 42px;
  font-weight: 700;
  color: #27214D;
  margin-bottom: 25px;
  line-height: 1.2;
}

#shopify-section-{{section.id}} .main-description {
  font-size: 18px;
  color: #0F0F10;
  line-height: 1.6;
  margin-bottom: 25px;
}

#shopify-section-{{section.id}} .benefits-list {
  margin-bottom: 30px;
}

#shopify-section-{{section.id}} .benefit-item {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  font-size: 16px;
  color: #0F0F10;
}

#shopify-section-{{section.id}} .benefit-check {
  width: 20px;
  height: 20px;
  background-color: #27214D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 12px;
  flex-shrink: 0;
}

#shopify-section-{{section.id}} .doctor-note {
  font-size: 16px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 25px;
}

#shopify-section-{{section.id}} .doctor-note strong {
  color: #27214D;
  font-weight: 600;
}

#shopify-section-{{section.id}} .cta-text {
  font-size: 18px;
  color: #2c3e50;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.2;
  margin-bottom: 20px;
}

#shopify-section-{{section.id}} .cta-button {
  background-color: #27214D;
  color: white;
  padding: 16px 32px;
  border-radius: 30px;
  text-decoration: none;
  font-size: 16px;
  font-weight: 600;
  line-height: 1;
  display: inline-block;
  transition: background-color 0.3s ease;
}

#shopify-section-{{section.id}} .cta-button:hover {
  background-color: #2c3654;
}

@media (max-width: 768px) {
  #shopify-section-{{section.id}} {
    padding: 40px 15px;
  }
  
  #shopify-section-{{section.id}} .section-title {
    font-size: 28px;
  }
  
  #shopify-section-{{section.id}} .content-wrapper {
    flex-direction: column;
    gap: 40px;
  }
  
  #shopify-section-{{section.id}} .main-title {
    font-size: 32px;
  }
}

@media (max-width: 480px) {
  #shopify-section-{{section.id}} .section-title {
    font-size: 24px;
  }
  
  #shopify-section-{{section.id}} .main-title {
    font-size: 28px;
  }

  #shopify-section-{{section.id}} .benefit-item {
    margin-bottom: 4px;
  }  

  #shopify-section-{{section.id}} .cta-button {
    display: block;
    line-height: 1;
    font-size: 14px;
    text-align: center;
  }
  
  #shopify-section-{{section.id}} .main-description,
  #shopify-section-{{section.id}} .benefit-item,
  #shopify-section-{{section.id}} .cta-text,
  #shopify-section-{{section.id}} .doctor-note {
    font-size: 14px;
  }
}
</style>

<div class="container">
  {% if section.settings.section_title != blank %}
    <h2 class="section-title">{{ section.settings.section_title }}</h2>
  {% endif %}
  
  <div class="content-wrapper">
    <div class="image-column">
      {% if section.settings.main_image != blank %}
        <div class="image-container">
          <img src="{{ section.settings.main_image | img_url: 'master' }}" alt="{{ section.settings.main_title }}">
        </div>
      {% else %}
        <div class="image-container" style="height: 400px; display: flex; align-items: center; justify-content: center; color: #999;">
          Image placeholder
        </div>
      {% endif %}
    </div>
    
    <div class="text-column">
      {% if section.settings.main_title != blank %}
        <h3 class="main-title">{{ section.settings.main_title }}</h3>
      {% endif %}
      
      {% if section.settings.main_description != blank %}
        <div class="main-description">{{ section.settings.main_description }}</div>
      {% endif %}
      
      {% if section.settings.secondary_description != blank %}
        <div class="main-description">{{ section.settings.secondary_description }}</div>
      {% endif %}
      
      {% if section.settings.benefits != blank %}
        <div class="benefits-list">
          {% assign benefits = section.settings.benefits | split: '|' %}
          {% for benefit in benefits %}
            <div class="benefit-item">
              <div class="benefit-check">✓</div>
              <span>{{ benefit | strip }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
      
      {% if section.settings.doctor_note != blank %}
        <div class="doctor-note">{{ section.settings.doctor_note }}</div>
      {% endif %}
      
      {% if section.settings.cta_text != blank %}
        <div class="cta-text">{{ section.settings.cta_text }}</div>
      {% endif %}
      
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_url | default: '#' }}" class="cta-button">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LT Breathing Science",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "The Science Behind Better Breathing"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Why Nasal Breathing Changes Everything"
    },
    {
      "type": "textarea",
      "id": "main_description",
      "label": "Main Description",
      "default": "When you breathe through your nose, air is filtered, warmed, and humidified before reaching your lungs. This prevents snoring and improves oxygen absorption for more restorative sleep."
    },
    {
      "type": "textarea",
      "id": "secondary_description",
      "label": "Secondary Description",
      "default": "Mouth breathing dries out your throat, causing tissues to vibrate and create snoring. Nasal breathing increases oxygen uptake by up to 20%, leading to:"
    },
    {
      "type": "textarea",
      "id": "benefits",
      "label": "Benefits (separate with |)",
      "default": "Deeper REM sleep cycles|Reduced morning fatigue|Better cognitive function|Improved immune response"
    },
    {
      "type": "richtext",
      "id": "doctor_note",
      "label": "Doctor Note",
      "default": "<p><strong>Doctor Recommended & Clinically Tested</strong> - Muzzle Sleep Strips are Doctor recommended for sleep and tested excellent for skin tolerability by Dermatest.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Join thousands who've discovered better sleep."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Order Muzzle Strips Today"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "LT Breathing Science"
    }
  ]
}
{% endschema %}