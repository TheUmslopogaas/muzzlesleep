{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round
-%}

<div class="lt-loyalty-redeem">
  <div class="page-width">
    <div class="lt-loyalty-redeem__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lt-loyalty-redeem__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lt-loyalty-redeem__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="lt-loyalty-redeem__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lt-loyalty-redeem__grid" style="--lt-cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- assign is_hl = block.settings.highlight -%}
          <div
            class="lt-loyalty-redeem__card{% if is_hl %} lt-loyalty-redeem__card--highlight{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="lt-loyalty-redeem__icon">
              {%- if block.settings.icon != blank -%}
                <img
                  class="lt-loyalty-redeem__icon-img"
                  src="{{ block.settings.icon | image_url: width: 64 }}"
                  alt="{{ block.settings.icon.alt | escape }}"
                  loading="lazy"
                  width="32"
                  height="32"
                >
              {%- else -%}
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M20.5 12.5l-8 8a1.5 1.5 0 01-2.1 0L3 13V4a1 1 0 011-1h9l7.5 7.5a1.5 1.5 0 010 2z"/>
                  <circle cx="7.5" cy="7.5" r="1.2"/>
                </svg>
              {%- endif -%}
            </div>

            {%- if block.settings.value != blank -%}
              <div class="lt-loyalty-redeem__value">{{ block.settings.value }}</div>
            {%- endif -%}
            {%- if block.settings.condition != blank -%}
              <div class="lt-loyalty-redeem__condition">{{ block.settings.condition }}</div>
            {%- endif -%}
            {%- if block.settings.points != blank -%}
              <span class="lt-loyalty-redeem__points">{{ block.settings.points }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="lt-loyalty-redeem__actions">
        <a
          href="{{ section.settings.button_link }}"
          class="lt-loyalty-redeem__button"
          {% if section.settings.open_smile %}data-lt-smile-launch{% endif %}
        >
          <span>{{ section.settings.button_label }}</span>
          {%- if section.settings.show_arrow -%}
            <svg class="lt-loyalty-redeem__arrow" viewBox="0 0 20 20" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 10h11m0 0l-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__head {
    text-align: center;
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__eyebrow {
    display: inline-block;
    padding: 7px 16px;
    margin-bottom: 20px;
    border-radius: 100px;
    background-color: {{ section.settings.eyebrow_bg_color }};
    color: {{ section.settings.eyebrow_text_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__heading {
    margin: 0 0 16px;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__subheading {
    max-width: 620px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.5;
    color: {{ section.settings.subheading_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__subheading p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__grid {
    display: grid;
    grid-template-columns: repeat(var(--lt-cols), minmax(0, 1fr));
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 18px;
    background-color: {{ section.settings.card_bg_color }};
    color: {{ section.settings.card_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__card--highlight {
    background-color: {{ section.settings.hl_bg_color }};
    border-color: {{ section.settings.hl_bg_color }};
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__icon {
    margin-bottom: 16px;
    color: {{ section.settings.icon_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__icon-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__value {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
    color: {{ section.settings.value_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__card--highlight .lt-loyalty-redeem__value {
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__condition {
    margin: 6px 0 14px;
    font-size: 14px;
    line-height: 1.4;
    color: {{ section.settings.condition_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__card--highlight .lt-loyalty-redeem__condition {
    color: {{ section.settings.hl_text_color }};
    opacity: 0.6;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__points {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 100px;
    background-color: {{ section.settings.points_bg_color }};
    color: {{ section.settings.points_text_color }};
    font-size: 13px;
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__card--highlight .lt-loyalty-redeem__points {
    background-color: rgba(255, 255, 255, 0.12);
    color: {{ section.settings.hl_text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__actions {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 34px;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-redeem__arrow {
    flex: 0 0 auto;
  }

  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__head {
      margin-bottom: 28px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__heading {
      font-size: 30px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__subheading {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__grid {
      gap: 14px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__actions {
      margin-top: 28px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__heading {
      font-size: 26px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-redeem__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function init() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;

      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (!launcher || launcher.dataset.ltBound === 'true') return;

      launcher.dataset.ltBound = 'true';

      launcher.addEventListener('click', function (e) {
        // Open the Smile.io panel if available; otherwise let the href navigate.
        if (window.SmileUI && typeof window.SmileUI.openPanel === 'function') {
          e.preventDefault();
          window.SmileUI.openPanel();
        } else if (window.smile && typeof window.smile.openPanel === 'function') {
          e.preventDefault();
          window.smile.openPanel();
        }
      });
    }

    function destroy() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;
      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (launcher) launcher.dataset.ltBound = '';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) init();
    });
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) destroy();
    });
  })();
</script>

{% schema %}
{
  "name": "LT Loyalty Redeem",
  "tag": "section",
  "class": "lt-loyalty-redeem-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5FA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rewards"
    },
    {
      "type": "color",
      "id": "eyebrow_bg_color",
      "label": "Eyebrow background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text",
      "default": "#5B4FCF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Redeem Your Points"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B4D"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Redeem for savings and perks you can use on your next Muzzle Sleep order.</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#EAEAF0"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "value_color",
      "label": "Value color",
      "default": "#1F1B4D"
    },
    {
      "type": "color",
      "id": "condition_color",
      "label": "Condition text color",
      "default": "#6B7280"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color (SVG fallback)",
      "default": "#FAC512"
    },
    {
      "type": "color",
      "id": "points_bg_color",
      "label": "Points pill background",
      "default": "#ECEAFB"
    },
    {
      "type": "color",
      "id": "points_text_color",
      "label": "Points pill text",
      "default": "#5B4FCF"
    },
    {
      "type": "header",
      "content": "Card (highlighted)"
    },
    {
      "type": "color",
      "id": "hl_bg_color",
      "label": "Highlight background",
      "default": "#1B1740"
    },
    {
      "type": "color",
      "id": "hl_text_color",
      "label": "Highlight text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (fallback)",
      "info": "Used when the Smile.io panel isn't available."
    },
    {
      "type": "checkbox",
      "id": "open_smile",
      "label": "Open Smile.io panel on click",
      "info": "Opens the Smile.io launcher instead of navigating. Falls back to the link above if the widget hasn't loaded.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#1B1740"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "reward",
      "name": "Reward",
      "settings": [
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight (dark theme)",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Leave blank to use a built-in tag icon."
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "$4 Off"
        },
        {
          "type": "text",
          "id": "condition",
          "label": "Condition",
          "default": "min. $24 order"
        },
        {
          "type": "text",
          "id": "points",
          "label": "Points",
          "default": "400 Points"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LT Loyalty Redeem",
      "blocks": [
        {
          "type": "reward",
          "settings": { "value": "$4 Off", "condition": "min. $24 order", "points": "400 Points" }
        },
        {
          "type": "reward",
          "settings": { "value": "$10 Off", "condition": "min. $40 order", "points": "1,000 Points" }
        },
        {
          "type": "reward",
          "settings": { "value": "$14 Off", "condition": "min. $74 order", "points": "1,400 Points" }
        },
        {
          "type": "reward",
          "settings": { "highlight": true, "value": "$20 Off", "condition": "min. $100 order", "points": "2,000 Points" }
        }
      ]
    }
  ]
}
{% endschema %}
