{% comment %}
  Hold Strength Selection Section
  Usage: Add this file to sections folder as hold-strength-selection.liquid
{% endcomment %}

<div class="hold-strength-section">
  {% if section.settings.heading %}
    <h2 class="main-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  {% if section.settings.subheading %}
    <p class="subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="hs-carousel">
  <div class="products-grid">
    {% for block in section.blocks %}
      <div class="product-card" {{ block.shopify_attributes }}>
        {% if block.settings.product_image %}
          <div class="product-image">
            <img src="{{ block.settings.product_image | img_url: '400x400' }}" 
                 alt="{{ block.settings.product_title }}"
                 loading="lazy">
          </div>
        {% endif %}
        
        <h3 class="product-title">{{ block.settings.product_title }}</h3>
        <p class="product-description">{{ block.settings.product_description }}</p>
      </div>
    {% endfor %}
  </div>
  <div class="hs-dots"></div>
  </div>

  {% if section.settings.recommendation_text %}
    <p class="recommendation-text">{{ section.settings.recommendation_text }}</p>
  {% endif %}

  {% if section.settings.cta_text and section.settings.cta_link %}
    <div class="cta-container">
      <a href="{{ section.settings.cta_link }}" class="cta-button">
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: 60px 20px;
  }
  #shopify-section-{{ section.id }} .hold-strength-section {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .main-heading {
    font-size: 48px;
    font-weight: 700;
    color: #2d3748;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .subheading {
    font-size: 18px;
    color: #4a5568;
    margin: 0 0 50px 0;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .products-grid {
    display: flex;
    gap: 40px;
    justify-content: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 320px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .product-image {
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .product-image img {
    width: 280px;
    height: auto;
    border-radius: 8px;
  }
  #shopify-section-{{ section.id }} .product-title {
    font-size: 28px;
    font-weight: 600;
    color: #2d3748;
    margin: 0 0 16px 0;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .product-description {
    font-size: 16px;
    color: #4a5568;
    line-height: 1.5;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .recommendation-text {
    font-size: 18px;
    color: #2d3748;
    margin: 0 0 32px 0;
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .cta-container {
    display: flex;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .cta-button {
    background-color: #4a5568;
    color: white;
    padding: 16px 32px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }
  #shopify-section-{{ section.id }} .cta-button:hover {
    background-color: #2d3748;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 40px 16px;
    }
    #shopify-section-{{ section.id }} .main-heading {
      font-size: 32px;
      margin-bottom: 8px;
    }
    #shopify-section-{{ section.id }} .subheading {
      font-size: 16px;
      margin-bottom: 32px;
    }
    #shopify-section-{{ section.id }} .products-grid {
      flex-direction: column;
      gap: 32px;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .product-image img {
      width: 240px;
    }
    #shopify-section-{{ section.id }} .product-title {
      font-size: 24px;
    }
    #shopify-section-{{ section.id }} .product-description {
      font-size: 15px;
    }
    #shopify-section-{{ section.id }} .recommendation-text {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .product-image img {
      width: 200px;
    }
    #shopify-section-{{ section.id }} .main-heading {
      font-size: 28px;
    }
    #shopify-section-{{ section.id }} .product-title {
      font-size: 22px;
    }
  }

  /* ---- Mobile carousel (only active when JS enables it) ---- */
  #shopify-section-{{ section.id }} .hs-dots {
    display: none;
  }
  #shopify-section-{{ section.id }} .hs-carousel--active {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }
  #shopify-section-{{ section.id }} .hs-carousel--active .products-grid {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0;
    margin-bottom: 0;
    position: relative;
    z-index: 1;
    transition-property: transform;
  }
  #shopify-section-{{ section.id }} .hs-carousel--active .product-card {
    flex-shrink: 0;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .hs-carousel--active .hs-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 24px 0 40px;
  }
  #shopify-section-{{ section.id }} .hs-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: #cbd5e0;
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  #shopify-section-{{ section.id }} .hs-dot--active {
    width: 24px;
    background-color: #4a5568;
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var mq = window.matchMedia('(max-width: 768px)');

    function toggleCarousel() {
      var el = document.querySelector('#shopify-section-' + sectionId + ' .hs-carousel');
      if (!el || typeof Swiper === 'undefined') return;

      if (mq.matches && !el.swiper) {
        el.classList.add('hs-carousel--active');
        new Swiper(el, {
          wrapperClass: 'products-grid',
          slideClass: 'product-card',
          slidesPerView: 1,
          centeredSlides: true,
          spaceBetween: 16,
          pagination: {
            el: el.querySelector('.hs-dots'),
            clickable: true,
            bulletClass: 'hs-dot',
            bulletActiveClass: 'hs-dot--active'
          }
        });
      } else if (!mq.matches && el.swiper) {
        el.swiper.destroy(true, true);
        el.classList.remove('hs-carousel--active');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', toggleCarousel);
    } else {
      toggleCarousel();
    }

    if (mq.addEventListener) {
      mq.addEventListener('change', toggleCarousel);
    } else {
      mq.addListener(toggleCarousel);
    }
  })();
</script>

{% schema %}
{
  "name": "LT Hold Strength",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Choose Your Hold Strength"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find Your Perfect Match"
    },
    {
      "type": "text",
      "id": "recommendation_text",
      "label": "Recommendation Text",
      "default": "Not sure which is right for you? Start with Medium Hold - it works for 85% of our customers."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Find My Perfect Strip"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Medium Hold"
        },
        {
          "type": "textarea",
          "id": "product_description",
          "label": "Product Description",
          "default": "Perfect for most users. Gentle adhesion that's comfortable for sensitive skin while effectively reducing snoring."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Hold Strength",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "product_title": "Medium Hold",
            "product_description": "Perfect for most users. Gentle adhesion that's comfortable for sensitive skin while effectively reducing snoring."
          }
        },
        {
          "type": "product",
          "settings": {
            "product_title": "Strong Hold",
            "product_description": "For those who need extra security or are active sleepers. Stronger adhesion without compromising comfort."
          }
        },
        {
          "type": "product",
          "settings": {
            "product_title": "Youth Tape",
            "product_description": "Specially designed smaller strips for children 6+ with extra-gentle adhesive safe for young, sensitive skin."
          }
        }
      ]
    }
  ]
}
{% endschema %}