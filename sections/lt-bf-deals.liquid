{%- comment -%}
  LT Black Friday Deals
  ------------------------------------------------------------------
  - One block = one deal card. Pick the bundle product; title, image and
    prices come from Shopify (block fields override title / image).
  - Add to Cart posts to /cart/add.js and opens the Rebuy Smart Cart.
  - Card click per block: Nothing (default, pointer cursor only),
    Product page, or Custom URL.
  - Layout per device: Grid, Carousel (Swiper, loaded globally) or Stack.
{%- endcomment -%}

{{ 'lt-bf-deals.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lt-bf-deals.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign sid = section.id

  assign spv_d = s.peek_d | divided_by: 100.0 | plus: s.per_row_d
  assign spv_m = s.peek_m | divided_by: 100.0 | plus: s.per_row_m

  case s.header_align
    when 'left'
      assign h_items = 'flex-start'
    else
      assign h_items = 'center'
  endcase

  case s.img_ratio
    when 'portrait'
      assign img_ratio = '4 / 5'
    when 'natural'
      assign img_ratio = 'auto'
    else
      assign img_ratio = '1 / 1'
  endcase

  assign root_classes = 'lt-bf lt-bf--d-' | append: s.layout_desktop | append: ' lt-bf--m-' | append: s.layout_mobile
  unless s.arrows_d
    assign root_classes = root_classes | append: ' lt-bf--d-noarrows'
  endunless
  unless s.arrows_m
    assign root_classes = root_classes | append: ' lt-bf--m-noarrows'
  endunless
  unless s.dots_d
    assign root_classes = root_classes | append: ' lt-bf--d-nodots'
  endunless
  unless s.dots_m
    assign root_classes = root_classes | append: ' lt-bf--m-nodots'
  endunless
  if s.show_glow
    assign root_classes = root_classes | append: ' lt-bf--glow'
  endif
  if s.card_hover
    assign root_classes = root_classes | append: ' lt-bf--hover'
  endif
  if s.title_lines > 0
    assign root_classes = root_classes | append: ' lt-bf--title-clamp'
  endif
  if s.hide_on_desktop
    assign root_classes = root_classes | append: ' lt-bf--hide-d'
  endif
  if s.hide_on_mobile
    assign root_classes = root_classes | append: ' lt-bf--hide-m'
  endif

  assign img_sizes = '(min-width: 750px) calc(min(100vw, ' | append: s.max_width | append: 'px) / ' | append: spv_d | append: '), calc(100vw / ' | append: spv_m | append: ')'
  assign visible_count = 0
-%}

{%- capture cards_html -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign p = b.product
      assign has_product = false
      if p != blank
        assign has_product = true
      endif

      assign skip = false
      assign is_placeholder = false
      if has_product == false
        if request.design_mode
          assign is_placeholder = true
        else
          assign skip = true
        endif
      elsif s.hide_sold_out and p.available == false
        assign skip = true
      endif
    -%}
    {%- if skip -%}{%- continue -%}{%- endif -%}
    {%- assign visible_count = visible_count | plus: 1 -%}

    {%- liquid
      # ---------- Subscription + gift ----------
      assign is_sub = false
      if has_product and b.subscription and p.selling_plan_groups.size > 0
        assign is_sub = true
      endif

      assign has_gift = false
      assign gift_available = true
      assign gift_price = 0
      assign gift_variant = nil
      if has_product and b.gift_product != blank
        assign gift_variant = b.gift_product.variants.first
        if gift_variant
          assign has_gift = true
          assign gift_available = gift_variant.available
          assign gift_price = gift_variant.price
        endif
      endif

      # ---------- Variant loop state ----------
      assign sel_found = false
      assign sel_variant = nil
      assign sel_available = false
      assign eligible_count = 0
      assign price_cents = 0
      assign cmp_cents = 0
      assign pct = 0
      assign save_cents = 0
    -%}
    {%- capture variants_json -%}
      {%- if has_product -%}
        {%- for v in p.variants -%}
          {%- liquid
            assign eligible = true
            assign v_plan = 'null'
            assign v_price = v.price
            if is_sub
              assign alloc = v.selling_plan_allocations.first
              if alloc
                assign v_plan = alloc.selling_plan.id
                assign v_price = alloc.price
              else
                assign eligible = false
              endif
            endif
          -%}
          {%- unless eligible -%}{%- continue -%}{%- endunless -%}
          {%- liquid
            assign v_base = v.compare_at_price | default: 0
            if is_sub and v.price > v_base
              assign v_base = v.price
            endif
            if has_gift and s.compare_include_gift
              if v_base < v.price
                assign v_base = v.price
              endif
              assign v_base = v_base | plus: gift_price
            endif
            if v_base <= v_price
              assign v_base = 0
            endif
            assign v_save = 0
            assign v_pct = 0
            if v_base > 0
              assign v_save = v_base | minus: v_price
              assign v_pct = v_save | times: 100.0 | divided_by: v_base | round
            endif
            assign v_available = v.available
            if gift_available == false
              assign v_available = false
            endif

            if sel_found == false
              assign sel_found = true
              assign sel_variant = v
              assign sel_available = v_available
              assign price_cents = v_price
              assign cmp_cents = v_base
              assign save_cents = v_save
              assign pct = v_pct
            endif
            assign eligible_count = eligible_count | plus: 1
          -%}
          {%- capture v_price_html -%}{%- render 'lt-pc-money', cents: v_price, format: s.price_format -%}{%- endcapture -%}
          {%- capture v_cmp_html -%}{%- if v_base > 0 -%}{%- render 'lt-pc-money', cents: v_base, format: s.price_format -%}{%- endif -%}{%- endcapture -%}
          {%- capture v_save_html -%}{%- if v_save > 0 -%}{%- render 'lt-pc-money', cents: v_save, format: s.price_format -%}{%- endif -%}{%- endcapture -%}
          {%- if eligible_count > 1 -%},{%- endif -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "available": {{ v_available | json }},
            "plan": {{ v_plan }},
            "price": {{ v_price_html | strip | json }},
            "compare": {{ v_cmp_html | strip | json }},
            "save": {{ v_save_html | strip | json }},
            "pct": {{ v_pct }},
            "img": {%- if v.featured_image and b.image == blank -%}{{ v.featured_image | image_url: width: 1000 | json }}{%- else -%}null{%- endif -%}
          }
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- liquid
      if has_product and sel_found == false
        # Subscription is on but no variant has a plan: show the card as unavailable
        assign sel_variant = p.variants.first
        assign sel_available = false
        assign price_cents = sel_variant.price
      endif

      assign show_dd = false
      if b.show_variant_select and eligible_count > 1
        assign show_dd = true
      endif

      # ---------- Title ----------
      assign card_title = b.title
      if card_title == blank and has_product
        assign card_title = p.title
        assign strip_parts = s.title_strip | split: '|'
        for part in strip_parts
          assign part_clean = part | strip
          if part_clean != blank
            assign card_title = card_title | remove_first: part_clean
          endif
        endfor
        assign card_title = card_title | strip
      endif
      if is_placeholder
        assign card_title = 'Select a product'
      endif

      # ---------- Image ----------
      assign img = b.image
      if img == blank and has_product
        assign img = sel_variant.featured_image | default: p.featured_image
      endif
      assign img_alt = img.alt | default: card_title | strip_html

      # ---------- Badge ----------
      assign badge_text = b.badge_text | strip
      assign badge_is_auto = false
      if badge_text == blank and s.show_save_badge and pct > 0
        assign badge_is_auto = true
      endif

      # ---------- Click behavior ----------
      assign card_url = ''
      case b.click_action
        when 'pdp'
          if has_product
            assign card_url = p.url
          endif
        when 'custom'
          assign card_url = b.custom_url
      endcase
      assign link_attrs = ''
      if b.new_tab
        assign link_attrs = ' target="_blank" rel="noopener"'
      endif

      assign atc_label = b.button_label | default: s.atc_label
    -%}
    {%- if has_product -%}
      {%- capture price_html -%}{%- render 'lt-pc-money', cents: price_cents, format: s.price_format -%}{%- endcapture -%}
      {%- capture cmp_html -%}{%- if cmp_cents > 0 -%}{%- render 'lt-pc-money', cents: cmp_cents, format: s.price_format -%}{%- endif -%}{%- endcapture -%}
      {%- capture save_html -%}{%- if save_cents > 0 -%}{%- render 'lt-pc-money', cents: save_cents, format: s.price_format -%}{%- endif -%}{%- endcapture -%}
    {%- else -%}
      {%- assign price_html = '' -%}
      {%- assign cmp_html = '' -%}
      {%- assign save_html = '' -%}
    {%- endif -%}

    <div class="swiper-slide lt-bf__slide">
      <article
        class="lt-bf__card{% if is_placeholder %} lt-bf__card--placeholder{% endif %}{% if card_url != blank %} lt-bf__card--linked{% endif %}"
        aria-label="{{ card_title | strip_html | escape }}"
        {% if has_product %}
          data-lt-bf-card
          data-variant-id="{{ sel_variant.id }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- capture media_inner -%}
          <span class="lt-bf__media-frame">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1000
                | image_tag:
                  widths: '300, 450, 600, 800, 1000',
                  sizes: img_sizes,
                  loading: 'lazy',
                  alt: img_alt,
                  class: 'lt-bf__img',
                  draggable: 'false'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'lt-bf__img lt-bf__img--placeholder' }}
            {%- endif -%}
          </span>
          {%- if badge_text != blank -%}
            <span class="lt-bf__badge">{{ badge_text | escape }}</span>
          {%- elsif badge_is_auto -%}
            <span class="lt-bf__badge" data-lt-bf-badge>
              {{- s.save_badge_text | replace: '[percent]', pct | replace: '[amount]', save_html | escape -}}
            </span>
          {%- elsif has_product and s.show_save_badge -%}
            <span class="lt-bf__badge" data-lt-bf-badge hidden></span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if card_url != blank -%}
          <a class="lt-bf__media" href="{{ card_url }}"{{ link_attrs }} tabindex="-1" aria-hidden="true">{{ media_inner }}</a>
        {%- else -%}
          <div class="lt-bf__media">{{ media_inner }}</div>
        {%- endif -%}

        <div class="lt-bf__body">
          {%- if b.highlight != blank -%}
            <span class="lt-bf__highlight">{{ b.highlight | escape }}</span>
          {%- endif -%}

          {%- if card_title != blank -%}
            <h3 class="lt-bf__title">
              {%- if card_url != blank -%}
                <a href="{{ card_url }}"{{ link_attrs }}>{{ card_title | escape }}</a>
              {%- else -%}
                {{- card_title | escape -}}
              {%- endif -%}
            </h3>
          {%- endif -%}

          {%- if price_html != blank -%}
            <div class="lt-bf__price" data-lt-bf-price-wrap>
              <span class="lt-bf__price-current">
                <span data-lt-bf-price>{{ price_html | escape }}</span>
                {%- if is_sub and s.sub_suffix != blank -%}
                  <span class="lt-bf__price-suffix">{{ s.sub_suffix | escape }}</span>
                {%- endif -%}
              </span>
              {%- if s.show_compare_at -%}
                <s class="lt-bf__price-compare" data-lt-bf-compare {% if cmp_html == blank %}hidden{% endif %}>{{ cmp_html | escape }}</s>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if is_sub and s.sub_note != blank -%}
            <p class="lt-bf__subnote">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M17 2l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 11V10a4 4 0 0 1 4-4h14M7 22l-4-4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 13v1a4 4 0 0 1-4 4H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ s.sub_note | escape }}</span>
            </p>
          {%- endif -%}

          {%- if has_product -%}
            <div class="lt-bf__footer">
              {%- if show_dd -%}
                <div class="lt-bf__dd" data-lt-bf-dd>
                  <button
                    type="button"
                    class="lt-bf__dd-btn"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="lt-bf-dd-{{ block.id }}"
                    aria-label="{{ card_title | escape }}: {{ sel_variant.title | escape }}"
                    data-lt-bf-dd-btn
                  >
                    <span class="lt-bf__dd-value" data-lt-bf-dd-value>{{ sel_variant.title | escape }}</span>
                    <svg class="lt-bf__dd-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <ul class="lt-bf__dd-menu" id="lt-bf-dd-{{ block.id }}" role="listbox" tabindex="-1" hidden data-lt-bf-dd-menu>
                    {%- for v in p.variants -%}
                      {%- if is_sub and v.selling_plan_allocations.size == 0 -%}{%- continue -%}{%- endif -%}
                      {%- liquid
                        assign opt_available = v.available
                        if gift_available == false
                          assign opt_available = false
                        endif
                      -%}
                      <li
                        class="lt-bf__dd-option"
                        role="option"
                        tabindex="-1"
                        data-value="{{ v.id }}"
                        aria-selected="{% if v.id == sel_variant.id %}true{% else %}false{% endif %}"
                        {% unless opt_available %}aria-disabled="true"{% endunless %}
                      >
                        <span>{{ v.title | escape }}</span>
                        {%- unless opt_available -%}<span class="lt-bf__dd-soldout">{{ s.sold_out_label | escape }}</span>{%- endunless -%}
                        <svg class="lt-bf__dd-check" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              <button
                type="button"
                class="lt-bf__btn"
                data-lt-bf-atc
                data-label="{{ atc_label | escape }}"
                {% unless sel_available %}disabled{% endunless %}
              >
                <span class="lt-bf__spinner" aria-hidden="true"></span>
                <span data-lt-bf-btn-text>
                  {%- if sel_available -%}{{ atc_label | escape }}{%- else -%}{{ s.sold_out_label | escape }}{%- endif -%}
                </span>
              </button>
              <p class="lt-bf__error" role="alert" data-lt-bf-error hidden></p>
            </div>

            <script type="application/json" data-lt-bf-data>
              {
                "gift": {%- if has_gift -%}{ "id": {{ gift_variant.id }}, "note": {{ b.gift_note | strip | json }} }{%- else -%}null{%- endif -%},
                "variants": [{{ variants_json }}]
              }
            </script>
          {%- endif -%}
        </div>
      </article>
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- if visible_count > 0 or request.design_mode -%}
  <style>
    #lt-bf-{{ sid }} {
      --bf-bg-1: {{ s.bg_color_1 }}; --bf-bg-2: {{ s.bg_color_2 }};
      --bf-glow-1: {{ s.glow_color_1 }}; --bf-glow-2: {{ s.glow_color_2 }};
      --max-w: {{ s.max_width }}px;
      --pt-d: {{ s.pt_d }}px; --pb-d: {{ s.pb_d }}px; --pt-m: {{ s.pt_m }}px; --pb-m: {{ s.pb_m }}px;
      --px-d: {{ s.px_d }}px; --px-m: {{ s.px_m }}px;

      --eb-bg: {{ s.eyebrow_bg }}; --eb-color: {{ s.eyebrow_color }}; --eb-border: {{ s.eyebrow_border }};
      --h-size-d: {{ s.heading_size_d }}px; --h-size-m: {{ s.heading_size_m }}px;
      --h-color: {{ s.heading_color }}; --hl-bg: {{ s.highlight_bg }}; --hl-color: {{ s.highlight_color }};
      --h-align: {{ s.header_align }}; --h-items: {{ h_items }};
      --sdesc-color: {{ s.description_color }};
      --header-gap-d: {{ s.header_gap_d }}px; --header-gap-m: {{ s.header_gap_m }}px;

      --cols-d: {{ s.per_row_d }}; --cols-m: {{ s.per_row_m }};
      --spv-d: {{ spv_d }}; --spv-m: {{ spv_m }};
      --gap-d: {{ s.gap_d }}px; --gap-m: {{ s.gap_m }}px;
      --row-gap-d: {{ s.row_gap_d }}px; --row-gap-m: {{ s.row_gap_m }}px;
      --stack-max-w: {{ s.stack_max_width }}px; --stack-img-w: {{ s.stack_img_width }}%;

      --card-bg: {{ s.card_bg }}; --card-border-1: {{ s.card_border_1 }}; --card-border-2: {{ s.card_border_2 }};
      --card-glow: {{ s.card_glow }};
      --card-radius: {{ s.card_radius }}px; --card-pad-d: {{ s.card_pad_d }}px; --card-pad-m: {{ s.card_pad_m }}px;
      --img-ratio: {{ img_ratio }}; --img-radius: {{ s.img_radius }}px;
      --card-cursor: {{ s.card_cursor }};

      --t-size-d: {{ s.title_size_d }}px; --t-size-m: {{ s.title_size_m }}px;
      --t-color: {{ s.title_color }}; --t-lines: {{ s.title_lines }};
      --hlt-bg: {{ s.card_highlight_bg }}; --hlt-color: {{ s.card_highlight_color }};

      --p-size-d: {{ s.price_size_d }}px; --p-size-m: {{ s.price_size_m }}px;
      --p-color: {{ s.price_color }}; --cmp-color: {{ s.compare_color }}; --cmp-line: {{ s.compare_line_color }};

      --badge-bg: {{ s.badge_bg }}; --badge-color: {{ s.badge_color }};
      --badge-left: {% if s.badge_position == 'top-right' %}auto{% else %}12px{% endif %};
      --badge-right: {% if s.badge_position == 'top-right' %}12px{% else %}auto{% endif %};

      --btn-h-d: {{ s.btn_h_d }}px; --btn-h-m: {{ s.btn_h_m }}px;
      --btn-size-d: {{ s.btn_size_d }}px; --btn-size-m: {{ s.btn_size_m }}px;
      --btn-radius: {{ s.btn_radius }}px;
      --btn-bg: {{ s.btn_bg }}; --btn-color: {{ s.btn_color }};
      --btn-bg-h: {{ s.btn_bg_hover }}; --btn-color-h: {{ s.btn_color_hover }};

      --dd-bg: {{ s.dd_bg }}; --dd-border: {{ s.dd_border }}; --dd-color: {{ s.dd_color }};
      --dd-menu-bg: {{ s.dd_menu_bg }}; --dd-active-bg: {{ s.dd_active_bg }}; --dd-active-color: {{ s.dd_active_color }};
      --subnote-color: {{ s.sub_note_color }};

      --arrow-color: {{ s.arrow_color }}; --arrow-bg: {{ s.arrow_bg }};
      --swiper-pagination-color: {{ s.dot_color }};
      --swiper-pagination-bullet-inactive-color: {{ s.dot_inactive_color }};
      --swiper-pagination-bullet-inactive-opacity: 1;
    }
  </style>

  <div
    id="lt-bf-{{ sid }}"
    class="{{ root_classes }}"
    data-lt-bf
  >
    {%- if s.anchor_id != blank -%}
      <span id="{{ s.anchor_id | handleize }}" class="lt-bf__anchor" aria-hidden="true"></span>
    {%- endif -%}
    <div class="lt-bf__inner">
      {%- if s.eyebrow != blank or s.heading != blank or s.description != blank -%}
        <div class="lt-bf__header">
          {%- if s.eyebrow != blank -%}
            <span class="lt-bf__eyebrow">{{ s.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <{{ s.heading_tag }} class="lt-bf__heading">{{ s.heading }}</{{ s.heading_tag }}>
          {%- endif -%}
          {%- if s.description != blank -%}
            <div class="lt-bf__sdesc rte">{{ s.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if visible_count > 0 -%}
        <div class="lt-bf__stage">
          <button type="button" class="lt-bf__arrow lt-bf__arrow--prev" aria-label="Previous deals">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="swiper lt-bf__swiper">
            <div class="swiper-wrapper lt-bf__track">
              {{ cards_html }}
            </div>
          </div>
          <button type="button" class="lt-bf__arrow lt-bf__arrow--next" aria-label="Next deals">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="lt-bf__dots"></div>
        </div>
      {%- else -%}
        <div class="lt-bf__empty">Add a <strong>Deal card</strong> block and pick a bundle product.</div>
      {%- endif -%}
    </div>

    <script type="application/json" data-lt-bf-config>
      {
        "desktop": {
          "layout": {{ s.layout_desktop | json }},
          "perView": {{ s.per_row_d }},
          "peek": {{ s.peek_d }},
          "gap": {{ s.gap_d }},
          "arrows": {{ s.arrows_d | json }},
          "dots": {{ s.dots_d | json }}
        },
        "mobile": {
          "layout": {{ s.layout_mobile | json }},
          "perView": {{ s.per_row_m }},
          "peek": {{ s.peek_m }},
          "gap": {{ s.gap_m }},
          "arrows": {{ s.arrows_m | json }},
          "dots": {{ s.dots_m | json }}
        },
        "loop": {{ s.loop | json }},
        "autoplay": {{ s.autoplay | json }},
        "autoplayDelay": {{ s.autoplay_delay | times: 1000 | round }},
        "showCompare": {{ s.show_compare_at | json }},
        "showSaveBadge": {{ s.show_save_badge | json }},
        "saveBadge": {{ s.save_badge_text | json }},
        "openCart": {{ s.open_cart | json }},
        "propKey": {{ s.prop_key | strip | json }},
        "propValue": {{ s.prop_value | strip | json }},
        "giftKey": {{ s.gift_note_key | strip | json }},
        "labels": {
          "adding": {{ s.adding_label | json }},
          "added": {{ s.added_label | json }},
          "soldout": {{ s.sold_out_label | json }},
          "error": {{ s.error_label | json }}
        }
      }
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "LT BF Deals",
  "tag": "section",
  "class": "lt-bf-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "Heading" },
