  place-items:center;
  margin-bottom: 12px;
  {% comment %} border:1px solid rgba(37,99,235,.10) {% endcomment %}
}
.lt-promise-t{
  margin:0;
  font-size:12.5px;
  font-weight:900;
  line-height:1.2;
  color:#0f172a
}
@media (max-width:990px){
  .lt-promise{grid-template-columns:repeat(2,1fr);gap:14px}
}
