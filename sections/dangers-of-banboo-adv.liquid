/* =========================================================
   LAB TABLES (CHEMICAL + MEDICAL)
   ========================================================= */
.lt-lab{
  margin:12px 0 0;
  border:1px solid #e5e7eb;
  border-radius:16px;
  overflow:hidden;
  background:#f6f7f8
}
.lt-lab-head{
  display:grid;
  grid-template-columns:1fr 1fr;
  padding:14px 16px 10px;
  background:#fff;
  border-bottom:1px solid #eceff3
}
.lt-lab-head div{
  font-size:12px;
  font-weight:900;
  letter-spacing:.06em;
  color:#1d4ed8;
  text-transform:uppercase
}
.lt-lab-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  padding:14px 16px;
  border-top:1px solid #eceff3
}
.lt-lab-row:nth-child(2n){background:#f1f2f4}
.lt-lab-left{
  font-size:13.5px;
  font-weight:800;
  line-height:1.35;
  color:#0f172a
}
.lt-lab-right{
  display:flex;
  flex-direction:column;
  gap:8px
}
.lt-lab-item{
  display:flex;
  align-items:flex-start;
  gap:8px;
  font-size:13.5px;
  font-weight:700;
  color:#0f172a
}
.lt-ok{
  width:16px;
  height:16px;
  border-radius:999px;
  background:#22c55e;
  display:grid;
  place-items:center;
  margin-top:1px
}
@media (max-width:720px){
  .lt-lab-head{grid-template-columns:1fr}
  .lt-lab-head div:last-child{display:none}
  .lt-lab-row{grid-template-columns:1fr}

  .lt-h1{
    font-size: 25px;
  }
  .lt-h2{
    font-size: 20px;
  }
  .lt-lab-left{
    margin-bottom: 15px;
  }
}

/* =========================================================
   PROMISE ICON ROW
   ========================================================= */
.lt-promise{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
  margin:14px 0 0
}
.lt-promise-item {
    text-align: left;
    background: #F5F6FF;
    padding: 20px;
}
.lt-promise-ic{
  width:44px;
  height:44px;
  {% comment %} border-radius:14px; {% endcomment %}
