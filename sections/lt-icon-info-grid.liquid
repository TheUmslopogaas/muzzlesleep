  <style>
    #lt-icon-info-grid-{{ section.id }} .lt-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
      text-align: center;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-heading {
      font-size: 42px;
      font-weight: 700;
      color: #27214D;
      margin: 0 0 16px 0;
      line-height: 1.2;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-subheading {
      font-size: 16px;
      color: #0F0F10;
      letter-spacing: 0px;
      margin: 0 auto 40px;
      line-height: 1;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 32px;
      padding: 0;
      list-style: none;
      margin: 0;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: calc(25% - 24px);
      min-width: 240px;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-figure {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 0 16px 0;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-icon {
      width: 100px;
      height: 100px;
      /* object-fit: contain; */
      display: block;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-item-title {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin: 0 0 8px 0;
      text-transform: uppercase;
      color: #27214D;
    }
    #lt-icon-info-grid-{{ section.id }} .lt-item-text {
      font-size: 14px;
      color: #0F0F10;
      letter-spacing: 0.5px;
      margin: 0 0 40px;
      line-height: 1.3;
      font-weight: 500;
    }

    /* Responsive (desktop-first) */
    @media (max-width: 1024px) {
      #lt-icon-info-grid-{{ section.id }} .lt-item { width: calc(33.333% - 22px); }
    }
    @media (max-width: 860px) {
      #lt-icon-info-grid-{{ section.id }} .lt-item { width: calc(50% - 16px); }
      #lt-icon-info-grid-{{ section.id }} .lt-heading { font-size: 32px;}
    }
    @media (max-width: 480px) {
      #lt-icon-info-grid-{{ section.id }} .lt-item { width: 100%; }
      #lt-icon-info-grid-{{ section.id }} .lt-container { padding: 40px 16px; }
      #lt-icon-info-grid-{{ section.id }} .lt-heading { font-size: 28px;}
    }
  </style>

<section class="lt-icon-info-grid-wrap" id="lt-icon-info-grid-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lt-container">
    {% if section.settings.heading != blank %}
      <header class="lt-header">
        <h2 class="lt-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="lt-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <ul class="lt-grid" role="list">
      {% for block in section.blocks %}
        <li class="lt-item" role="listitem" {{ block.shopify_attributes }}>
          <figure class="lt-figure">
            {% if block.settings.icon != blank %}
              <img class="lt-icon" src="{{ block.settings.icon | img_url: '200x200' }}" alt="{{ block.settings.title | escape }}" width="80" height="80" loading="lazy">
            {% else %}
              <img class="lt-icon" src="https://images.unsplash.com/photo-1526256262350-7da7584cf5eb?w=200&h=200&fit=crop" alt="{{ block.settings.title | escape }}" width="80" height="80" loading="lazy">
            {% endif %}
          </figure>
          {% if block.settings.title != blank %}
            <h3 class="lt-item-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="lt-item-text">{{ block.settings.text }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "LT Icon Info Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Replace Your Entire Supplement Stack With One Natural Solution"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Treasured for ages and backed by research, beef liver is nature's ultimate nutrient source."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Energy & Body"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "B vitamins and iron support natural energy production."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LT Icon Info Grid",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Energy & Body"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Hormone Health",
            "text": "Key nutrients like vitamin A and zinc support balanced hormone production."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Immunity",
            "text": "Promotes smooth, clear skin and thick, healthy hair growth."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Gut Health",
            "text": "Supports healthy digestion and a balanced, thriving gut microbiome."
          }
        }
      ]
    }
  ]
}
{% endschema %}
