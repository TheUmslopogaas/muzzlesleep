{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round
-%}

<div class="lt-loyalty-referral">
  <div class="page-width">
    <div class="lt-loyalty-referral__card">
      <div class="lt-loyalty-referral__bg">
        {%- if section.settings.background_image != blank -%}
          <img
            class="lt-loyalty-referral__bg-img lt-loyalty-referral__bg-img--desktop"
            src="{{ section.settings.background_image | image_url }}"
            alt="{{ section.settings.background_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
          >
        {%- endif -%}
        {%- if section.settings.background_image_mobile != blank -%}
          <img
            class="lt-loyalty-referral__bg-img lt-loyalty-referral__bg-img--mobile"
            src="{{ section.settings.background_image_mobile | image_url }}"
            alt="{{ section.settings.background_image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.background_image_mobile.width }}"
            height="{{ section.settings.background_image_mobile.height }}"
          >
        {%- endif -%}
        {%- if section.settings.background_image == blank and section.settings.background_image_mobile == blank -%}
          <div class="lt-loyalty-referral__bg-placeholder"></div>
        {%- endif -%}
        <div class="lt-loyalty-referral__gradient"></div>
      </div>

      <div class="lt-loyalty-referral__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lt-loyalty-referral__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="lt-loyalty-referral__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="lt-loyalty-referral__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank -%}
          <div class="lt-loyalty-referral__stats">
            {%- if section.settings.stat_1_value != blank -%}
              <div class="lt-loyalty-referral__stat lt-loyalty-referral__stat--accent">
                {%- if section.settings.stat_1_eyebrow != blank -%}
                  <span class="lt-loyalty-referral__stat-eyebrow">{{ section.settings.stat_1_eyebrow }}</span>
                {%- endif -%}
                <span class="lt-loyalty-referral__stat-value">{{ section.settings.stat_1_value }}</span>
                {%- if section.settings.stat_1_label != blank -%}
                  <span class="lt-loyalty-referral__stat-label">{{ section.settings.stat_1_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.stat_2_value != blank -%}
              <div class="lt-loyalty-referral__stat">
                {%- if section.settings.stat_2_eyebrow != blank -%}
                  <span class="lt-loyalty-referral__stat-eyebrow">{{ section.settings.stat_2_eyebrow }}</span>
                {%- endif -%}
                <span class="lt-loyalty-referral__stat-value">{{ section.settings.stat_2_value }}</span>
                {%- if section.settings.stat_2_label != blank -%}
                  <span class="lt-loyalty-referral__stat-label">{{ section.settings.stat_2_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="lt-loyalty-referral__button"
            {% if section.settings.open_smile %}data-lt-smile-launch{% endif %}
          >
            <span>{{ section.settings.button_label }}</span>
            {%- if section.settings.show_arrow -%}
              <svg class="lt-loyalty-referral__arrow" viewBox="0 0 20 20" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 10h11m0 0l-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__card {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__bg-img--mobile {
    display: none;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(120deg, #27214D 0%, #4a3f7d 100%);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      {{ section.settings.gradient_angle }}deg,
      {{ section.settings.gradient_color }} 0%,
      {{ section.settings.gradient_color }}00 100%
    );
    opacity: {{ section.settings.gradient_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    padding: 64px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__eyebrow {
    display: inline-block;
    padding: 8px 18px;
    margin-bottom: 24px;
    border-radius: 100px;
    background-color: {{ section.settings.eyebrow_bg_color }};
    color: {{ section.settings.eyebrow_text_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__heading {
    margin: 0 0 20px;
    font-size: 48px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -1px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__description {
    max-width: 480px;
    margin-bottom: 32px;
    font-size: 17px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__description p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    padding: 20px 24px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat--accent {
    border-color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    opacity: 0.55;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat-value {
    margin: 6px 0 4px;
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat--accent .lt-loyalty-referral__stat-value {
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__stat-label {
    font-size: 13px;
    line-height: 1.35;
    color: {{ section.settings.text_color }};
    opacity: 0.65;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 17px 34px;
    border-radius: 100px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }
  #shopify-section-{{ section.id }} .lt-loyalty-referral__arrow {
    flex: 0 0 auto;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-referral__card {
      align-items: flex-start;
      min-height: {{ section.settings.min_height_mobile }}px;
    }

    {%- if section.settings.background_image_mobile != blank -%}
      #shopify-section-{{ section.id }} .lt-loyalty-referral__bg-img--desktop {
        display: none;
      }
      #shopify-section-{{ section.id }} .lt-loyalty-referral__bg-img--mobile {
        display: block;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .lt-loyalty-referral__gradient {
      background: linear-gradient(
        180deg,
        {{ section.settings.gradient_color }} 0%,
        {{ section.settings.gradient_color }}00 100%
      );
    }
    #shopify-section-{{ section.id }} .lt-loyalty-referral__content {
      max-width: 100%;
      padding: 40px 28px {{ section.settings.mobile_content_bottom_padding }}px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-referral__heading {
      font-size: 34px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-referral__description {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .lt-loyalty-referral__stat {
      flex: 1 1 100%;
      min-width: 0;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-loyalty-referral__heading {
      font-size: 28px;
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function init() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;

      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (!launcher || launcher.dataset.ltBound === 'true') return;

      launcher.dataset.ltBound = 'true';

      launcher.addEventListener('click', function (e) {
        // Open the Smile.io panel if available; otherwise let the href navigate.
        if (window.SmileUI && typeof window.SmileUI.openPanel === 'function') {
          e.preventDefault();
          window.SmileUI.openPanel();
        } else if (window.smile && typeof window.smile.openPanel === 'function') {
          e.preventDefault();
          window.smile.openPanel();
        }
      });
    }

    function destroy() {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;
      var launcher = root.querySelector('[data-lt-smile-launch]');
      if (launcher) launcher.dataset.ltBound = '';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) init();
    });
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === sectionId) destroy();
    });
  })();
</script>

{% schema %}
{
  "name": "LT Loyalty Referral",
  "tag": "section",
  "class": "lt-loyalty-referral-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (stat)",
      "default": "#D9A441"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "header",
      "content": "Gradient overlay"
    },
    {
      "type": "color",
      "id": "gradient_color",
      "label": "Gradient color",
      "info": "Fades to transparent.",
      "default": "#27214D"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 90
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 95
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_content_bottom_padding",
      "label": "Mobile content bottom padding",
      "info": "Pushes text up so the background image shows below it.",
      "min": 40,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Referral Program"
    },
    {
      "type": "color",
      "id": "eyebrow_bg_color",
      "label": "Eyebrow background",
      "default": "#3A3268"
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text",
      "default": "#C1BBE6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Share Sleep. Earn More."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Refer a friend and both of you earn points. The more people you introduce to better sleep, the more rewards you unlock — no limit on referrals.</p>"
    },
    {
      "type": "header",
      "content": "Stat 1 (accent)"
    },
    {
      "type": "text",
      "id": "stat_1_eyebrow",
      "label": "Eyebrow",
      "default": "You Earn"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Value",
      "default": "400 pts"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Label",
      "default": "after friend's order is fulfilled"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_eyebrow",
      "label": "Eyebrow",
      "default": "Friend Gets"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Value",
      "default": "$4 off"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "first order of $34 or more"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Your Referral Link"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (fallback)",
      "info": "Used when the Smile.io panel isn't available."
    },
    {
      "type": "checkbox",
      "id": "open_smile",
      "label": "Open Smile.io panel on click",
      "info": "Opens the Smile.io launcher instead of navigating. Falls back to the link above if the widget hasn't loaded.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1F1B4D"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "LT Loyalty Referral"
    }
  ]
}
{% endschema %}
