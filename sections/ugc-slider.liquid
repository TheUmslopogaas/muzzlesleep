{%- assign _ss = section.settings -%}
{%- assign _section = section.id | split: '__' | last | slice: -4, 4 | prepend: '#ugc_slider_' -%}
{%- assign _this = section.id | prepend: '#shopify-section-' -%}

{%- capture section_content -%}
<style>
    {{ _section }} {
        position: relative;
        background: {{ _ss.background }};
        padding-top: {{ _ss.padding_top }}px;
        padding-bottom: {{ _ss.padding_bottom }}px;
    }

    {{ _section }} .section_holder {
        position: relative;
        max-width: {{ _ss.max_with }}px;
        margin: auto;
        padding: 0px;
    }

    {{ _section }} .ugc_image_wrapper {
        position: relative;
        padding-top: 100%;
        overflow: hidden;
        border-radius: 12px;
    }

    {{ _section }} .ugc_image_wrapper img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media screen and (max-width: 900px) {
        {{ _section }} {
            padding-top: {{ _ss.padding_top_mobile }}px;
            padding-bottom: {{ _ss.padding_bottom_mobile }}px;
        }
        
        {{ _section }} .section_holder {
            padding: 0px;
        }

        {{ _section }} .for_desktop {
            display: none !important;
        }
    }

    @media screen and (min-width: 901px) {
        {{ _section }} .for_mobile {
            display: none !important;
        }
    }
    

</style>


<div id="ugc_slider_{{ section.id | split: '__' | last | slice: -4, 4 }}">
    <div class="section_holder">
        <div class="swiper">
            <div class="swiper-wrapper">
                {% for ii in (1..3) %}
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            <div class="ugc_image_wrapper">
                                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="ugc image {{ forloop.index }}">
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
    var ugc_slider = new Swiper('{{ _section }} .swiper', {
        spaceBetween: 12,
        speed: 300,
        centeredSlides: false,
        loop: true,
        watchSlidesProgress: true,
        breakpoints: {
            320: {
                slidesPerView: 1.8
            },
            768: {
                centeredSlides: false,
                slidesPerView: 3.8
            },
            1024: {
                centeredSlides: false,
                slidesPerView: 5.4
            },
            1800: {
                centeredSlides: false,
                slidesPerView: 7.2
            }
        }
    });
</script>

{%- endcapture -%}

{{- section_content -}}

{% schema %}
    {
        "name": "UGC Slider",
        "settings": [
            {
                "type": "header",
                "content": "General Settings"
            },
            {
                "type": "color_background",
                "id": "background",
                "label": "Background color",
                "default": "#FFFFFF00"
            },
            {
                "type": "number",
                "id": "max_with",
                "label": "Max width",
                "default": 1500
            },
            {
                "type": "range",
                "id": "padding_top",
                "label": "Desktop padding top",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "label": "Desktop padding bottom",
                "min": 0,
                "max": 300,
                "step": 5,
                "default": 100
            },
            {
                "type": "range",
                "id": "padding_top_mobile",
                "label": "Mobile padding top",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            },
            {
                "type": "range",
                "id": "padding_bottom_mobile",
                "label": "Mobile padding bottom",
                "min": 0,
                "max": 200,
                "step": 5,
                "default": 50
            }
        ],
        "blocks": [
            {
                "type": "image",
                "name": "Image",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    }
                ]
            }
        ],
        "presets": [{
            "name": "UGC Slider"
        }]
    }
{% endschema %}

