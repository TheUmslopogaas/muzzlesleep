{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign pt_m = pt | times: 0.6 | round
  assign pb_m = pb | times: 0.6 | round
  assign mt_m = mt | times: 0.6 | round
  assign mb_m = mb | times: 0.6 | round

  assign card_bg = section.settings.card_background | default: '#cf8590'
  assign has_overlay = false
  if section.settings.overlay_title != blank or section.settings.overlay_image != blank
    assign has_overlay = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    margin-top: {{ mt }}px;
    margin-bottom: {{ mb }}px;
  }

  #shopify-section-{{ section.id }} .lt-pcta,
  #shopify-section-{{ section.id }} .lt-pcta *,
  #shopify-section-{{ section.id }} .lt-pcta *::before,
  #shopify-section-{{ section.id }} .lt-pcta *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .lt-pcta {
    font-family: Inter, var(--font-body-family), sans-serif;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .lt-pcta__inner.page-width {
    max-width: 1440px;
    padding: 0 106px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 22px;
    max-width: 1228px;
    margin: 0 auto;
  }

  /* Left card */
  #shopify-section-{{ section.id }} .lt-pcta__card {
    padding: 48px;
    border: 3px solid rgba(255, 255, 255, 0.45);
    border-radius: 60px;
    background: {{ card_bg }};
    color: {{ section.settings.card_text_color }};
  }

  #shopify-section-{{ section.id }} .lt-pcta__eyebrow {
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .lt-pcta__heading {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 48px;
    font-weight: 600;
    line-height: 62px;
    letter-spacing: -1px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__body {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__body p {
    margin: 0 0 29px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__body p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .lt-pcta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    margin-top: 48px;
    padding: 0 40px;
    border-radius: 100px;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .lt-pcta__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
  }

  #shopify-section-{{ section.id }} .lt-pcta__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  /* Right card */
  #shopify-section-{{ section.id }} .lt-pcta__visual {
    position: relative;
    min-height: 100%;
    border: 3px solid rgba(190, 190, 190, 0.7);
    border-radius: 60px;
    overflow: hidden;
    background-color: #e9dfe0;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .lt-pcta__image {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .lt-pcta__image img,
  #shopify-section-{{ section.id }} .lt-pcta__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .lt-pcta__image svg {
    fill: rgba(0, 0, 0, 0.18);
  }

  /* Overlay product card */
  #shopify-section-{{ section.id }} .lt-pcta__overlay {
    position: absolute;
    right: 22px;
    bottom: 22px;
    left: 22px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 30px 24px 34px;
    border-radius: 28px;
    background-color: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} a.lt-pcta__overlay:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14);
  }

  #shopify-section-{{ section.id }} a.lt-pcta__overlay:focus-visible {
    outline: 3px solid {{ section.settings.button_text_color }};
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__thumb {
    flex: 0 0 auto;
    width: 80px;
    height: 80px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__thumb img,
  #shopify-section-{{ section.id }} .lt-pcta__thumb svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .lt-pcta__thumb svg {
    fill: rgba(0, 0, 0, 0.15);
  }

  #shopify-section-{{ section.id }} .lt-pcta__info {
    flex: 1 1 auto;
    min-width: 0;
    padding-right: 16px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__ptitle {
    display: block;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
  }

  #shopify-section-{{ section.id }} .lt-pcta__ptext {
    display: -webkit-box;
    margin: 10px 0 0;
    overflow: hidden;
    font-size: 12px;
    font-weight: 400;
    line-height: 17px;
    opacity: 0.68;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  #shopify-section-{{ section.id }} .lt-pcta__arrow {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .lt-pcta__inner.page-width {
      padding: 0 40px;
    }
  }

  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .lt-pcta__card {
      padding: 36px 32px;
      border-radius: 44px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__visual {
      border-radius: 44px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__heading {
      font-size: 36px;
      line-height: 46px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__body {
      margin-top: 22px;
      font-size: 16px;
      line-height: 26px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__body p {
      margin-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__button {
      margin-top: 36px;
      padding: 0 28px;
      min-height: 52px;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__overlay {
      right: 14px;
      bottom: 14px;
      left: 14px;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 22px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__thumb {
      width: 60px;
      height: 60px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__info {
      padding-right: 0;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ pt_m }}px;
      padding-bottom: {{ pb_m }}px;
      margin-top: {{ mt_m }}px;
      margin-bottom: {{ mb_m }}px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__inner.page-width {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__card {
      padding: 36px 28px 40px;
      border-width: 2px;
      border-radius: 36px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__eyebrow {
      margin-bottom: 14px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__heading {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -0.6px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__body {
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__body p {
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__button {
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__visual {
      min-height: 0;
      aspect-ratio: 1 / 1;
      border-width: 2px;
      border-radius: 36px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .lt-pcta__inner.page-width {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__card {
      padding: 32px 24px 36px;
      border-radius: 28px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__heading {
      font-size: 28px;
      line-height: 36px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__body {
      font-size: 15px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__button {
      display: flex;
      width: 100%;
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__visual {
      aspect-ratio: 4 / 5;
      border-radius: 28px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__overlay {
      right: 10px;
      bottom: 10px;
      left: 10px;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 18px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__thumb {
      width: 52px;
      height: 52px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__ptitle {
      font-size: 14px;
      line-height: 18px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__ptext {
      margin-top: 6px;
      font-size: 11px;
      line-height: 15px;
    }

    #shopify-section-{{ section.id }} .lt-pcta__arrow {
      width: 20px;
      height: 20px;
    }
  }
</style>

<div class="lt-pcta">
  <div class="page-width lt-pcta__inner">
    <div class="lt-pcta__grid">
      <div class="lt-pcta__card">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lt-pcta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lt-pcta__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="lt-pcta__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <a class="lt-pcta__button" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_text | escape }}</a>
        {%- endif -%}
      </div>

      <div class="lt-pcta__visual">
        <div class="lt-pcta__image">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1206 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1206 }} 1206w"
              sizes="(max-width: 767px) 100vw, 603px"
              alt="{{ section.settings.image.alt | default: section.settings.image_alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if has_overlay -%}
          {%- capture overlay_inner -%}
            <span class="lt-pcta__thumb">
              {%- if section.settings.overlay_image != blank -%}
                <img
                  src="{{ section.settings.overlay_image | image_url: width: 240 }}"
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="lt-pcta__info">
              {%- if section.settings.overlay_title != blank -%}
                <span class="lt-pcta__ptitle">{{ section.settings.overlay_title | escape }}</span>
              {%- endif -%}
              {%- if section.settings.overlay_text != blank -%}
                <span class="lt-pcta__ptext">{{ section.settings.overlay_text | escape }}</span>
              {%- endif -%}
            </span>
            {%- if section.settings.overlay_link != blank -%}
              <svg class="lt-pcta__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
            {%- endif -%}
          {%- endcapture -%}

          {%- if section.settings.overlay_link != blank -%}
            <a class="lt-pcta__overlay" href="{{ section.settings.overlay_link }}">{{ overlay_inner }}</a>
          {%- else -%}
            <div class="lt-pcta__overlay">{{ overlay_inner }}</div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LT VSL Product CTA",
  "tag": "div",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Left card"
    },
    {
      "type": "color_background",
      "id": "card_background",
      "label": "Card background",
      "info": "Supports solid colors and gradients.",
      "default": "linear-gradient(180deg, #b5656a 0%, #cf8590 50%, #eca3b5 100%)"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "You Already Spend About One-Third Of Your Life Sleeping."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Encourage nasal breathing, reduce dry mouth, support quieter nighttime breathing, and build a better bedtime routine — all while giving your lips an added dose of overnight care.</p><p>Better Sleep Is The Reason. Better-Looking Lips Are The Bonus.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try Muzzle Beauty Tape Tonight"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#f25ca8"
    },
    {
      "type": "header",
      "content": "Right image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended: 1206 x 1250 px."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Pink tote bag with a pouch of Muzzle Beauty Tape on a bed"
    },
    {
      "type": "header",
      "content": "Overlay card"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Thumbnail image",
      "info": "Square or portrait product image with a transparent background works best."
    },
    {
      "type": "text",
      "id": "overlay_title",
      "label": "Title",
      "default": "Muzzle® Beauty Patch Mouth Tape"
    },
    {
      "type": "textarea",
      "id": "overlay_text",
      "label": "Description",
      "default": "Experience the gentle, effective solution for peaceful sleep with Muzzle Sleep Strips. Our doctor-recommended design helps you breathe through your nose."
    },
    {
      "type": "url",
      "id": "overlay_link",
      "label": "Link",
      "info": "Makes the whole card clickable and shows the arrow."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "LT VSL Product CTA",
      "settings": {
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}
