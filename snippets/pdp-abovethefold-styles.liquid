<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">
<style>
  .lt-pdp-main-widget * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .lt-pdp-main-widget {
    font-family: 'Manrope', sans-serif;
    color: #333;
    padding: 40px 0;
  }
  .lt-pdp-main-widget .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  .lt-pdp-main-widget .product-layout {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    position: relative;
  }

  /* Left Gallery Section */
  .lt-pdp-main-widget .gallery-section {
    flex: 1;
    max-width: 600px;
    position: sticky;
    top: 0;
  }
    @media only screen and (max-width: 480px) {
    .lt-pdp-main-widget .main-swiper {
    margin-top: 30px;
    }
  }
  .lt-pdp-main-widget .main-swiper {
    width: 100%;
    height: 600px;
    margin-bottom: 10px;
    border-radius: 12px;
    overflow: hidden;
  }
  .lt-pdp-main-widget .main-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }
  .lt-pdp-main-widget .main-swiper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lt-pdp-main-widget .thumbs-swiper {
    width: 100%;
    height: 80px;
  }
  .lt-pdp-main-widget h2 {
    font-size: 18px;
    letter-spacing: 0;
    margin-bottom: 10px;
  }
  .lt-pdp-main-widget hr {
    margin-bottom: 10px;
  }
  .lt-pdp-main-widget .thumbs-swiper .swiper-slide {
    width: 70px;
    height: 70px;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.3s;
  }
  .lt-pdp-main-widget .thumbs-swiper .swiper-slide-thumb-active {
    opacity: 1;
    border: 2px solid #27214D;
  }
  .lt-pdp-main-widget .thumbs-swiper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right Purchase Section */
  .lt-pdp-main-widget .purchase-section {
    flex: 1;
    max-width: 500px;
  }
  .lt-pdp-main-widget .product-details {
    display: flex;
    justify-content: space-between;
  }
  .lt-pdp-main-widget .text-contents {
    flex-grow: 1;
  }
  .lt-pdp-main-widget .recommendation-badge {
    font-size: 14px;
    line-height: 1;
    background-color: #5C4CCC;
    padding: 7px 15px;
    border-radius: 100px;
    display: inline-block;
    max-width: fit-content;
    color: #fff;
    margin-bottom: 10px;
    font-weight: 400;
  }
  .lt-pdp-main-widget .product-title {
    color: #27214D;
    font-family: Manrope;
    font-size: 30px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    letter-spacing: -0.6px;
    margin-bottom: 10px;
  }
  .lt-pdp-main-widget .product-review {
    display: flex;
    align-items: center;
    gap: 0px 7px;
    text-decoration: none;
    flex-wrap: wrap;
  }
  .lt-pdp-main-widget .product-sticker img {
    display: block;
    max-width: 75px;
  }
  .lt-pdp-main-widget .review-score {
    font-size: 14px;
    font-weight: 600;
    color: #27214d;
  }
  .lt-pdp-main-widget .product-description {
    color: #27214d;
    padding-top: 15px;
    margin-top: 15px;
    border-top: 2px solid #ddd;
    line-height: 1.5;
    margin-bottom: 10px;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0px;
  }
  .lt-pdp-main-widget .product-tags-wrap {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 30px;
  }
  .lt-pdp-main-widget .product-tag {
    border-radius: 5px;
    border: 1px solid #E9E6FF;
    background: #F6F5FF;
    padding: 6px 8px;
    color: #27214D;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.2px;
  }
  .lt-pdp-main-widget .section-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #27214d;
    text-align: center;
  }
  .lt-pdp-main-widget .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 16px;
    border: 1px solid #E3DAEF;
    border-radius: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .lt-pdp-main-widget .option.option-subscirption {
    display: block;
  }
  .lt-pdp-main-widget .option-info-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lt-pdp-main-widget .option:hover {
    border-color: #27214D;
  }
  .lt-pdp-main-widget .option.selected {
    border-color: #27214D;
    background-color: #F6F5FF;
  }
  .lt-pdp-main-widget .option-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-grow: 1;
  }
  .lt-pdp-main-widget .option-info {
    flex-grow: 1;
  }
  .lt-pdp-main-widget .radio-input {
    display: block;
    max-width: 20px;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid #ddd;
    position: relative;
    cursor: pointer;
  }
  .lt-pdp-main-widget .option.selected .radio-input {
    border-color: #27214D;
  }
  .lt-pdp-main-widget .option.selected .radio-input::after {
    content: '';
    width: 12px;
    height: 12px;
    background: #27214D;
    border-radius: 50%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .lt-pdp-main-widget .option-info h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
    letter-spacing: -0.3px;
    color: #27214D;
    display: flex;
    gap: 10px;
  }
  .lt-pdp-main-widget .option-info p {
    font-size: 12px;
    color: #888;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0px;
  }
  .lt-pdp-main-widget .badge {
    background: #27214D;
    color: white;
    padding: 3px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3px;
  }
  .lt-pdp-main-widget .price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .lt-pdp-main-widget .discounted-price {
    font-size: 20px;
    color: #27214D;
    font-weight: 700;
    letter-spacing: 0px;
  }
  .lt-pdp-main-widget .original-price {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    font-weight: 500;
  }
  .lt-pdp-main-widget .benefits {
    background: #fff;
    padding: 10px;
    border-radius: 5px;
    margin: 10px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lt-pdp-main-widget .benefit {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #27214D;
    font-weight: 600;
    letter-spacing: 0px;
  }
  .lt-pdp-main-widget .benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 10px;
  }
  .lt-pdp-main-widget .benefit-icon img {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .lt-pdp-main-widget .checkout-btn {
    font-family: inherit;
    width: 100%;
    background: #27214D;
    color: white;
    border: none;
    padding: 16px;
    border-radius: 200px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    margin: 10px 0;
    transition: background 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .lt-pdp-main-widget .checkout-btn img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }
  .lt-pdp-main-widget .checkout-btn:hover {
    background: #1d183d;
  }
  .lt-pdp-main-widget .guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 14px;
    color: #27214D;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .lt-pdp-main-widget .pdp-shipping-txt {
    font-size: 14px;
    letter-spacing: 0;
    text-align: center;
    margin-top: 5px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #27214D;
    margin-bottom: 10px;
  }
  .lt-pdp-main-widget .pdp-shipping-txt img {
    width: 25px;
  }
  .lt-pdp-main-widget .flag {
    width: 20px;
    height: 15px;
    margin-right: 8px;
  }

  /* Reviews Section */
  .lt-pdp-main-widget .reviews-section {
    margin: 30px 0 0;
  }
  .lt-pdp-main-widget .review-swiper {
    width: 100%;
    padding: 10px;
  }
  .lt-pdp-main-widget .review-slide {
    background: #f8f9fa;
    padding: 10px;
    display: flex;
    gap: 10px;
    border: 1px solid #eee;
    border-radius: 8px;
  }
  .lt-pdp-main-widget .review-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lt-pdp-main-widget .reviewer-avatar {
    width: 75px;
    height: 75px;
    object-fit: cover;
    border-radius: 5px;
  }
  .lt-pdp-main-widget .reviewer-info {
    display: flex;
    align-items: center;
    gap: 5px;
  }  
  .lt-pdp-main-widget .reviewer-info h4 {
    font-size: 14px;
    font-weight: 700;
    color: #27214D;
    letter-spacing: 0;
  }
  .lt-pdp-main-widget .stars {
    color: #ffc107;
    font-size: 14px;
  }
  .lt-pdp-main-widget .review-text {
    display: flex;
    flex-direction: column;
    color: #27214d;
    font-size: 14px;
    line-height: 1;
    flex-grow: 1;
    width: 100%;
  }
  .lt-pdp-main-widget .review-text p {
    font-size: 13px;
    color: #27214D;
    line-height: 1.3;
    letter-spacing: 0;
    font-weight: 500;
  }

  /* Accordion Section */
  .lt-pdp-main-widget .accordion-item {
    border-bottom: 1px solid #e9ecef;
  }
  .lt-pdp-main-widget .accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    transition: 0.3s;
    color: #27214d;
    letter-spacing: 0;
  }
  .lt-pdp-main-widget .accordion-icon {
    font-size: 20px;
    transition: transform 0.3s ease;
  }
  .lt-pdp-main-widget .accordion-item.active .accordion-icon {
    transform: rotate(45deg);
  }
  .lt-pdp-main-widget .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .lt-pdp-main-widget .accordion-item.active .accordion-content {
    max-height: 400px;
  }
  .lt-pdp-main-widget .accordion-body {
    font-weight: 400;
    font-size: 14px;
    padding-bottom: 20px;
    line-height: 1.6;
    letter-spacing: 0.2px;
  }

  /* Navigation buttons for main swiper */
  .lt-pdp-main-widget .main-swiper .swiper-button-next,
  .lt-pdp-main-widget .main-swiper .swiper-button-prev {
    width: 40px;
    height: 40px;
    background: #fff;
    color: #27214D;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: background 0.3s, color 0.3s;
    border: none;
  }
  .lt-pdp-main-widget .main-swiper .swiper-button-next::after,
  .lt-pdp-main-widget .main-swiper .swiper-button-prev::after {
    color: #27214D;
    font-size: 15px;
    font-weight: bold;
  }
  .lt-pdp-main-widget .main-swiper .swiper-button-next,
  .lt-pdp-main-widget .main-swiper .swiper-button-prev {
    bottom: 20px;
    top: auto;
    right: 20px;
    left: auto;
    position: absolute;
    z-index: 10;
  }
  .lt-pdp-main-widget .main-swiper .swiper-button-prev {
    right: 70px;
  }
  .lt-pdp-main-widget .reviews-section .swiper-button-prev,
  .lt-pdp-main-widget .reviews-section .swiper-button-next {
    display: flex;
    background: #fff;
    border: 1px solid #ddd;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    top: 57%;
    left: 0;
    z-index: 999;
  }
  .lt-pdp-main-widget .reviews-section .swiper-button-next {
    right: 0;
    left: unset;
  }
  .lt-pdp-main-widget .reviews-section .swiper-button-prev::after,
  .lt-pdp-main-widget .reviews-section .swiper-button-next::after {
    font-size: 12px;
    font-weight: 600;
    color: #000;
  }
  .lt-pdp-main-widget .reviews-section .swiper-button-next.swiper-button-disabled, 
  .lt-pdp-main-widget .reviews-section .swiper-button-prev.swiper-button-disabled {
    display: none;
  }

  #shopify-section-{{section.id}} .pdp-abovethefold-video {
    background: #f1f1f1;
  }
  #shopify-section-{{section.id}} .pdp-abovethefold-video video {
    display: block;
    max-width: 100%;
    object-fit: contain;
    max-height: 600px;
    margin: 0 auto;
  }
  .lt-pdp-main-widget .bf-promotion-above-atc-pdp {
    color: #27214d;
    font-weight: 600;
    letter-spacing: 0;
    text-align: center;
    margin-top: 20px;
  }
  .checkout-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .lt-pdp-main-widget .main-swiper img {
      object-fit: contain;
    }
    .lt-pdp-main-widget .product-layout {
      flex-direction: column;
      gap: 20px;
    }
    .lt-pdp-main-widget .gallery-section {
      max-width: 100%;
      position: static;
    }
    .lt-pdp-main-widget .container {
      padding: 10px;
    }
    .lt-pdp-main-widget .main-swiper {
      height: 300px;
    }
    .lt-pdp-main-widget .purchase-section {
      max-width: 100%;
    }
    #shopify-section-{{section.id}} .pdp-abovethefold-video video {
      max-height: 400px;
    }    
  }
</style>